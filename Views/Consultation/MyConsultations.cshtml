@model IEnumerable<BeautyShop.Models.Consultation>
@{
    ViewData["Title"] = "Quản lý lịch tư vấn của tôi";
    var currentStatus = ViewBag.CurrentStatus as string;

    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Chờ xác nhận" => "bg-warning text-dark",
            "Đã xác nhận" => "bg-info text-dark",
            "Đã phân công" => "bg-primary text-white",
            "Đang tư vấn" => "bg-primary text-white",
            "Đã hoàn thành" => "bg-success text-white",
            "Đã hủy" => "bg-secondary text-white",
            _ => "bg-light text-dark"
        };
    }
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white p-3 rounded-4 shadow-sm">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success fw-bold"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lịch tư vấn của tôi</li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-calendar2-heart text-success"></i> Lịch tư vấn của tôi
            </h2>
            <p class="text-muted mb-0">Theo dõi tiến trình các buổi tư vấn chuyên sâu cùng chuyên viên BeautyShop</p>
        </div>
        <a asp-action="Book" class="btn btn-success px-4 py-2 rounded-3 fw-bold shadow-sm" style="background: #006E4A; border-color: #006E4A;">
            <i class="bi bi-calendar-plus me-2"></i>Đặt lịch mới
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-circle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Tabs -->
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-body p-2">
            <ul class="nav nav-pills flex-nowrap overflow-auto gap-2" style="white-space: nowrap;">
                <li class="nav-item">
                    <a asp-action="MyConsultations" class="nav-link rounded-3 fw-bold @(string.IsNullOrEmpty(currentStatus) ? "active bg-success" : "text-muted")">
                        Tất cả lịch
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="MyConsultations" asp-route-status="Chờ xác nhận" class="nav-link rounded-3 fw-bold @(currentStatus == "Chờ xác nhận" ? "active bg-warning text-dark" : "text-muted")">
                        Chờ xác nhận
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="MyConsultations" asp-route-status="Đã phân công" class="nav-link rounded-3 fw-bold @(currentStatus == "Đã phân công" ? "active bg-primary" : "text-muted")">
                        Đã phân công
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="MyConsultations" asp-route-status="Đang tư vấn" class="nav-link rounded-3 fw-bold @(currentStatus == "Đang tư vấn" ? "active bg-primary" : "text-muted")">
                        Đang tư vấn
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="MyConsultations" asp-route-status="Đã hoàn thành" class="nav-link rounded-3 fw-bold @(currentStatus == "Đã hoàn thành" ? "active bg-success" : "text-muted")">
                        Đã hoàn thành
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="MyConsultations" asp-route-status="Đã hủy" class="nav-link rounded-3 fw-bold @(currentStatus == "Đã hủy" ? "active bg-secondary" : "text-muted")">
                        Đã hủy
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Consultations List -->
    @if (!Model.Any())
    {
        <div class="card border-0 rounded-4 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="display-1 text-muted mb-3"><i class="bi bi-calendar-x"></i></div>
                <h4 class="fw-bold text-dark">Chưa có lịch tư vấn nào</h4>
                <p class="text-muted mb-4">Bạn chưa có lịch hẹn tư vấn nào trong mục này. Hãy đặt lịch ngay để được tư vấn chuyên sâu miễn phí!</p>
                <a asp-action="Book" class="btn btn-success px-4 py-2 rounded-3 fw-bold" style="background: #006E4A; border-color: #006E4A;">
                    <i class="bi bi-calendar-plus me-1"></i>Đặt lịch tư vấn ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card border-0 rounded-4 shadow-sm overflow-hidden transition-card">
                        <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge @GetStatusBadgeClass(item.Status) px-3 py-2 rounded-pill fs-6 fw-bold">
                                    @item.Status
                                </span>
                                <span class="fw-bold text-dark fs-5">#CS-@item.Id.ToString("D4")</span>
                                <span class="badge bg-light text-secondary border px-2 py-1 rounded-2">
                                    @item.ConsultationType
                                </span>
                            </div>
                            <div class="text-muted small">
                                <i class="bi bi-clock-history me-1"></i>Tạo lúc: @item.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="card-body p-3 p-md-4">
                            <div class="row g-3">
                                <!-- Thời gian hẹn -->
                                <div class="col-md-4 border-end-md">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 bg-light text-success p-3 text-center" style="min-width: 65px;">
                                            <div class="fw-bold fs-4">@item.AppointmentDate.ToString("dd")</div>
                                            <div class="small text-uppercase fw-bold">Tháng @item.AppointmentDate.ToString("MM")</div>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-5">@item.AppointmentDate.ToString("dddd, dd/MM/yyyy")</div>
                                            <div class="text-success fw-bold">
                                                <i class="bi bi-clock me-1"></i>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Chuyên viên phụ trách -->
                                <div class="col-md-4 border-end-md">
                                    <div class="small text-muted mb-1 text-uppercase fw-bold">Chuyên viên phụ trách</div>
                                    @if (item.Employee != null)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                                @(item.Employee.FullName.Substring(0, 1))
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.Employee.FullName</div>
                                                <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@item.Employee.Email</div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted fst-italic">
                                            <i class="bi bi-hourglass-split me-1 text-warning"></i>Đang chờ BeautyShop phân công chuyên viên
                                        </div>
                                    }
                                </div>

                                <!-- Đánh giá hoặc hành động nhanh -->
                                <div class="col-md-4 d-flex flex-column justify-content-center align-items-md-end">
                                    @if (item.Review != null)
                                    {
                                        <div class="mb-2">
                                            <div class="text-warning small mb-1">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= item.Review.Rating)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star"></i>
                                                    }
                                                }
                                                <span class="text-dark fw-bold ms-1">(@item.Review.Rating/5)</span>
                                            </div>
                                            <div class="small text-muted text-truncate" style="max-width: 220px;">
                                                "@item.Review.Comment"
                                            </div>
                                        </div>
                                    }

                                    <div class="d-flex gap-2">
                                        <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">
                                            <i class="bi bi-eye me-1"></i>Xem chi tiết
                                        </a>

                                        @if (item.Status == "Chờ xác nhận" || item.Status == "Đã xác nhận" || item.Status == "Đã phân công")
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#cancelModal-@item.Id">
                                                <i class="bi bi-x-circle me-1"></i>Hủy lịch
                                            </button>
                                        }

                                        @if (item.Status == "Đã hoàn thành" && item.Review == null)
                                        {
                                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-warning btn-sm text-dark rounded-pill px-3 fw-bold">
                                                <i class="bi bi-star me-1"></i>Đánh giá ngay
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Ghi chú của khách hàng -->
                            @if (!string.IsNullOrEmpty(item.CustomerNote))
                            {
                                <div class="mt-3 p-2 px-3 rounded-3 bg-light border-start border-4 border-success">
                                    <small class="text-muted fw-bold d-block">Ghi chú của bạn:</small>
                                    <span class="text-dark small">@item.CustomerNote</span>
                                </div>
                            }

                            <!-- Kết quả tư vấn tóm tắt nếu có -->
                            @if (!string.IsNullOrEmpty(item.ConsultationResult))
                            {
                                <div class="mt-2 p-2 px-3 rounded-3 bg-light border-start border-4 border-info">
                                    <small class="text-muted fw-bold d-block text-primary"><i class="bi bi-check2-circle me-1"></i>Kết quả tư vấn:</small>
                                    <span class="text-dark small">@item.ConsultationResult</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal Xác nhận hủy lịch -->
                @if (item.Status == "Chờ xác nhận" || item.Status == "Đã xác nhận" || item.Status == "Đã phân công")
                {
                    <div class="modal fade" id="cancelModal-@item.Id" tabindex="-1" aria-labelledby="cancelModalLabel-@item.Id" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0">
                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-header border-bottom-0 pb-0">
                                        <h5 class="modal-title fw-bold text-danger" id="cancelModalLabel-@item.Id">
                                            <i class="bi bi-exclamation-octagon-fill me-2"></i>Hủy lịch hẹn tư vấn
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body py-4">
                                        <p class="mb-3">Bạn có chắc chắn muốn hủy lịch tư vấn <strong>#CS-@item.Id.ToString("D4")</strong> vào ngày <strong>@item.AppointmentDate.ToString("dd/MM/yyyy")</strong> lúc <strong>@item.StartTime.ToString(@"hh\:mm")</strong> không?</p>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold text-dark">Lý do hủy lịch (không bắt buộc):</label>
                                            <input type="text" name="reason" class="form-control rounded-3" placeholder="Ví dụ: Có việc bận đột xuất, muốn đổi sang ngày khác..." />
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top-0 pt-0">
                                        <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                                        <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">Xác nhận hủy lịch</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<style>
    .transition-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .transition-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08) !important;
    }
    @@media (min-width: 768px) {
        .border-end-md {
            border-right: 1px solid #f1f5f9;
        }
    }
</style>
