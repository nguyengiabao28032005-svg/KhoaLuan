@model IEnumerable<BeautyShop.Models.Product>

@{
    ViewData["Title"] = "Danh sach san pham";
}

@section Styles {
    <style>
        .sort-toolbar {
            background: #fff;
            border-radius: 12px;
            padding: 14px 20px;
            box-shadow: var(--shadow-sm);
            border: 1.5px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

            .sort-toolbar .result-count {
                font-size: 14px;
                color: var(--text-muted);
                font-weight: 600;
            }

                .sort-toolbar .result-count strong {
                    color: var(--text-dark);
                }

        .sort-btn {
            background: var(--bg-body);
            border: 1.5px solid var(--border-mid);
            color: var(--text-muted);
            border-radius: 8px;
            padding: 7px 16px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition-fast);
            font-family: 'Nunito', sans-serif;
        }

            .sort-btn:hover, .sort-btn.active {
                background: var(--green-100);
                border-color: var(--green-500);
                color: var(--green-700);
            }

        .filter-badge {
            background: var(--green-100);
            color: var(--green-700);
            border: 1px solid var(--green-300);
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin: 3px;
        }

            .filter-badge .remove-filter {
                cursor: pointer;
                color: var(--green-500);
            }

                .filter-badge .remove-filter:hover {
                    color: var(--danger-red);
                }

        .product-list-card {
            background: #fff;
            border-radius: 16px;
            border: 1.5px solid var(--border-light);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
            position: relative;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

            .product-list-card:hover {
                transform: translateY(-6px);
                box-shadow: var(--shadow-card-hover);
                border-color: var(--green-500);
            }

            .product-list-card .card-img-wrap {
                position: relative;
                overflow: hidden;
                background: var(--bg-body);
            }

                .product-list-card .card-img-wrap img {
                    width: 100%;
                    height: 200px;
                    object-fit: cover;
                    transition: transform 0.5s ease;
                }

            .product-list-card:hover .card-img-wrap img {
                transform: scale(1.06);
            }

            .product-list-card .card-body-custom {
                padding: 16px;
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }

            .product-list-card .brand-tag {
                font-size: 11px;
                font-weight: 800;
                color: var(--accent-orange);
                text-transform: uppercase;
                letter-spacing: 0.8px;
                margin-bottom: 6px;
            }

            .product-list-card .product-name-list {
                font-size: 0.9rem;
                font-weight: 600;
                color: var(--text-main);
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                height: 2.7rem;
                line-height: 1.4;
                margin-bottom: 10px;
            }

                .product-list-card .product-name-list:hover {
                    color: var(--green-700);
                }

            .product-list-card .price-display {
                font-size: 1.2rem;
                font-weight: 900;
                color: var(--danger-red);
                margin-bottom: 14px;
            }

            .product-list-card .btn-view {
                background: var(--gradient-green);
                color: white;
                border: none;
                border-radius: 10px;
                padding: 9px 18px;
                font-size: 13px;
                font-weight: 700;
                width: 100%;
                cursor: pointer;
                transition: var(--transition-fast);
                text-decoration: none;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                margin-top: auto;
            }

                .product-list-card .btn-view:hover {
                    background: linear-gradient(135deg, var(--green-900), var(--green-700));
                    color: white;
                }

        .sidebar-sticky {
            position: sticky;
            top: 140px;
        }

        .filter-collapse-btn {
            background: none;
            border: none;
            padding: 0;
            color: var(--text-dark);
            font-weight: 800;
            font-size: 0.92rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            cursor: pointer;
        }

            .filter-collapse-btn::before {
                content: '';
                display: inline-block;
                width: 4px;
                height: 18px;
                background: var(--gradient-green);
                border-radius: 3px;
            }

            .filter-collapse-btn .toggle-icon {
                margin-left: auto;
                transition: transform 0.3s ease;
            }

            .filter-collapse-btn[aria-expanded="false"] .toggle-icon {
                transform: rotate(-90deg);
            }
    </style>
}

<div class="py-2">

    @if (!string.IsNullOrEmpty(ViewBag.Keyword))
    {
        <div class="alert d-flex align-items-center gap-3 shadow-sm border-0 rounded-3 mb-4" style="background:var(--green-100);color:var(--green-900);">
            <i class="bi bi-search fs-5"></i>
            <div>
                Kết quả tìm kiếm: <strong class="fs-5">"@ViewBag.Keyword"</strong>
                <span class="text-muted small ms-2">— @Model.Count() sản phẩm được tìm thấy</span>
            </div>
            <a asp-action="Index" class="ms-auto btn btn-sm rounded-pill fw-700" style="background:var(--green-700);color:#fff;font-weight:700;">Xoa bo loc</a>
        </div>
    }

    <div class="row g-4">

        <!-- SIDEBAR FILTER -->
        <div class="col-lg-3 col-md-4">
            <div class="sidebar-sticky">

                <!-- Category Filter -->
                <div class="filter-block mb-3" style="background:#fff;border-radius:12px;padding:18px;box-shadow:var(--shadow-sm);border:1.5px solid var(--border-light);">
                    <button class="filter-collapse-btn mb-3" data-bs-toggle="collapse" data-bs-target="#cat-collapse" aria-expanded="true">
                        Danh mục
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </button>
                    <div class="collapse show" id="cat-collapse">
                        <ul class="filter-list">
                            <li>
                                <a asp-action="Index" class="@(ViewBag.CategoryId == null ? "active" : "")">
                                    Tất cả danh mục
                                </a>
                            </li>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <li>
                                        <a asp-action="Index" asp-route-categoryId="@category.Id"
                                           class="@(ViewBag.CategoryId?.ToString() == category.Id.ToString() ? "active" : "")">
                                            @category.Name
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>

                <!-- Price Filter -->
                <div class="filter-block mb-3" style="background:#fff;border-radius:12px;padding:18px;box-shadow:var(--shadow-sm);border:1.5px solid var(--border-light);">
                    <button class="filter-collapse-btn mb-3" data-bs-toggle="collapse" data-bs-target="#price-collapse" aria-expanded="true">
                        Khoảng giá
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </button>
                    <div class="collapse show" id="price-collapse">
                        <ul class="filter-list">
                            <li><a asp-action="Index" asp-route-maxPrice="200000">Dưới 200.000d</a></li>
                            <li><a asp-action="Index" asp-route-minPrice="200000" asp-route-maxPrice="500000">200K - 500K</a></li>
                            <li><a asp-action="Index" asp-route-minPrice="500000" asp-route-maxPrice="1000000">500K - 1.000.000</a></li>
                            <li><a asp-action="Index" asp-route-minPrice="1000000">Trên 1.000.000d</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Brand Filter -->
                <div class="filter-block mb-3" style="background:#fff;border-radius:12px;padding:18px;box-shadow:var(--shadow-sm);border:1.5px solid var(--border-light);">
                    <button class="filter-collapse-btn mb-3" data-bs-toggle="collapse" data-bs-target="#brand-collapse" aria-expanded="true">
                        Thương hiệu
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </button>
                    <div class="collapse show" id="brand-collapse">
                        <ul class="filter-list">
                            @if (ViewBag.Brands != null)
                            {
                                foreach (var brand in ViewBag.Brands)
                                {
                                    <li>
                                        <a asp-action="Index" asp-route-brandId="@brand.Id">@brand.Name</a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>

                <!-- Trust Box -->
                <div style="background:var(--green-100);border-radius:12px;padding:18px;border:1px solid var(--green-300);">
                    <div class="fw-800 mb-2" style="color:var(--green-700);font-size:14px;"><i class="bi bi-patch-check-fill me-2"></i>CAM KẾT BEAUTYSHOP</div>
                    <ul class="list-unstyled mb-0" style="font-size:13px;color:var(--green-900);font-weight:600;line-height:2;">
                        <li><i class="bi bi-check2-circle me-2 text-success"></i>Chính hãng 100%</li>
                        <li><i class="bi bi-check2-circle me-2 text-success"></i>Đổi trả 14 ngày</li>
                        <li><i class="bi bi-check2-circle me-2 text-success"></i>Miễn phí vận chuyển</li>
                    </ul>
                </div>

            </div>
        </div>

        <!-- PRODUCT GRID -->
        <div class="col-lg-9 col-md-8">

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-search" style="font-size:4rem;color:var(--text-light);"></i>
                    <h5 class="mt-3">Không tìm thấy sản phẩm phù hợp</h5>
                    <p>Thử tìm với từ khóa khác hoặc xóa bộ lọc để xem tất cả sản phẩm</p>
                    <a asp-action="Index" class="btn btn-hasaki rounded-pill px-5 mt-3" id="btn-clear-filter">Xem tất cả sản phẩm</a>
                </div>
            }
            else
            {
                <!-- Sort Toolbar -->
                <div class="sort-toolbar">
                    <div class="result-count">
                        Hiển Thị <strong>@Model.Count()</strong> Sản Phẩm
                    </div>

                    <div class="d-flex align-items-center gap-2" style="font-size: 13px;">
                        <span class="text-muted">Sắp xếp</span>

                        <a href="@Url.Action("Index", new { keyword = Context.Request.Query["keyword"], categoryId = Context.Request.Query["categoryId"], brandId = Context.Request.Query["brandId"], sortBy = "popular" })"
                           class="btn btn-sm @(Context.Request.Query["sortBy"] == "popular" || string.IsNullOrEmpty(Context.Request.Query["sortBy"]) ? "btn-success" : "btn-light") rounded-pill px-3">
                            Phổ biến
                        </a>

                        <a href="@Url.Action("Index", new { keyword = Context.Request.Query["keyword"], categoryId = Context.Request.Query["categoryId"], brandId = Context.Request.Query["brandId"], sortBy = "newest" })"
                           class="btn btn-sm @(Context.Request.Query["sortBy"] == "newest" ? "btn-success" : "btn-light") rounded-pill px-3">
                            Mới nhất
                        </a>

                        <a href="@Url.Action("Index", new { keyword = Context.Request.Query["keyword"], categoryId = Context.Request.Query["categoryId"], brandId = Context.Request.Query["brandId"], sortBy = "price_asc" })"
                           class="btn btn-sm @(Context.Request.Query["sortBy"] == "price_asc" ? "btn-success" : "btn-light") rounded-pill px-3">
                            Giá tăng
                        </a>

                        <a href="@Url.Action("Index", new { keyword = Context.Request.Query["keyword"], categoryId = Context.Request.Query["categoryId"], brandId = Context.Request.Query["brandId"], sortBy = "price_desc" })"
                           class="btn btn-sm @(Context.Request.Query["sortBy"] == "price_desc" ? "btn-success" : "btn-light") rounded-pill px-3">
                            Giá giảm
                        </a>
                    </div>
                </div>

                <!-- Product Grid -->
                <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4">
                    @foreach (var item in Model)
                    {
                        var variant = item.ProductVariants?.FirstOrDefault();
                        <div class="col reveal">
                            <div class="product-list-card">
                                <!-- Nút yêu thích chuẩn AJAX (.wishlist-card-btn) -->
                                <a asp-controller="Wishlist" asp-action="Add" asp-route-productId="@item.Id"
                                   class="position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center bg-white shadow-sm rounded-circle text-danger wishlist-card-btn"
                                   style="width: 36px; height: 36px; z-index:2; text-decoration: none; border: 1px solid #edf2f7;"
                                   data-product-id="@item.Id" title="Thêm vào yêu thích">
                                    <i class="bi bi-heart" style="font-size: 1rem;"></i>
                                </a>

                                <div class="card-img-wrap">
                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" class="d-block">
                                        <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "/images/no-image.png" : item.ThumbnailUrl)" alt="@item.Name" loading="lazy" />
                                    </a>
                                </div>
                                <div class="card-body-custom">
                                    <div class="brand-tag">@(item.Brand?.Name ?? "No Brand")</div>
                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" class="text-decoration-none">
                                        <div class="product-name-list" title="@item.Name">@item.Name</div>
                                    </a>
                                    @if (variant != null && variant.HasPrice)
                                    {
                                        <div class="price-display">@variant.RetailPrice!.Value.ToString("N0")đ</div>
                                    }
                                    else
                                    {
                                        <div class="price-display" style="color:var(--text-muted);font-size:0.95rem;">Chưa thiết lập giá</div>
                                    }
                                    <div class="d-flex align-items-center gap-2 mb-12" style="margin-bottom:12px;">
                                        <span style="background:var(--green-700);color:#fff;padding:2px 7px;border-radius:5px;font-size:0.72rem;font-weight:700;">4.8 <i class="bi bi-star-fill" style="font-size:0.6rem;"></i></span>
                                        <span style="font-size:0.75rem;color:var(--text-muted);font-weight:600;">(128 đánh giá)</span>
                                    </div>
                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" class="btn-view">
                                        <i class="bi bi-eye"></i> Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const wishlistButtons = document.querySelectorAll(".wishlist-card-btn");

            wishlistButtons.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault(); // Ngăn chặn load lại trang
                    const icon = this.querySelector("i");
                    const href = this.getAttribute("href");

                    // Đổi trạng thái icon trái tim
                    if (icon.classList.contains("bi-heart")) {
                        icon.classList.replace("bi-heart", "bi-heart-fill");
                        this.style.background = "#e53935";
                        this.style.color = "#fff";
                        if (window.showToast) window.showToast("Đã thêm vào danh sách yêu thích!", "success");
                    } else {
                        icon.classList.replace("bi-heart-fill", "bi-heart");
                        this.style.background = "#fff";
                        this.style.color = "#e53935";
                        if (window.showToast) window.showToast("Đã xóa khỏi danh sách yêu thích!", "warning");
                    }

                    // Gửi request ngầm lên server
                    if (href && href !== "#") {
                        fetch(href, { method: 'GET' }).catch(err => console.error(err));
                    }
                });
            });
        });
    </script>
}