        <i class="bi bi-arrow-up"></i>
    </button>

    <script>
        window.addEventListener("scroll", function() {
            const btn = document.getElementById("back-to-top");
            if (btn) btn.style.display = window.scrollY > 300 ? "flex" : "none";
        });
    </script>

