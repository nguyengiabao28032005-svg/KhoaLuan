@using BeautyShop.Helpers
@using BeautyShop.ViewModels

@{
    var cart = Context.Session.GetObject<List<CartItemViewModel>>("CART") ?? new List<CartItemViewModel>();

    var cartCount = cart.Sum(x => x.Quantity);

    var fullName = Context.Session.GetString("FullName");

    var role = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BeautyShop</title>
    <meta name="description" content="BeautyShop - Hệ thống phân phối mỹ phẩm chính hãng chất lượng cao, giá tốt nhất Việt Nam." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/3d/shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/3d/customer.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<!-- ===== AI CHAT WIDGET ===== -->
<div id="ai-chat-widget">

    <!-- Nút mở chat -->
    <button id="chat-toggle-btn" onclick="toggleChat()" title="Chat với AI tư vấn">
        <i class="bi bi-chat-dots-fill" id="chat-icon-open"></i>
        <i class="bi bi-x-lg" id="chat-icon-close" style="display:none;"></i>
        <span class="chat-badge" id="chat-badge">AI</span>
    </button>

    <!-- Cửa sổ chat -->
    <div id="chat-window" style="display:none;">
        <!-- Header -->
        <div id="chat-header">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;">
                    🤖
                </div>
                <div>
                    <div style="font-weight:800;font-size:14px;">BeautyShop AI</div>
                    <div style="font-size:11px;opacity:0.85;">● Trực tuyến · Tư vấn mỹ phẩm</div>
                </div>
            </div>
            <button onclick="toggleChat()" style="background:rgba(255,255,255,0.15);border:none;color:#fff;width:30px;height:30px;border-radius:50%;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;">
                <i class="bi bi-x"></i>
            </button>
        </div>

        <!-- Messages -->
        <div id="chat-messages">
            <div class="msg-bot">
                <div class="msg-avatar">🤖</div>
                <div class="msg-bubble">
                    Xin chào! Tôi là trợ lý AI của <strong>BeautyShop</strong> 💄<br>
                    Tôi có thể giúp bạn tư vấn sản phẩm, hướng dẫn chăm sóc da, hoặc giải đáp thắc mắc về đơn hàng.<br><br>
                    Bạn cần tư vấn gì hôm nay? 😊
                </div>
            </div>
        </div>

        <!-- Quick suggestions -->
        <div id="chat-suggestions">
            <button class="suggestion-chip" onclick="sendSuggestion(this)">Da dầu dùng gì?</button>
            <button class="suggestion-chip" onclick="sendSuggestion(this)">Serum vitamin C tốt nhất</button>
            <button class="suggestion-chip" onclick="sendSuggestion(this)">Cách chăm sóc da ban đêm</button>
        </div>

        <!-- Input -->
        <div id="chat-input-area">
            <input type="text" id="chat-input" placeholder="Nhập câu hỏi..." autocomplete="off"
                   onkeydown="if(event.key==='Enter') sendMessage()" />
            <button id="chat-send-btn" onclick="sendMessage()">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
</div>

<style>
    #ai-chat-widget { position: fixed; bottom: 88px; right: 28px; z-index: 10000; font-family: 'Nunito', sans-serif; }

    #chat-toggle-btn {
        width: 58px; height: 58px; border-radius: 50%;
        background: linear-gradient(135deg, #006E4A, #009665);
        border: none; color: #fff; font-size: 1.4rem;
        cursor: pointer; box-shadow: 0 6px 20px rgba(0,110,74,0.45);
        display: flex; align-items: center; justify-content: center;
        position: relative; transition: all 0.3s;
    }
    #chat-toggle-btn:hover { transform: scale(1.08); box-shadow: 0 8px 28px rgba(0,110,74,0.55); }

    .chat-badge {
        position: absolute; top: -4px; right: -4px;
        background: #e53935; color: #fff; font-size: 9px;
        font-weight: 900; padding: 2px 5px; border-radius: 10px;
        border: 2px solid #fff;
    }

    #chat-window {
        position: absolute; bottom: 70px; right: 0;
        width: 360px; height: 520px;
        background: #fff; border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.18);
        display: flex; flex-direction: column; overflow: hidden;
        animation: chatSlideIn 0.3s ease;
    }

    @@keyframes chatSlideIn {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to   { opacity: 1; transform: translateY(0)    scale(1); }
    }

    #chat-header {
        background: linear-gradient(135deg, #006E4A, #009665);
        color: #fff; padding: 14px 16px;
        display: flex; align-items: center; justify-content: space-between;
        flex-shrink: 0;
    }

    #chat-messages {
        flex: 1; overflow-y: auto; padding: 16px 14px;
        display: flex; flex-direction: column; gap: 12px;
        background: #f8fafc;
        scrollbar-width: thin; scrollbar-color: #e2e8f0 transparent;
    }

    .msg-bot, .msg-user {
        display: flex; align-items: flex-end; gap: 8px;
    }
    .msg-user { flex-direction: row-reverse; }

    .msg-avatar {
        width: 30px; height: 30px; border-radius: 50%;
        background: #e6f5ef; display: flex;
        align-items: center; justify-content: center;
        font-size: 16px; flex-shrink: 0;
    }

    .msg-bubble {
        max-width: 78%; padding: 10px 14px;
        border-radius: 16px; font-size: 13.5px;
        line-height: 1.55; font-weight: 500;
    }
    .msg-bot .msg-bubble {
        background: #fff; color: #2d3748;
        border: 1.5px solid #edf2f7;
        border-bottom-left-radius: 4px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }
    .msg-user .msg-bubble {
        background: linear-gradient(135deg, #006E4A, #009665);
        color: #fff; border-bottom-right-radius: 4px;
    }

    .msg-typing .msg-bubble {
        background: #fff; border: 1.5px solid #edf2f7;
        display: flex; gap: 4px; align-items: center; padding: 12px 16px;
    }
    .typing-dot {
        width: 7px; height: 7px; background: #4db88a;
        border-radius: 50%; animation: typingBounce 1s infinite;
    }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes typingBounce {
        0%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-6px); }
    }

    #chat-suggestions {
        padding: 8px 12px; display: flex; gap: 6px;
        flex-wrap: wrap; border-top: 1px solid #edf2f7;
        background: #fff; flex-shrink: 0;
    }
    .suggestion-chip {
        background: #e6f5ef; border: 1.5px solid #4db88a;
        color: #006E4A; font-size: 12px; font-weight: 700;
        padding: 4px 11px; border-radius: 20px; cursor: pointer;
        transition: all 0.2s; white-space: nowrap;
    }
    .suggestion-chip:hover { background: #006E4A; color: #fff; }

    #chat-input-area {
        padding: 12px 14px; display: flex; gap: 8px;
        border-top: 1px solid #edf2f7; background: #fff; flex-shrink: 0;
    }
    #chat-input {
        flex: 1; border: 1.5px solid #e2e8f0; border-radius: 12px;
        padding: 9px 14px; font-size: 13.5px; outline: none;
        font-family: 'Nunito', sans-serif; font-weight: 600;
        transition: border 0.2s;
    }
    #chat-input:focus { border-color: #009665; }
    #chat-send-btn {
        width: 40px; height: 40px; border-radius: 12px;
        background: linear-gradient(135deg, #006E4A, #009665);
        border: none; color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; transition: all 0.2s; flex-shrink: 0;
    }
    #chat-send-btn:hover { transform: scale(1.08); }
    #chat-send-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    @@media (max-width: 480px) {
        #chat-window { width: calc(100vw - 20px); right: -14px; }
    }
</style>

<script>
    let chatOpen = false;

    function toggleChat() {
        chatOpen = !chatOpen;
        document.getElementById('chat-window').style.display = chatOpen ? 'flex' : 'none';
        document.getElementById('chat-icon-open').style.display  = chatOpen ? 'none'  : 'block';
        document.getElementById('chat-icon-close').style.display = chatOpen ? 'block' : 'none';
        document.getElementById('chat-badge').style.display      = chatOpen ? 'none'  : 'block';
        if (chatOpen) document.getElementById('chat-input').focus();
    }

    function sendSuggestion(btn) {
        document.getElementById('chat-input').value = btn.textContent;
        document.getElementById('chat-suggestions').style.display = 'none';
        sendMessage();
    }

    async function sendMessage() {
        const input = document.getElementById('chat-input');
        const msg = input.value.trim();
        if (!msg) return;

        // Hiển thị tin nhắn của user
        appendMessage('user', msg);
        input.value = '';

        // Hiển thị typing indicator
        const typingId = appendTyping();

        // Disable nút gửi
        const sendBtn = document.getElementById('chat-send-btn');
        sendBtn.disabled = true;

        try {
            const res = await fetch('/Chat/Ask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg })
            });
            const data = await res.json();

            // Xóa typing, hiện câu trả lời
            removeTyping(typingId);
            appendMessage('bot', data.reply);
        } catch {
            removeTyping(typingId);
            appendMessage('bot', 'Xin lỗi, đã có lỗi kết nối. Vui lòng thử lại.');
        } finally {
            sendBtn.disabled = false;
            input.focus();
        }
    }

    function appendMessage(role, text) {
        const container = document.getElementById('chat-messages');
        const div = document.createElement('div');
        div.className = role === 'bot' ? 'msg-bot' : 'msg-user';

        const formattedText = text
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/\n/g, '<br>');

        div.innerHTML = role === 'bot'
            ? `<div class="msg-avatar">🤖</div><div class="msg-bubble">${formattedText}</div>`
            : `<div class="msg-bubble">${formattedText}</div>`;

        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
    }

    function appendTyping() {
        const container = document.getElementById('chat-messages');
        const id = 'typing-' + Date.now();
        const div = document.createElement('div');
        div.className = 'msg-bot msg-typing';
        div.id = id;
        div.innerHTML = `<div class="msg-avatar">🤖</div>
            <div class="msg-bubble">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>`;
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
        return id;
    }

    function removeTyping(id) {
        const el = document.getElementById(id);
        if (el) el.remove();
    }
</script>
<!-- ===== KẾT THÚC AI CHAT WIDGET ===== -->

<body>

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="container">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-telephone-fill me-1" style="color:#ffd200"></i> Hotline: <strong>1800 6324</strong> (Miễn phí)</span>
            </div>
            <div class="d-none d-md-flex align-items-center gap-3">
                <span><i class="bi bi-truck me-1" style="color:#ffd200"></i> Miễn phí vận chuyển đơn từ 299K</span>
                <span>|</span>
                <span><i class="bi bi-shield-check me-1" style="color:#ffd200"></i> Chính hãng 100%</span>
            </div>
        </div>
    </div>

    <!-- MAIN HEADER -->
    <header class="main-header">
        <div class="container">
            <div class="row align-items-center g-2">

                <!-- Logo -->
                <div class="col-6 col-md-2 col-lg-2">
                    <a asp-controller="Home" asp-action="Index" class="logo">
