                                    <div class="text-muted" style="font-size:12px;">Thành viên BeautyShop</div>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item fw-bold" asp-controller="Account" asp-action="Profile" id="menu-profile" style="color:#006E4A;">
                                        <i class="bi bi-person-vcard me-2"></i>Thông tin tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Order" asp-action="Index" id="menu-orders">
