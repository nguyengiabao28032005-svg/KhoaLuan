                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Consultation" asp-action="MyConsultations" id="menu-consultations">
                                        <i class="bi bi-calendar2-heart me-2"></i>Lịch tư vấn của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Voucher" asp-action="Index" id="menu-vouchers">
                                        <i class="bi bi-ticket-perforated me-2"></i>Ví voucher của tôi
                                    </a>
