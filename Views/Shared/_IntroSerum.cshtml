@* ========================================================
   INTRO "GIỌT SERUM RƠI" PARTIAL COMPONENT
   Dành riêng cho trang chủ BeautyShop
   ======================================================== *@

<!-- Overlay Màn Đêm Sâu & Mặt Nước Tinh Chất -->
<div id="serum-intro-overlay" role="dialog" aria-modal="true" aria-label="Giới thiệu BeautyShop">
    <!-- Ánh sáng dịu nhẹ trên mặt nước tại điểm 50% ngang, 60% dọc -->
    <div class="serum-water-glow"></div>

    <!-- Giọt tinh chất vàng hổ phách rơi từ đỉnh màn hình -->
    <div class="serum-drop"></div>

    <!-- Vệt sáng bừng nở khi chạm nước (1.4s) -->
    <div class="serum-splash-flash"></div>

    <!-- 4 vòng sóng đồng tâm dạng elip dẹt (tỷ lệ 0.3) -->
    <div class="serum-ripple-container">
        <div class="serum-ripple"></div>
        <div class="serum-ripple"></div>
        <div class="serum-ripple"></div>
        <div class="serum-ripple"></div>
    </div>

    <!-- Tên thương hiệu hiện nhẹ phía trên điểm chạm nước (1.7s) -->
    <div class="serum-brand-wrap">
        <h2 class="serum-brand-title">BEAUTYSHOP</h2>
        <div class="serum-brand-sub">Tinh Hoa Dưỡng Da & Mỹ Phẩm Chính Hãng</div>
    </div>

    <!-- Nút "Bỏ qua" ở góc dưới phải -->
    <button type="button" class="intro-skip-btn" id="intro-skip-btn" aria-label="Bỏ qua phần giới thiệu">
        <span>Bỏ qua</span>
        <i class="bi bi-chevron-double-right"></i>
    </button>
</div>
