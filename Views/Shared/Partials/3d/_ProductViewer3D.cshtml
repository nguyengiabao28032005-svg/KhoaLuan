@* ========================================================
   PRODUCT 3D 360° VIEWER COMPONENT
   Trình xem sản phẩm xoay 360 độ tương tác cao cấp
   ======================================================== *@

<!-- Thanh chuyển đổi chế độ xem ảnh 2D / mô hình 3D -->
<div class="detail-3d-toggle-bar">
    <button type="button" class="btn-3d-mode-switch active" id="btn-view-2d" title="Xem ảnh chụp sản phẩm chuẩn">
        <i class="bi bi-image"></i> Ảnh chụp 2D
    </button>
    <button type="button" class="btn-3d-mode-switch" id="btn-view-3d" title="Xem mô hình 3D xoay 360 độ">
        <i class="bi bi-box"></i> Xoay 3D 360°
    </button>
</div>

<!-- Khung trình xem 3D (Mặc định ẩn, hiện ra khi bấm Xoay 3D) -->
<div id="detail-3d-panel" class="product-3d-viewer-box" style="display:none;" role="region" aria-label="Mô hình 3D sản phẩm tương tác xoay 360 độ">
    <!-- Gợi ý thao tác -->
    <div class="viewer-3d-hint">
        <i class="bi bi-arrows-move"></i> Kéo chuột / chạm vuốt để xoay 360°
    </div>

    <!-- Màn hình tải Three.js -->
    <div id="viewer-3d-loading" style="display:none;position:absolute;inset:0;background:rgba(255,255,255,0.9);z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:center;">
        <div class="spinner-border text-success mb-2" role="status"></div>
        <div class="fw-bold text-muted small">Đang nạp mô hình 3D thời gian thực...</div>
    </div>

    <!-- Canvas chứa không gian 3D -->
    <div id="product-3d-canvas-wrap"></div>

    <!-- Thanh nút điều khiển trực quan -->
    <div class="viewer-3d-controls">
        <button type="button" class="viewer-3d-ctrl-btn active" id="btn-ctrl-spin" title="Bật / Tắt tự động xoay">
            <i class="bi bi-arrow-repeat"></i>
        </button>
        <button type="button" class="viewer-3d-ctrl-btn" id="btn-ctrl-zoom-in" title="Phóng to">
            <i class="bi bi-zoom-in"></i>
        </button>
        <button type="button" class="viewer-3d-ctrl-btn" id="btn-ctrl-zoom-out" title="Thu nhỏ">
            <i class="bi bi-zoom-out"></i>
        </button>
        <button type="button" class="viewer-3d-ctrl-btn" id="btn-ctrl-reset" title="Đặt lại góc nhìn">
            <i class="bi bi-arrow-counterclockwise"></i>
        </button>
    </div>
</div>
