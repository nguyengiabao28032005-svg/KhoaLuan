@* ========================================================
   STAFF 3D WAREHOUSE PARCEL WIDGET
   Khối 3D minh họa kiện hàng cho Dashboard Nhân viên
   ======================================================== *@

<div class="staff-3d-parcel-widget" role="complementary" aria-label="Trung tâm xử lý đơn hàng và điều phối kho">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-warning text-dark fw-bold px-2 py-1 rounded-pill" style="font-size:11px;">
                <i class="bi bi-box-seam me-1"></i> LOGISTICS 3D
            </span>
            <span class="small opacity-75">Trung tâm điều phối & kho hàng</span>
        </div>
        <h4 class="mb-1 fw-bold text-white">Quản lý Xuất / Nhập Kho & Đơn Hàng</h4>
        <p class="mb-0 small text-white-50">Thao tác nhanh, chính xác với giao diện thẻ nổi có chiều sâu vật lý.</p>
    </div>

    <!-- Khối kiện hàng Isometric 3D -->
    <div class="staff-3d-parcel-cube" title="Kiện hàng 3D">
        <div class="cube-face cube-top"></div>
        <div class="cube-face cube-front"></div>
        <div class="cube-face cube-right"></div>
    </div>
</div>
