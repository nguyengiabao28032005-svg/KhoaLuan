</div>
</div>

@section Scripts {
    <script src="~/js/intro-serum.js" asp-append-version="true"></script>
    <script>
        // Newsletter
        document.getElementById('nl-btn').addEventListener('click', function() {
            var email = document.getElementById('nl-email').value.trim();
            var atIdx = email.indexOf(String.fromCharCode(64));
            if (email && atIdx > 0) {
                if (window.showToast) window.showToast('Đăng ký thành công! Kiểm tra email để nhận mã giảm giá.', 'success');
                document.getElementById('nl-email').value = '';
            } else {
                if (window.showToast) window.showToast('Vui lòng nhập email hợp lệ!', 'warning');
            }
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const wishlistButtons = document.querySelectorAll(".wishlist-card-btn");

            wishlistButtons.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault(); // Ngăn việc chuyển trang mặc định
                    const icon = this.querySelector("i");
                    const href = this.getAttribute("href");

                    // Toggle icon trái tim
                    if (icon.classList.contains("bi-heart")) {
                        icon.classList.replace("bi-heart", "bi-heart-fill");
                        this.style.background = "#e53935";
                        this.style.color = "#fff";
                        if (window.showToast) window.showToast("Đã thêm vào danh sách yêu thích!", "success");
                    } else {
                        icon.classList.replace("bi-heart-fill", "bi-heart");
                        this.style.background = "#fff";
                        this.style.color = "#e53935";
                        if (window.showToast) window.showToast("Đã xóa khỏi danh sách yêu thích!", "warning");
                    }

                    // Gửi request ngầm lên server để cập nhật Database
                    if (href && href !== "#") {
                        fetch(href, { method: 'GET' }).catch(err => console.error(err));
                    }
                });
            });
        });
    </script>
}
