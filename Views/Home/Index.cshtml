    <!-- ===== NEWSLETTER ===== -->
    <div class="newsletter-box mb-5">
        <div class="row align-items-center g-4" style="position:relative;z-index:1;">
            <div class="col-md-6">
                <h3 class="fw-900 mb-2" style="font-size:1.5rem;">Đăng ký nhận ưu đãi độc quyền</h3>
                <p class="mb-0" style="opacity:0.8;font-size:14px;">Nhận ngay voucher 50K cho đơn hàng đầu tiên!</p>
            </div>
            <div class="col-md-6">
                <div class="d-flex">
                    <input type="email" class="nl-input" placeholder="Nhập email của bạn..." id="nl-email" />
                    <button class="nl-btn" id="nl-btn"><i class="bi bi-send-fill me-2"></i>Đăng ký</button>
                </div>
                <div class="mt-2" style="font-size:12px;opacity:0.65;">
