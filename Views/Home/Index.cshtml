                                    @item.Name
                                </a>
                            </h5>

                            <div class="d-flex align-items-center justify-content-between mt-auto mb-2 pt-2 border-top border-light" style="font-size: 11.5px; color: #718096;">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge text-white fw-700 px-1.5 py-1 rounded d-inline-flex align-items-center gap-1" style="font-size: 10.5px; background-color: #e53935;">
                                        4.9 <i class="bi bi-star-fill" style="font-size: 8.5px;"></i>
                                    </span>
                                    <span class="fw-600 text-muted">(AI Chọn)</span>
                                </div>
                                <span class="fw-700 text-dark d-flex align-items-center gap-1">
                                    <i class="bi bi-bag text-muted"></i> Đã bán 2.1k
                                </span>
                            </div>

                            <div class="rounded-3 px-2.5 py-1.5 text-center fw-700" style="font-size: 10.5px; color: #991b1b; background-color: #fee2e2; border: 1px dashed #fca5a5;">
                                Đặc quyền riêng cho bạn...
                            </div>
                        </div>
                    </div>
                </div>
            }
