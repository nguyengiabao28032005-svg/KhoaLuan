                    <p class="text-muted mb-3" style="font-size:14px;">
                        Hệ thống cần thêm dữ liệu đơn hàng để gợi ý combo phù hợp. Hãy quay lại sau!
                    </p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Xem tất cả sản phẩm
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- ===== PROMO BANNERS ===== -->
    <div class="row g-3 mb-5">
        <div class="col-md-6">
            <a asp-controller="Product" asp-action="Index" class="d-block text-decoration-none" id="promo-authentic">
                <div class="promo-card" style="background-image:url('https://hasaki.vn/images/backgrounds/baner_giao_hang.jpg');">
                    <div class="promo-overlay">
                        <h5><i class="bi bi-shield-check me-2"></i>Chính hãng 100%</h5>
                        <p>Cam kết hoàn tiền nếu phát hiện hàng giả</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Product" asp-action="Index" class="d-block text-decoration-none" id="promo-deal">
                <div class="promo-card" style="background-image:url('https://hasaki.vn/images/backgrounds/baner_doi_tra.jpg');">
                    <div class="promo-overlay promo-overlay-red">
                        <h5><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Flash Sale Mỗi Ngày</h5>
                        <p>Hàng ngàn deal sốc, cập nhật mỗi ngày</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- ===== SẢN PHẨM MỚI VỀ ===== -->
    @if (Model?.NewProducts != null && Model.NewProducts.Any())
    {
        <h2 class="section-title-hasaki mb-4 fw-bold">Sản phẩm mới về</h2>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
            @foreach (var item in Model.NewProducts)
            {
                var variant = item.ProductVariants?.FirstOrDefault();
                decimal price = variant?.RetailPrice ?? 0;
                decimal origPrice = variant?.OriginalPrice ?? 0;
                int discountPercent = 0;

                if (origPrice > price && origPrice > 0)
                    discountPercent = (int)Math.Round(((origPrice - price) / origPrice) * 100);

                <div class="col">
                    <div class="card h-100 position-relative overflow-hidden shadow-sm product-card bg-white"
                         style="border-radius: 16px; border: 1.5px solid #e2e8f0; transition: all 0.25s ease;">

                        @if (discountPercent > 0)
                        {
                            <span class="position-absolute top-0 start-0 m-3 badge bg-danger text-white fw-800 rounded-pill px-2.5 py-1 shadow-sm" style="z-index:2; font-size: 11px;">
                                -@discountPercent%
                            </span>
                        }

                        <!-- Nút yêu thích chuẩn AJAX (.wishlist-card-btn) -->
