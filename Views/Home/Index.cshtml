@model BeautyShop.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Mỹ phẩm chính hãng, Giá tốt nhất";
}

@section Styles {
    <link rel="stylesheet" href="~/css/intro-serum.css" asp-append-version="true" />
    <style>
        /* ===== BANNER ===== */
        .banner-slide {
            height: 460px;
            background-size: cover;
            background-position: center;
            border-radius: 20px;
            position: relative;
            width: 100%;
        }

        .banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 55%, transparent 100%);
            border-radius: 20px;
            z-index: 1;
        }

        .banner-text {
            position: absolute;
            inset: 0;
            z-index: 2;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            padding: 48px 56px;
            color: #fff;
        }

            .banner-text h1 {
                font-size: 2.8rem;
                font-weight: 900;
                line-height: 1.2;
                margin-bottom: 12px;
                text-shadow: 0 2px 16px rgba(0,0,0,0.35);
            }

            .banner-text p {
                font-size: 1.1rem;
                font-weight: 600;
                margin-bottom: 24px;
                opacity: 0.95;
                text-shadow: 0 1px 6px rgba(0,0,0,0.3);
                max-width: 440px;
            }

        .carousel-indicators button {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.55);
            border: none;
            margin: 0 4px;
            transition: all 0.3s;
        }

            .carousel-indicators button.active {
                background: #fff;
                width: 28px;
                border-radius: 10px;
            }

        .carousel-control-prev, .carousel-control-next {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            top: 50%;
            transform: translateY(-50%);
            margin: 0 16px;
            border: 1.5px solid rgba(255,255,255,0.5);
            backdrop-filter: blur(4px);
            z-index: 10 !important;
        }

        /* ===== CATEGORY PILLS ===== */
        .cat-scroll {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 4px;
            scrollbar-width: none;
            justify-content: space-between;
        }

            .cat-scroll::-webkit-scrollbar {
                display: none;
            }

        .cat-pill {
            flex: 1;
            min-width: 80px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            background: #fff;
            border-radius: 16px;
            padding: 18px 12px;
            border: 1.5px solid #edf2f7;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            transition: all 0.25s;
            cursor: pointer;
            text-decoration: none;
            color: #2d3748;
            font-weight: 700;
            font-size: 13px;
            text-align: center;
        }

            .cat-pill:hover {
                border-color: #009665;
                background: #e6f5ef;
                color: #006E4A;
                transform: translateY(-5px);
                box-shadow: 0 6px 20px rgba(0,110,74,0.18);
            }

        .cat-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #e6f5ef;
            color: #006E4A;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            transition: all 0.25s;
        }

        .cat-pill:hover .cat-icon {
            background: linear-gradient(135deg, #006E4A, #009665);
            color: #fff;
            transform: rotate(-8deg) scale(1.1);
        }

        /* ===== COMBO THÔNG MINH ===== */
        .combo-header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 16px 16px 0 0;
            padding: 16px 26px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            color: #fff;
            font-size: 1.25rem;
            font-weight: 900;
        }

        .combo-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .live-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #4dff91;
            display: inline-block;
            animation: pulse-green 1.4s infinite;
        }

        .live-badge {
            background: rgba(0,0,0,0.2);
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .combo-body {
            background: #fff;
            border: 2px solid #764ba2;
            border-top: none;
            border-radius: 0 0 16px 16px;
            padding: 24px;
        }

        .combo-card {
            border: 2px solid #e9d5ff;
            border-radius: 16px;
            padding: 18px;
            background: linear-gradient(135deg, #faf5ff, #f3e8ff);
            position: relative;
            transition: box-shadow 0.25s, transform 0.25s;
            height: 100%;
        }

            .combo-card:hover {
                box-shadow: 0 8px 28px rgba(118,75,162,0.22);
                transform: translateY(-4px);
            }

        .combo-discount-badge {
            position: absolute;
            top: -12px;
            right: 16px;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: #fff;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 800;
        }

        .combo-products {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .combo-product-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            flex: 1;
            min-width: 70px;
        }

            .combo-product-item img {
                width: 70px;
                height: 70px;
                object-fit: cover;
                border-radius: 10px;
                border: 2px solid #e9d5ff;
                transition: transform 0.2s;
            }

        .combo-card:hover .combo-product-item img {
            transform: scale(1.05);
        }

        .combo-product-name {
            font-size: 10px;
            font-weight: 700;
            color: #4c1d95;
            text-align: center;
            line-height: 1.2;
        }

        .combo-plus {
            font-size: 1.3rem;
            color: #9333ea;
            font-weight: 900;
            flex-shrink: 0;
        }

        .combo-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }

        .combo-price-wrap .combo-label {
            font-size: 11px;
            color: #9333ea;
            font-weight: 700;
        }

        .combo-price {
            font-size: 1.2rem;
            font-weight: 900;
            color: #e53935;
        }

        .combo-orig-price {
            font-size: 11px;
            color: #9ca3af;
            text-decoration: line-through;
        }

        .combo-support {
            font-size: 11px;
            color: #6b7280;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .btn-combo {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 8px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: opacity 0.2s;
            border: none;
            cursor: pointer;
        }

            .btn-combo:hover {
                opacity: 0.88;
                color: #fff;
            }

        .combo-empty {
            text-align: center;
            padding: 40px 20px;
            color: #a0aec0;
        }

            .combo-empty i {
                font-size: 3rem;
                margin-bottom: 12px;
                display: block;
            }

        /* ===== PROMO BANNERS ===== */
        .promo-card {
            border-radius: 16px;
            overflow: hidden;
            height: 150px;
            position: relative;
            cursor: pointer;
            transition: all 0.3s;
            background-size: cover;
            background-position: center;
        }

            .promo-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 28px rgba(0,0,0,0.15);
            }

        .promo-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, rgba(0,110,74,0.88), rgba(0,150,101,0.55));
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 22px 26px;
            color: #fff;
        }

            .promo-overlay h5 {
                font-size: 1.1rem;
                font-weight: 900;
                margin: 0 0 5px;
            }

            .promo-overlay p {
                font-size: 12px;
                margin: 0;
                opacity: 0.88;
            }

        .promo-overlay-red {
            background: linear-gradient(120deg, rgba(229,57,53,0.88), rgba(255,75,43,0.55));
        }

        /* ===== NEWSLETTER ===== */
        .newsletter-box {
            background: linear-gradient(135deg, #006E4A, #009665);
            border-radius: 20px;
            padding: 36px 44px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }

            .newsletter-box::before {
                content: '';
                position: absolute;
                right: -50px;
                top: -50px;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: rgba(255,255,255,0.07);
            }

            .newsletter-box::after {
                content: '';
                position: absolute;
                right: 60px;
                bottom: -70px;
                width: 160px;
                height: 160px;
                border-radius: 50%;
                background: rgba(255,255,255,0.05);
            }

        .nl-input {
            border-radius: 50px 0 0 50px;
            border: none;
            padding: 12px 22px;
            font-size: 14px;
            font-weight: 600;
            outline: none;
            font-family: 'Nunito', sans-serif;
            flex: 1;
        }

        .nl-btn {
            border-radius: 0 50px 50px 0;
            background: #1a1a2e;
            color: #fff;
            border: none;
            padding: 12px 24px;
            font-weight: 800;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
        }

            .nl-btn:hover {
                background: #000;
            }

        @@media (max-width: 768px) {
            .banner-slide

        {
            height: 300px;
        }

        .banner-text {
            padding: 28px 24px;
        }

            .banner-text h1 {
                font-size: 1.8rem;
            }

        .newsletter-box {
            padding: 24px;
        }

        .combo-products {
            gap: 4px;
        }

        .combo-product-item img {
            width: 56px;
            height: 56px;
        }

        }</style>
}

<partial name="_IntroSerum" />

<div id="home-main-content">
<div class="py-3">

    <!-- ===== BANNER ===== -->
    <div class="mb-4">
        <div id="heroBanner" class="carousel slide rounded-4 overflow-hidden shadow-sm" data-bs-ride="carousel" data-bs-interval="5000">
            <div class="carousel-indicators" style="bottom:18px;">
                <button type="button" data-bs-target="#heroBanner" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#heroBanner" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#heroBanner" data-bs-slide-to="2"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="banner-slide" style="background-image:url('https://img3.thuthuatphanmem.vn/uploads/2019/09/16/banner-quang-cao-my-pham-xach-tay_083548910.jpg');">
                        <div class="banner-overlay"></div>
                        <div class="banner-text">
                            <span class="badge mb-3 px-3 py-2 fw-bold rounded-pill" style="background:linear-gradient(135deg,#f7971e,#ffd200);color:#1a1a2e;font-size:11px;">🔥 HOT DEAL MÙA LỄ HỘI</span>
                            <h1>MỸ PHẨM<br>CHÍNH HÃNG</h1>
                            <p>Sản phẩm chất lượng cao – Giảm giá lên đến 50%</p>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-warning fw-bold px-5 py-3 rounded-pill" style="font-size:15px;" id="banner-btn-1">
                                Mua ngay <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="banner-slide" style="background-image:url('https://viet-power.vn/wp-content/uploads/2022/08/TVC-quang-cao-my-pham-2.jpg');">
                        <div class="banner-overlay" style="background:linear-gradient(120deg,rgba(102,126,234,0.7) 0%,rgba(118,75,162,0.2) 60%,transparent 100%);"></div>
                        <div class="banner-text">
                            <span class="badge mb-3 px-3 py-2 fw-bold rounded-pill" style="background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;font-size:11px;">💎 CHĂM SÓC DA CHUYÊN SÂU</span>
                            <h1>BÍ QUYẾT<br>THANH XUÂN</h1>
                            <p>Công thức đặc biệt từ các chuyên gia hàng đầu</p>
                            <a asp-controller="Product" asp-action="Index" class="btn fw-bold px-5 py-3 rounded-pill" style="background:rgba(255,255,255,0.2);color:#fff;border:2px solid rgba(255,255,255,0.8);font-size:15px;backdrop-filter:blur(4px);" id="banner-btn-2">
                                Khám phá ngay <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="banner-slide" style="background-image:url('https://bizweb.dktcdn.net/100/513/110/articles/1.png?v=1721452508013');">
                        <div class="banner-overlay" style="background:linear-gradient(120deg,rgba(229,57,53,0.72) 0%,rgba(0,0,0,0.1) 60%,transparent 100%);"></div>
                        <div class="banner-text">
                            <span class="badge mb-3 px-3 py-2 fw-bold rounded-pill" style="background:linear-gradient(135deg,#ff416c,#ff4b2b);color:#fff;font-size:11px;">💄 TRENDING NOW</span>
                            <h1>SON MÔI<br>MÙA LỄ HỘI</h1>
                            <p>Sắc màu rạng rỡ – Tự tin quyến rũ mọi góc nhìn</p>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-danger fw-bold px-5 py-3 rounded-pill" style="font-size:15px;" id="banner-btn-3">
                                Săn deal ngay <i class="bi bi-lightning-charge-fill ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroBanner" data-bs-slide="prev">
                <i class="bi bi-chevron-left text-white" style="font-size:1rem;"></i>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroBanner" data-bs-slide="next">
                <i class="bi bi-chevron-right text-white" style="font-size:1rem;"></i>
            </button>
        </div>
    </div>

    <!-- ===== CATEGORY PILLS ===== -->
    <div class="mb-5">
        <div class="mb-5">
            <div class="mb-5">
                <div class="cat-scroll">
                    <!-- Sữa rửa mặt -> categoryId="3" -->
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="cat-pill" id="cat-3">
                        <div class="cat-icon" style="background:#e8f5e9;"><i class="bi bi-droplet-fill" style="color:#2e7d32;"></i></div>
                        <span>Sữa rửa mặt</span>
                    </a>

                    <!-- Chống nắng -> categoryId="2" -->
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="cat-pill" id="cat-2">
                        <div class="cat-icon" style="background:#fff3e0;"><i class="bi bi-brightness-high-fill" style="color:#f57c00;"></i></div>
                        <span>Chống nắng</span>
                    </a>

                    <!-- Son môi -> categoryId="1" -->
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="cat-pill" id="cat-1">
                        <div class="cat-icon" style="background:#ffebee;"><i class="bi bi-magic" style="color:#e53935;"></i></div>
                        <span>Son môi</span>
                    </a>

                    <!-- Toner -> categoryId="4" -->
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="cat-pill" id="cat-4">
                        <div class="cat-icon" style="background:#e3f2fd;"><i class="bi bi-flower1" style="color:#0288d1;"></i></div>
                        <span>Toner</span>
                    </a>

                    <!-- Serum -> categoryId="5" -->
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="5" class="cat-pill" id="cat-5">
                        <div class="cat-icon" style="background:#f3e5f5;"><i class="bi bi-eyedropper" style="color:#8e24aa;"></i></div>
                        <span>Serum</span>
                    </a>

                    <!-- Kem dưỡng -> categoryId="6" -->
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="6" class="cat-pill" id="cat-6">
                        <div class="cat-icon" style="background:#e0f7fa;"><i class="bi bi-snow2" style="color:#00acc1;"></i></div>
                        <span>Kem dưỡng</span>
                    </a>

                    <!-- Trang điểm -> categoryId="7" -->
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="7" class="cat-pill" id="cat-7">
                        <div class="cat-icon" style="background:#fce4ec;"><i class="bi bi-heart-fill" style="color:#e91e63;"></i></div>
                        <span>Trang điểm</span>
                    </a>

                    <!-- Tóc & Thân -> categoryId="8" -->
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="8" class="cat-pill" id="cat-8">
                        <div class="cat-icon" style="background:#fffde7;"><i class="bi bi-fan" style="color:#fbc02d;"></i></div>
                        <span>Tóc & Thân</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== SẢN PHẨM BÁN CHẠY ===== -->
    <div class="container my-5">
        <div class="d-flex align-items-center mb-4">
            <div style="width: 4px; height: 24px; background-color: #006E4A; border-radius: 2px;" class="me-2"></div>
            <h3 class="fw-900 text-dark mb-0" style="font-size: 1.4rem;"><strong>Sản phẩm bán chạy</strong></h3>
        </div>

        <div class="row g-4">
            @{
                var bestSellers = ViewBag.BestSellers as List<BeautyShop.Models.Product>;
            }
            @if (bestSellers != null && bestSellers.Any())
            {
                foreach (var item in bestSellers)
                {
                    var firstVariant = item.ProductVariants?.FirstOrDefault();
                    decimal price = firstVariant?.RetailPrice ?? 0;
                    decimal originalPrice = firstVariant?.OriginalPrice ?? 0;
                    int discount = (originalPrice > price && originalPrice > 0)
                    ? (int)Math.Round((double)(originalPrice - price) / (double)originalPrice * 100)
                    : 0;

                    <div class="col-6 col-md-3">
                        <div class="card h-100 position-relative overflow-hidden shadow-sm product-card bg-white"
                             style="border-radius: 16px; border: 1.5px solid #e2e8f0; transition: all 0.25s ease;">

                            @if (discount > 0)
                            {
                                <span class="position-absolute top-0 start-0 m-3 badge bg-danger text-white fw-800 rounded-pill px-2.5 py-1 shadow-sm" style="z-index:2; font-size: 11px;">
                                    -@discount%
                                </span>
                            }

                            <!-- Nút yêu thích -->
                            <a asp-controller="Wishlist" asp-action="Add" asp-route-productId="@item.Id"
                               class="position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center bg-white shadow-sm rounded-circle text-danger wishlist-card-btn"
                               style="width: 36px; height: 36px; z-index:2; text-decoration: none; border: 1px solid #edf2f7;"
                               data-product-id="@item.Id">
                                <i class="bi bi-heart" style="font-size: 1rem;"></i>
                            </a>

                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" class="text-decoration-none">
                                <div class="bg-light p-4 text-center position-relative" style="height: 220px; border-top-left-radius: 16px; border-top-right-radius: 16px;">
                                    <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "/images/no-image.png" : item.ThumbnailUrl)"
                                         alt="@item.Name" class="img-fluid h-100 object-fit-contain" />
                                </div>
                            </a>

                            <div class="card-body d-flex flex-column p-3 pt-3">
                                <div class="d-flex align-items-baseline gap-2 mb-1">
                                    <span class="text-danger fw-900" style="font-size: 1.2rem;">
                                        <strong>@price.ToString("N0")đ</strong>
                                    </span>
                                    @if (originalPrice > price)
                                    {
                                        <span class="text-muted text-decoration-line-through fw-600" style="font-size: 0.85rem;">
                                            <strong>@originalPrice.ToString("N0")đ</strong>
                                        </span>
                                    }
                                </div>

                                <span class="fw-800 mb-1" style="font-size: 11.5px; color: #006E4A; text-transform: uppercase; letter-spacing: 0.5px;">
                                    <strong>@(item.Brand?.Name ?? "BeautyShop")</strong>
                                </span>

                                <h5 class="card-title mb-3">
                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id"
                                       class="text-dark text-decoration-none fw-800" style="font-size: 13.5px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @item.Name
                                    </a>
                                </h5>

                                <div class="d-flex align-items-center justify-content-between mt-auto mb-2 pt-2 border-top border-light" style="font-size: 11.5px; color: #718096;">
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge text-white fw-700 px-1.5 py-1 rounded d-inline-flex align-items-center gap-1" style="font-size: 10.5px; background-color: #006E4A;">
                                            4.8 <i class="bi bi-star-fill" style="font-size: 8.5px;"></i>
                                        </span>
                                        <span class="fw-600 text-muted">(148)</span>
                                    </div>
                                    <span class="fw-700 text-dark d-flex align-items-center gap-1">
                                        <i class="bi bi-bag text-muted"></i> Đã bán 1.7k
                                    </span>
                                </div>

                                <div class="rounded-3 px-2.5 py-1.5 text-center fw-700" style="font-size: 10.5px; color: #c2410c; background-color: #fffaf0; border: 1px dashed #fed7aa;">
