    <!-- ===== THƯƠNG HIỆU NỔI BẬT ===== -->
    @if (Model?.Brands != null && Model.Brands.Any())
    {
        <h2 class="section-title-hasaki fw-bold">Thương hiệu nổi bật</h2>
        <div class="row g-3 mb-5">
            @foreach (var brand in Model.Brands.Take(8))
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="Product" asp-action="Index" asp-route-keyword="@brand.Name"
                       class="brand-card d-flex align-items-center justify-content-center text-decoration-none bg-white shadow-sm rounded-4 border p-3"
                       style="min-height:80px; transition: all 0.25s;">
                        <h5 class="fw-bold mb-0 text-dark">@brand.Name</h5>
                    </a>
                </div>
            }
