        </div>

        <div class="combo-body">
            @if (Model?.SmartCombos != null && Model.SmartCombos.Any())
            {
                <div class="row g-3">
                    @foreach (var combo in Model.SmartCombos)
                    {
                        <div class="col-12 col-md-6">
                            <div class="combo-card">
                                <div class="combo-discount-badge">-@combo.DiscountPercent% COMBO</div>
                                <div class="combo-products">
                                    @for (int i = 0; i < combo.Products.Count; i++)
                                    {
                                        var p = combo.Products[i];
                                        <div class="combo-product-item">
                                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id">
                                                <img src="@(string.IsNullOrEmpty(p.ThumbnailUrl) ? "/images/no-image.png" : p.ThumbnailUrl)"
                                                     alt="@p.Name" />
                                            </a>
                                            <span class="combo-product-name">
                                                @(p.Name.Length > 22 ? p.Name.Substring(0, 22) + "..." : p.Name)
                                            </span>
                                        </div>
                                        @if (i < combo.Products.Count - 1)
                                        {
                                            <div class="combo-plus">+</div>
                                        }
                                    }
                                </div>
                                <div class="combo-footer">
                                    <div class="combo-price-wrap">
                                        <div class="combo-label">
                                            <i class="bi bi-fire me-1"></i>Giá combo tiết kiệm
                                        </div>
                                        <div class="combo-price">@combo.ComboPrice.ToString("N0")đ</div>
                                        <div class="combo-orig-price">Gốc: @combo.OriginalTotal.ToString("N0")đ</div>
                                    </div>
                                    <div style="text-align:right;">
                                        <div class="combo-support">
                                            <i class="bi bi-people-fill me-1"></i>@combo.Support người đã mua cùng
                                        </div>
                                        <a asp-controller="Cart" asp-action="AddCombo"
                                           asp-route-productIds="@string.Join(",", combo.Products.Select(p => p.Id))"
                                           class="btn-combo">
                                            <i class="bi bi-bag-plus"></i>Thêm combo vào giỏ
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
