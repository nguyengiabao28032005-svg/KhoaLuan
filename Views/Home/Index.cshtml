                                <span class="text-danger fw-900" style="font-size: 1.2rem;">
                                    <strong>@(price > 0 ? price.ToString("N0") + "đ" : "Đang cập nhật")</strong>
                                </span>
                                @if (origPrice > price && origPrice > 0)
                                {
                                    <span class="text-muted text-decoration-line-through fw-600" style="font-size: 0.85rem;">
                                        <strong>@origPrice.ToString("N0")đ</strong>
                                    </span>
                                }
                            </div>

                            <span class="fw-800 mb-1" style="font-size: 11.5px; color: #006E4A; text-transform: uppercase; letter-spacing: 0.5px;">
                                <strong>@(item.Brand?.Name ?? "BeautyShop")</strong>
                            </span>

                            <h5 class="card-title mb-3">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id"
                                   class="text-dark text-decoration-none fw-800" style="font-size: 13.5px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.Name
                                </a>
                            </h5>

                            <div class="d-flex align-items-center justify-content-between mt-auto mb-2 pt-2 border-top border-light" style="font-size: 11.5px; color: #718096;">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge text-white fw-700 px-1.5 py-1 rounded d-inline-flex align-items-center gap-1" style="font-size: 10.5px; background-color: #006E4A;">
                                        4.8 <i class="bi bi-star-fill" style="font-size: 8.5px;"></i>
                                    </span>
                                    <span class="fw-600 text-muted">(148)</span>
                                </div>
                                <span class="fw-700 text-dark d-flex align-items-center gap-1">
                                    <i class="bi bi-bag text-muted"></i> Đã bán 1.7k
                                </span>
                            </div>

                            <div class="rounded-3 px-2.5 py-1.5 text-center fw-700" style="font-size: 10.5px; color: #c2410c; background-color: #fffaf0; border: 1px dashed #fed7aa;">
                                Bill <strong>@(item.Brand?.Name ?? "Mỹ phẩm")</strong> tặng quà hot...
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ===== GỢI Ý CÁ NHÂN HÓA ===== -->
    @if (Model?.RecommendedProducts != null && Model.RecommendedProducts.Any())
