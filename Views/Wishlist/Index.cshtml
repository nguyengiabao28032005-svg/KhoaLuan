@model BeautyShop.Models.Wishlist

@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="py-2">

    <!-- HEADER -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#ff6b9d,#ff416c);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.5rem;box-shadow:0 4px 14px rgba(255,65,108,0.35);">
            <i class="bi bi-heart-fill"></i>
        </div>
        <div>
            <h2 class="fw-900 mb-0" style="font-size:1.6rem;color:#1a1a2e;">Sản phẩm yêu thích</h2>
            @if (Model?.WishlistItems != null && Model.WishlistItems.Any())
            {
                <span class="text-muted fw-600" style="font-size:14px;">@Model.WishlistItems.Count sản phẩm trong danh sách</span>
            }
        </div>
    </div>

    @if (Model == null || Model.WishlistItems == null || !Model.WishlistItems.Any())
    {
        <div style="background:#fff;border-radius:20px;padding:80px 40px;text-align:center;border:1.5px solid #edf2f7;box-shadow:0 2px 16px rgba(0,0,0,0.05);">
            <div style="font-size:5rem;margin-bottom:20px;">
                <i class="bi bi-balloon-heart" style="color:#fda4af;"></i>
            </div>
            <h4 class="fw-800 mb-2" style="color:#2d3748;">Danh sách yêu thích đang trống</h4>
            <p class="text-muted mb-4" style="max-width:360px;margin:0 auto 24px;">Bạn chưa tìm thấy sản phẩm ưng ý? Hãy thử lướt qua các danh mục mỹ phẩm chính hãng của chúng tôi nhé!</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-hasaki rounded-pill px-5 py-3 fw-800" style="font-size:15px;" id="wishlist-go-shopping">
                <i class="bi bi-bag-heart me-2"></i>Khám phá ngay
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model.WishlistItems)
            {
                <div class="col">
                    <div class="product-item-card" style="position:relative;">

                        <!-- Remove button -->
                        <a asp-action="Remove" asp-route-id="@item.Id"
                           class="position-absolute"
                           style="top:10px;right:10px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,0.95);display:flex;align-items:center;justify-content:center;color:#a0aec0;box-shadow:0 2px 8px rgba(0,0,0,0.1);z-index:5;text-decoration:none;border:1.5px solid #edf2f7;transition:all 0.2s;"
                           title="Xóa khỏi danh sách"
                           onclick="return confirm('Xóa sản phẩm này khỏi danh sách yêu thích?');"
                           id="wishlist-remove-@item.Id">
                            <i class="bi bi-heart-fill" style="color:#ff6b9d;font-size:0.85rem;"></i>
                        </a>

                        <!-- Image -->
                        <div class="product-card-img-wrap">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId">
                                <img src="@(string.IsNullOrEmpty(item.Product?.ThumbnailUrl) ? "/images/no-image.png" : item.Product!.ThumbnailUrl)"
                                     class="product-card-img" alt="@item.Product?.Name" loading="lazy" />
                            </a>
                        </div>

                        <!-- Info -->
                        <div class="product-card-info">
                            <div class="product-card-brand">@(item.Product?.Brand?.Name ?? "BeautyShop")</div>
                            <h3 class="product-card-name">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId">
                                    @item.Product?.Name
                                </a>
                            </h3>
                            @{
                                var wlVariant = item.Product?.ProductVariants?.FirstOrDefault();
                            }
                            @if (wlVariant != null)
                            {
                                <div class="product-card-price-row">
                                    <span class="current-price">@(wlVariant.HasPrice ? $"{wlVariant.RetailPrice:N0}đ" : "Chưa thiết lập giá")</span>
                                </div>
                            }
                            <div class="mt-auto pt-2">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId"
                                   style="background:linear-gradient(135deg,#006E4A,#009665);color:#fff;border:none;border-radius:10px;padding:9px 16px;font-size:13px;font-weight:700;width:100%;display:flex;align-items:center;justify-content:center;gap:6px;text-decoration:none;transition:all 0.2s;">
                                    <i class="bi bi-bag-plus"></i> Xem & Mua ngay
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>