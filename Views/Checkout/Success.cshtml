@model BeautyShop.Models.Order

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

@section Styles {
    <style>
        /* Hiệu ứng nảy (pop-up) cho icon thành công */
        .success-icon {
            font-size: 5.5rem;
            color: var(--hasaki-green);
            line-height: 1;
            margin-bottom: 20px;
            display: inline-block;
            animation: scaleInBounce 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
        }

        @@keyframes scaleInBounce {
            0% { transform: scale(0); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        /* Khung hiển thị tóm tắt đơn hàng (Giống biên lai) */
        .order-summary-box {
            background: #f8f9fa;
            border: 2px dashed #dee2e6;
            border-radius: 12px;
            padding: 25px;
            margin: 25px 0;
            position: relative;
        }

        .btn-hasaki {
            background-color: var(--hasaki-green);
            color: #ffffff;
            transition: var(--transition);
        }

        .btn-hasaki:hover {
            background-color: var(--hasaki-green-light);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 110, 74, 0.2);
        }
    </style>
}

<div class="container py-5 min-vh-100 d-flex justify-content-center align-items-center">
    <div class="card border-0 shadow-lg rounded-4 text-center p-4 p-md-5" style="max-width: 600px; width: 100%;">
        
        <i class="bi bi-check-circle-fill success-icon"></i>
        
        <h2 class="fw-bold mb-3" style="color: var(--hasaki-green);">Đặt hàng thành công!</h2>
        <p class="text-secondary mb-4">
            Cảm ơn bạn đã mua sắm tại <strong>BeautyShop</strong>. Đơn hàng của bạn đã được hệ thống ghi nhận và đang trong quá trình xử lý.
        </p>

        <div class="order-summary-box shadow-sm">
            <div class="row text-start align-items-center">
                
                <div class="col-6 mb-3">
                    <span class="text-muted small d-block mb-1">Mã đơn hàng:</span>
                    <span class="fw-bold text-dark fs-5">@(Model?.OrderCode ?? "#BS-ERROR")</span>
                </div>
                
                <div class="col-6 mb-3 text-end">
                    <span class="text-muted small d-block mb-1">Tổng thanh toán:</span>
                    <span class="fw-bold text-danger fs-4">@(Model?.FinalAmount.ToString("N0") ?? "0") đ</span>
                </div>
                
                <div class="col-12 pt-3 border-top border-secondary-subtle">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Phương thức thanh toán:</span>
                        <span class="fw-medium text-dark">Thanh toán khi nhận hàng (COD)</span>
                    </div>
                </div>

            </div>
        </div>

        <p class="small text-muted mb-5">
            <i class="bi bi-envelope-check text-success me-1 fs-6"></i> 
            Một email xác nhận kèm chi tiết hóa đơn đã được gửi đến hòm thư của bạn. Vui lòng giữ điện thoại để shipper liên hệ nhé!
        </p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
            <a asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-medium rounded-pill border-2">
                <i class="bi bi-box-seam me-1"></i> Xem đơn hàng
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-hasaki px-4 py-2 fw-bold rounded-pill">
                Tiếp tục mua sắm <i class="bi bi-arrow-right-short fs-5 align-middle"></i>
            </a>
        </div>

    </div>
</div>