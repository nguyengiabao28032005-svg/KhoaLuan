@model BeautyShop.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

@section Styles {
    <style>
        .form-control:focus {
            border-color: var(--hasaki-green);
            box-shadow: 0 0 0 0.25rem rgba(0, 110, 74, 0.25);
        }

        .btn-hasaki {
            background-color: var(--hasaki-green);
            color: #ffffff;
            transition: all 0.3s;
        }

            .btn-hasaki:hover {
                background-color: var(--hasaki-green-light);
                color: #ffffff;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(0, 110, 74, 0.2);
            }
    </style>
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header bg-white text-center border-0 pt-4 pb-0">
                    <h3 class="fw-bold mb-1" style="color: var(--hasaki-green);">
                        <i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu
                    </h3>
                    <p class="text-muted small">Bảo mật tài khoản BeautyShop của bạn</p>
                </div>

                <div class="card-body p-4 pt-3">

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                            <div>Đổi mật khẩu thành công!</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center fw-medium"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold text-secondary small">Mật khẩu hiện tại</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white text-muted">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input asp-for="CurrentPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu hiện tại" />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold text-secondary small">Mật khẩu mới</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white text-muted">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="NewPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu mới" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small">Xác nhận mật khẩu mới</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white text-muted">
                                    <i class="bi bi-shield-check"></i>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Xác nhận lại mật khẩu mới" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <button type="submit" class="btn btn-hasaki w-100 py-2 fw-bold rounded-3">
                            Lưu thay đổi
                        </button>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>