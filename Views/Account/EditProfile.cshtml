@model BeautyShop.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Cập nhật thông tin";
}

@section Styles {
    <style>
        .edit-card {
            border: 1.5px solid #edf2f7;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #009665;
        }

        .input-group:focus-within {
            box-shadow: 0 0 0 3px rgba(0,150,101,0.1);
            border-radius: 8px;
        }

        .btn-hasaki {
            background: linear-gradient(135deg, #006E4A, #009665);
            color: #fff;
            transition: all 0.3s;
            border: none;
        }

            .btn-hasaki:hover {
                background: linear-gradient(135deg, #003d29, #006E4A);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(0,110,74,0.2);
                color: #fff;
            }
    </style>
}

<div class="container py-5 min-vh-100">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="card edit-card bg-white overflow-hidden">
                <div class="card-header bg-white text-center border-0 pt-4 pb-0">
                    <h3 class="fw-900 mb-1" style="color: #006E4A; font-size: 1.4rem;">
                        <i class="bi bi-person-lines-fill me-2"></i>Cập nhật thông tin
                    </h3>
                    <p class="text-muted small fw-600 mb-0">Chỉnh sửa thông tin cá nhân của bạn</p>
                </div>

                <div class="card-body p-4 pt-3">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-800 text-secondary small text-uppercase" style="letter-spacing:0.5px;">Họ và tên</label>
                            <div class="input-group" style="border:1.5px solid #e2e8f0; border-radius:8px; overflow:hidden;">
                                <span class="input-group-text bg-light text-muted border-0"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control border-0 ps-0" style="font-weight:700;color:#1a1a2e;font-family:'Nunito',sans-serif;" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small mt-1 fw-600 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-800 text-secondary small text-uppercase" style="letter-spacing:0.5px;">Email</label>
                            <div class="input-group" style="border:1.5px solid #e2e8f0; border-radius:8px; overflow:hidden; background:#f4f6f9;">
                                <span class="input-group-text border-0" style="background:transparent;color:#a0aec0;"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control border-0 ps-0" style="background:transparent;font-weight:700;color:#718096;font-family:'Nunito',sans-serif;" readonly title="Không thể đổi email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 fw-600 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label fw-800 text-secondary small text-uppercase" style="letter-spacing:0.5px;">Số điện thoại</label>
                            <div class="input-group" style="border:1.5px solid #e2e8f0; border-radius:8px; overflow:hidden;">
                                <span class="input-group-text bg-light text-muted border-0"><i class="bi bi-telephone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control border-0 ps-0" style="font-weight:700;color:#1a1a2e;font-family:'Nunito',sans-serif;" placeholder="Nhập số điện thoại..." />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 fw-600 d-block"></span>
                        </div>

                        <div class="d-flex flex-column gap-2 mt-4">
                            <button type="submit" class="btn btn-hasaki fw-800 py-3 rounded-3" style="font-size:15px;">
                                <i class="bi bi-save me-2"></i>Lưu thay đổi
                            </button>
                            <a asp-action="Profile" class="btn fw-800 py-3 rounded-3" style="background:#f4f6f9;color:#718096;font-size:15px;transition:all 0.2s;" onmouseover="this.style.background='#e2e8f0';this.style.color='#2d3748'" onmouseout="this.style.background='#f4f6f9';this.style.color='#718096'">
                                <i class="bi bi-x-circle me-1"></i>Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>