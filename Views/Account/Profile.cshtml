@model BeautyShop.Models.User

@{
    ViewData["Title"] = "Thông tin tài khoản";
}

@section Styles {
    <style>
        .profile-card {
            border: 1.5px solid #edf2f7;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

        .avatar-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #006E4A, #009665);
            color: #fff;
            font-size: 2.2rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            box-shadow: 0 4px 14px rgba(0,110,74,0.3);
        }

        .info-row {
            border-bottom: 1px solid #f0f4f8;
            padding: 16px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .btn-hasaki {
            background: linear-gradient(135deg, #006E4A, #009665);
            color: #fff;
            transition: all 0.3s;
            border: none;
        }

            .btn-hasaki:hover {
                background: linear-gradient(135deg, #003d29, #006E4A);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(0,110,74,0.2);
                color: #fff;
            }
    </style>
}

<div class="container py-5 min-vh-100">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">

            <!-- BREADCRUMB -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color:#718096;text-decoration:none;font-weight:600;font-size:13px;"><i class="bi bi-house me-1"></i>Trang chủ</a></li>
                    <li class="breadcrumb-item active fw-700" style="font-size:13px;" aria-current="page">Tài khoản</li>
                </ol>
            </nav>

            <div class="card profile-card bg-white overflow-hidden">
                <div class="card-header bg-white text-center border-0 pt-5 pb-0">
                    <div class="avatar-circle">
                        @(Model.FullName?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <h3 class="fw-900 mb-1" style="color: #1a1a2e; font-size: 1.5rem;">@Model.FullName</h3>
                    <p class="text-muted small fw-600 mb-0"><i class="bi bi-patch-check-fill text-success me-1"></i>Thành viên BeautyShop</p>
                </div>

                <div class="card-body p-4 pt-3">
                    <div class="mb-4">
                        <div class="info-row">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:36px;height:36px;border-radius:10px;background:#f0fdf4;color:#16a34a;display:flex;align-items:center;justify-content:center;font-size:1.1rem;"><i class="bi bi-envelope"></i></div>
                                <span class="fw-700 text-secondary" style="font-size:14px;">Email</span>
                            </div>
                            <span class="fw-800 text-dark">@Model.Email</span>
                        </div>
                        <div class="info-row">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:36px;height:36px;border-radius:10px;background:#f0fdf4;color:#16a34a;display:flex;align-items:center;justify-content:center;font-size:1.1rem;"><i class="bi bi-telephone"></i></div>
                                <span class="fw-700 text-secondary" style="font-size:14px;">Số điện thoại</span>
                            </div>
                            <span class="fw-800 text-dark">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</span>
                        </div>
                        <div class="info-row">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:36px;height:36px;border-radius:10px;background:#f0fdf4;color:#16a34a;display:flex;align-items:center;justify-content:center;font-size:1.1rem;"><i class="bi bi-calendar3"></i></div>
                                <span class="fw-700 text-secondary" style="font-size:14px;">Ngày tham gia</span>
                            </div>
                            <span class="fw-800 text-dark">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <a asp-action="EditProfile" class="btn btn-hasaki fw-800 py-3 rounded-3" style="font-size:15px;">
                            <i class="bi bi-pencil-square me-2"></i>Cập nhật thông tin
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-controller="Order" asp-action="Index" class="btn flex-fill fw-800" style="background:#f4f6f9;color:#2d3748;padding:12px;border-radius:12px;border:1.5px solid #edf2f7;transition:all 0.2s;" onmouseover="this.style.borderColor='#006E4A';this.style.color='#006E4A'" onmouseout="this.style.borderColor='#edf2f7';this.style.color='#2d3748'">
                                <i class="bi bi-box-seam me-2"></i>Đơn hàng
                            </a>
                            <a asp-action="ChangePassword" class="btn flex-fill fw-800" style="background:#f4f6f9;color:#2d3748;padding:12px;border-radius:12px;border:1.5px solid #edf2f7;transition:all 0.2s;" onmouseover="this.style.borderColor='#006E4A';this.style.color='#006E4A'" onmouseout="this.style.borderColor='#edf2f7';this.style.color='#2d3748'">
                                <i class="bi bi-shield-lock me-2"></i>Mật khẩu
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>