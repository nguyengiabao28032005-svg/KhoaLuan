@model BeautyShop.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center py-5" style="background:linear-gradient(135deg,#e6f5ef 0%,#f4f6f9 50%,#fef3c7 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">

                <!-- Logo -->
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <div style="font-size:2rem;font-weight:900;color:#006E4A;">
                            <i class="bi bi-bag-heart-fill me-2"></i>Beauty<span style="color:#f39c11;">Shop</span>
                        </div>
                    </a>
                    <p class="text-muted mt-1 fw-600" style="font-size:14px;">Khôi phục mật khẩu tài khoản</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert d-flex align-items-center gap-2 rounded-3 border-0 mb-4" style="background:#fde8e8;color:#9b1c1c;" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                <!-- Card -->
                <div style="background:#fff;border-radius:20px;box-shadow:0 8px 40px rgba(0,0,0,0.10);overflow:hidden;border:1.5px solid #edf2f7;">

                    <!-- Card Header -->
                    <div style="background:linear-gradient(135deg,#006E4A,#009665);padding:28px 32px;text-align:center;color:#fff;">
                        <div style="width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,0.2);margin:0 auto 12px;display:flex;align-items:center;justify-content:center;font-size:1.8rem;">
                            <i class="bi bi-key-fill"></i>
                        </div>
                        <h3 style="font-size:1.3rem;font-weight:900;margin:0;">Quên mật khẩu?</h3>
                        <p style="margin:6px 0 0;opacity:0.85;font-size:13px;">Nhập Email đã đăng ký để lấy lại mật khẩu</p>
                    </div>

                    <!-- Card Body -->
                    <div style="padding:32px;">
                        <form asp-action="ForgotPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-600"></div>

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label" style="font-size:13px;font-weight:700;color:#718096;">Email tài khoản</label>
                                <div class="input-group" style="border:2px solid #e2e8f0;border-radius:12px;overflow:hidden;">
                                    <span class="input-group-text" style="background:#f4f6f9;border:none;color:#a0aec0;padding:12px 16px;">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control" style="border:none;padding:12px 16px;font-size:15px;font-family:'Nunito',sans-serif;font-weight:600;" placeholder="your@email.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-600"></span>
                            </div>

                            <button type="submit" style="background:linear-gradient(135deg,#006E4A,#009665);color:#fff;border:none;border-radius:12px;padding:14px;font-size:1rem;font-weight:800;width:100%;cursor:pointer;transition:all 0.3s;letter-spacing:0.3px;" id="forgot-submit">
                                <i class="bi bi-arrow-right-circle me-2"></i>Tiếp tục
                            </button>
                        </form>
                    </div>

                    <!-- Card Footer -->
                    <div style="background:#f9fafb;padding:18px;text-align:center;border-top:1px solid #edf2f7;">
                        <a asp-controller="Account" asp-action="Login" style="color:#006E4A;font-weight:800;text-decoration:none;font-size:14px;">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
