    // =========================================================================
    // LƯU PHIẾU NHẬP NHIỀU SẢN PHẨM (SUBMIT VIA AJAX)
    // =========================================================================
    function submitMultiItemReceipt() {
        const rows = document.querySelectorAll('.item-row');
        const alertBox = document.getElementById('mValidationAlert');
        alertBox.classList.add('d-none');

        // KIỂM TRA YÊU CẦU 1: TỐI THIỂU 2 SẢN PHẨM
        if (rows.length < 2) {
            alertBox.innerHTML = '<i class="bi bi-exclamation-octagon-fill me-1"></i><strong>Quy định quản lý nhập hàng:</strong> Một phiếu nhập phải bao gồm từ 2 sản phẩm trở lên (không được phép lập phiếu chỉ có 1 sản phẩm). Vui lòng thêm các mặt hàng khác trong cùng chuyến nhập.';
            alertBox.classList.remove('d-none');
            return;
        }

        const supplierSelect = document.getElementById('mSupplierId');
        if (supplierSelect.selectedIndex <= 0) {
            alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>Vui lòng chọn Nhà cung cấp đối tác cung ứng hàng.';
            alertBox.classList.remove('d-none');
            return;
        }

        const storeId = parseInt(document.getElementById('mStoreId').value || '1');
        const receiptType = document.querySelector('input[name="modalReceiptType"]:checked').value;
        const importPortId = receiptType === 'Import' ? parseInt(document.getElementById('mImportPortId').value || '0') : null;
        const customsDeclarationNumber = document.getElementById('mCustomsDeclarationNumber').value;
        const supplierId = parseInt(supplierSelect.value);
        const supplierName = supplierSelect.options[supplierSelect.selectedIndex].getAttribute('data-name');
        const originCountry = document.getElementById('mOriginCountry').value;
        const invoiceNumber = document.getElementById('mInvoiceNumber').value;
        const importDate = document.getElementById('mImportDate').value;
        const paymentStatus = document.getElementById('mPaymentStatus').value;
        const paidAmount = parseFloat(document.getElementById('mPaidAmount').value || '0');
        const note = document.getElementById('mNote').value;

        // Thu thập các dòng sản phẩm
        const items = [];
        const variantIdsSet = new Set();

        for (let i = 0; i < rows.length; i++) {
            const r = rows[i];
            const vId = parseInt(r.querySelector('.row-variant').value || '0');
            const qty = parseInt(r.querySelector('.row-qty').value || '0');
            const price = parseFloat(r.querySelector('.row-price').value || '0');
            const newRetail = parseFloat(r.querySelector('.row-new-retail').value || '0');

            if (!vId) {
                alertBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i>Dòng thứ #${i+1} chưa chọn sản phẩm / biến thể.`;
                alertBox.classList.remove('d-none');
                return;
            }
            if (qty <= 0) {
                alertBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i>Dòng thứ #${i+1} có số lượng nhập không hợp lệ.`;
                alertBox.classList.remove('d-none');
                return;
            }
            if (price <= 0) {
                alertBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i>Dòng thứ #${i+1} có đơn giá nhập không hợp lệ.`;
                alertBox.classList.remove('d-none');
                return;
            }

            variantIdsSet.add(vId);
            items.push({
                variantId: vId,
                quantity: qty,
                importPrice: price,
                newRetailPrice: newRetail > 0 ? newRetail : null
            });
        }

        if (variantIdsSet.size < 2) {
            alertBox.innerHTML = '<i class="bi bi-exclamation-octagon-fill me-1"></i>Một lần nhập phải gồm từ 2 sản phẩm/biến thể khác nhau trở lên theo đúng thực tế nhập hàng theo nhãn hiệu.';
            alertBox.classList.remove('d-none');
            return;
        }

        const payload = {
            storeId: storeId,
            receiptType: receiptType,
            importPortId: importPortId,
            customsDeclarationNumber: customsDeclarationNumber,
            supplierId: supplierId,
            supplierName: supplierName,
            originCountry: originCountry,
            invoiceNumber: invoiceNumber,
            importDate: importDate,
            paymentStatus: paymentStatus,
            paidAmount: paidAmount,
            note: note,
            items: items
        };

        const submitBtn = document.getElementById('btnSubmitMultiReceipt');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu phiếu nhập...';

        fetch('/Admin/Inventory/CreateMultiReceipt', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                bootstrap.Modal.getInstance(document.getElementById('multiImportModal')).hide();
                window.location.reload();
            } else {
                alertBox.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i>${res.message || 'Lỗi khi lưu phiếu nhập.'}`;
                alertBox.classList.remove('d-none');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Lưu và nhập kho toàn bộ';
            }
        })
        .catch(err => {
            alertBox.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i>Lỗi kết nối máy chủ.';
            alertBox.classList.remove('d-none');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Lưu và nhập kho toàn bộ';
        });
    }

    // =========================================================================
    // XEM CHI TIẾT PHIẾU NHẬP
    // =========================================================================
    function viewReceiptDetail(receiptId) {
        fetch(`/Admin/Inventory/GetReceiptDetail?id=${receiptId}`)
            .then(res => res.json())
            .then(result => {
                if (!result.success) {
                    alert(result.message || 'Lỗi khi tải chi tiết phiếu nhập.');
                    return;
                }
                const d = result.data;
                document.getElementById('dt-receiptCode').innerText = d.receiptCode;
                document.getElementById('dt-receiptTypeLabel').innerHTML = d.receiptType === 'Import' 
                    ? '<span class="badge bg-warning-subtle text-warning fs-6 px-3 py-1"><i class="bi bi-globe-americas me-1"></i>Nhập khẩu quốc tế</span>'
                    : '<span class="badge bg-info-subtle text-info fs-6 px-3 py-1"><i class="bi bi-house-door me-1"></i>Nhập trong nước</span>';
                
                document.getElementById('dt-origin').innerText = `Xuất xứ: ${d.originCountry || 'Việt Nam'}`;
                document.getElementById('dt-portInfo').innerText = d.receiptType === 'Import' && d.portName ? `Thông quan: ${d.portName} (${d.portType})` : '';
                document.getElementById('dt-customs').innerText = d.customsDeclarationNumber && d.customsDeclarationNumber !== '—' ? `Tờ khai / Vận đơn: ${d.customsDeclarationNumber}` : '';
                
                document.getElementById('dt-supplier').innerText = d.supplier;
                document.getElementById('dt-supplierAddress').innerHTML = d.supplierAddress && d.supplierAddress !== '—' ? `<i class="bi bi-geo-alt me-1"></i>${d.supplierAddress}` : '';
                document.getElementById('dt-supplierPhone').innerText = d.supplierPhone && d.supplierPhone !== '—' ? `Hotline: ${d.supplierPhone}` : '';
                document.getElementById('dt-invoice').innerText = d.invoiceNumber && d.invoiceNumber !== '—' ? `Hóa đơn VAT: ${d.invoiceNumber}` : '';

                document.getElementById('dt-storeName').innerText = d.storeName;
                document.getElementById('dt-storeMeta').innerText = `${d.storeAddress} — ${d.storeProvince} (${d.storeRegion} / ${d.storeType})`;
                
                if (d.storeId === 1) {
                    document.getElementById('dt-transferLinkContainer').innerHTML = `
                        <a href="/Admin/Transfers/Create?sourceStoreId=1&targetStoreId=5" class="btn btn-sm btn-outline-warning w-100 fw-bold">
                            <i class="bi bi-truck me-1"></i> Chuyển sang kho Tây Nam Bộ (Cần Thơ)
                        </a>
                    `;
                } else {
                    document.getElementById('dt-transferLinkContainer').innerHTML = '';
                }

                // Render danh sách mặt hàng
                const tbody = document.getElementById('dt-itemsTableBody');
                tbody.innerHTML = '';
                if (d.items && d.items.length > 0) {
                    d.items.forEach(item => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="px-3 py-2">
                                <div class="fw-bold text-dark">${item.productName}</div>
                                <div class="small text-muted"><code>${item.sku}</code> ${item.colorName ? '| Màu: ' + item.colorName : ''} ${item.volume ? '| ' + item.volume : ''}</div>
                            </td>
                            <td class="py-2 text-center fw-bold text-success">+${item.quantity}</td>
                            <td class="py-2 text-end">${Number(item.importPrice).toLocaleString('vi-VN')} đ</td>
                            <td class="py-2 text-end fw-bold text-dark">${Number(item.totalPrice).toLocaleString('vi-VN')} đ</td>
                            <td class="py-2 text-end text-primary">${item.newRetailPrice ? Number(item.newRetailPrice).toLocaleString('vi-VN') + ' đ' : '—'}</td>
                            <td class="py-2 px-3 text-end fw-bold text-success">${item.currentRetailPrice ? Number(item.currentRetailPrice).toLocaleString('vi-VN') + ' đ' : '—'}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                }

                document.getElementById('dt-totalAmount').innerText = Number(d.totalAmount).toLocaleString('vi-VN') + ' đ';
                document.getElementById('dt-paidAmount').innerText = Number(d.paidAmount).toLocaleString('vi-VN') + ' đ';
                document.getElementById('dt-debtAmount').innerText = Number(d.debtAmount).toLocaleString('vi-VN') + ' đ';
                document.getElementById('dt-importDate').innerText = d.importDate;
                document.getElementById('dt-createdByName').innerText = d.createdByName;
                document.getElementById('dt-note').innerText = d.note;

                new bootstrap.Modal(document.getElementById('receiptDetailModal')).show();
            })
            .catch(err => {
                alert('Không thể kết nối đến máy chủ.');
            });
    }

    // =========================================================================
    // THANH TOÁN CÔNG NỢ
    // =========================================================================
    function openPaymentModal(receiptId, receiptCode, currentDebt, supplierName) {
        document.getElementById('payModalReceiptId').value = receiptId;
        document.getElementById('payModalReceiptCode').innerText = receiptCode;
        document.getElementById('payModalSupplier').innerText = supplierName || '—';
        document.getElementById('payModalCurrentDebt').innerText = Number(currentDebt).toLocaleString('vi-VN') + ' đ';
        document.getElementById('payModalAmount').value = currentDebt;
        document.getElementById('payModalAmount').max = currentDebt;

        new bootstrap.Modal(document.getElementById('paymentModal')).show();
    }
</script>
}
