@model IEnumerable<BeautyShop.Models.StockReceipt>
@{
    ViewData["Title"] = "Bảng nhập kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var variants = ViewBag.AllVariants as List<BeautyShop.Models.ProductVariant> ?? new();
    var categories = ViewBag.Categories as List<BeautyShop.Models.Category> ?? new();
    var suppliers = ViewBag.Suppliers as List<BeautyShop.Models.Supplier> ?? new();
    var stores = ViewBag.Stores as List<BeautyShop.Models.Store> ?? new();
    var importPorts = ViewBag.ImportPorts as List<BeautyShop.Models.ImportPort> ?? new();
    var activePorts = importPorts.Where(p => p.AllowImport).ToList();

    decimal totalVal = ViewBag.TotalValue != null ? (decimal)ViewBag.TotalValue : 0;
    decimal totalPaid = ViewBag.TotalPaid != null ? (decimal)ViewBag.TotalPaid : 0;
    decimal totalDebt = ViewBag.TotalDebt != null ? (decimal)ViewBag.TotalDebt : 0;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-800 mb-1" style="color:#1a1a2e;">📥 Bảng nhập kho & Quản lý cung ứng</h2>
        <p class="text-muted mb-0">Quản lý nhập hàng nhiều sản phẩm, theo dõi nhà cung cấp, công nợ, hóa đơn xuất xứ và định giá bán theo giá nhập.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group shadow-sm rounded-3 overflow-hidden me-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 bg-white">
                <i class="bi bi-boxes me-1"></i> Tồn kho hiện tại
            </a>
            <a asp-action="Receipts" class="btn btn-sm btn-success fw-bold px-3 py-2">
                <i class="bi bi-receipt me-1"></i> Bảng nhập kho
            </a>
            <a asp-area="Admin" asp-controller="Transfers" asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 bg-white">
                <i class="bi bi-truck me-1"></i> Chuyển kho liên tỉnh
            </a>
        </div>
        <a asp-area="Admin" asp-controller="Suppliers" asp-action="Index" class="btn btn-sm btn-outline-primary fw-bold px-3 py-2 rounded-3 shadow-sm bg-white" title="Quản lý nhà cung cấp và bảng cung ứng">
            <i class="bi bi-building me-1"></i> Quản lý NCC & Cung ứng
        </a>
        <a href="/Admin/Transfers/Create?sourceStoreId=1&targetStoreId=5" class="btn btn-sm btn-outline-warning fw-bold px-3 py-2 rounded-3 shadow-sm bg-white text-dark" title="Điều chuyển hàng từ Kho tổng về Kho Tây Nam Bộ (Cần Thơ) khi thiếu hàng (Yêu cầu 7)">
            <i class="bi bi-arrow-right-circle-fill text-warning me-1"></i> Chuyển về Tây Nam Bộ
        </a>
        <button type="button" class="btn btn-sm btn-primary fw-bold px-3 py-2 rounded-3 shadow-sm" onclick="openMultiImportModal()">
            <i class="bi bi-plus-circle-fill me-1"></i> Tạo phiếu nhập hàng (Nhiều SP)
        </button>
    </div>
</div>

<!-- THỐNG KÊ TÀI CHÍNH & TỒN KHO NHẬP (YÊU CẦU 5) -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-primary" style="background:#eff6ff;">
                    <i class="bi bi-receipt" style="font-size: 1.8rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng số phiếu nhập</div>
                    <div class="fw-900 fs-3 text-dark">@(ViewBag.TotalReceipts ?? 0)</div>
                    <small class="text-muted">Tổng số chuyến nhập kho</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-success" style="background:#f0fdf4;">
                    <i class="bi bi-box-seam-fill" style="font-size: 1.8rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng số lượng SP nhập</div>
                    <div class="fw-900 fs-3" style="color:#006E4A;">@(ViewBag.TotalQuantity ?? 0) <span class="fs-6 fw-normal text-muted">sp</span></div>
                    <small class="text-success fw-semibold">Đã nhập vào hệ thống kho</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-warning" style="background:#fffbeb;">
                    <i class="bi bi-cash-stack" style="font-size: 1.8rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng giá trị tiền nhập</div>
                    <div class="fw-900 fs-4 text-dark">@totalVal.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                    <small class="text-muted">Đã trả: <strong class="text-success">@totalPaid.ToString("N0") đ</strong></small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-danger" style="background:#fef2f2;">
                    <i class="bi bi-cash-coin" style="font-size: 1.8rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Công nợ còn phải trả</div>
                    <div class="fw-900 fs-4 text-danger">@totalDebt.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                    <small class="text-danger fw-semibold">@(totalDebt > 0 ? "Cần lên kế hoạch thanh toán" : "Đã thanh toán hết")</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BỘ LỌC TÌM KIẾM TOÀN DIỆN (YÊU CẦU 4 & 5 & 6 & 7) -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Receipts" asp-area="Admin" asp-controller="Inventory" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword"
                           class="form-control border-start-0 ps-0"
                           placeholder="Mã phiếu, sản phẩm, SKU, số hóa đơn, tờ khai..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="supplierId" class="form-select form-select-sm">
                    <option value="">-- Tất cả nhà cung cấp --</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id" selected="@(ViewBag.SupplierId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="storeId" class="form-select form-select-sm">
                    <option value="">-- Tất cả kho tiếp nhận --</option>
                    @foreach (var st in stores)
                    {
                        <option value="@st.Id" selected="@(ViewBag.SelectedStoreId == st.Id)">@st.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <select name="paymentStatus" class="form-select form-select-sm">
                    <option value="">-- Thanh toán --</option>
                    <option value="Paid" selected="@(ViewBag.PaymentStatus == "Paid")">Đã thanh toán</option>
                    <option value="Unpaid" selected="@(ViewBag.PaymentStatus == "Unpaid")">Chưa trả (Nợ)</option>
                    <option value="Partial" selected="@(ViewBag.PaymentStatus == "Partial")">Trả một phần</option>
                </select>
            </div>
            <div class="col-md-1">
                <select name="receiptType" class="form-select form-select-sm">
                    <option value="">-- Hình thức --</option>
                    <option value="Domestic" selected="@(ViewBag.ReceiptType == "Domestic")">Trong nước</option>
                    <option value="Import" selected="@(ViewBag.ReceiptType == "Import")">Nhập khẩu</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" title="Từ ngày" />
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" title="Đến ngày" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm w-100 fw-bold rounded-3 text-white" style="background:#006E4A;">
                    <i class="bi bi-funnel-fill"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty((string)ViewBag.Keyword) || ViewBag.SupplierId != null || ViewBag.SelectedStoreId != null || !string.IsNullOrEmpty((string)ViewBag.PaymentStatus) || !string.IsNullOrEmpty((string)ViewBag.ReceiptType) || !string.IsNullOrEmpty((string)ViewBag.FromDate))
                {
                    <a asp-action="Receipts" class="btn btn-sm btn-outline-secondary rounded-3" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- BẢNG DANH SÁCH PHIẾU NHẬP KHO -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4 px-4 d-flex align-items-center justify-content-between">
        <div>
            <h5 class="fw-700 mb-0">📋 Danh sách phiếu nhập hàng & Quản lý công nợ</h5>
            <small class="text-muted">Chứng từ kế toán kho chi tiết: Cho phép theo dõi đơn đã trả/chưa trả, hóa đơn, xuất xứ và điều chuyển nội bộ</small>
        </div>
        <span class="text-muted small">Hiển thị <strong>@Model.Count()</strong> phiếu nhập</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3.5rem;"></i>
                <p class="mt-2 mb-3">Chưa có dữ liệu phiếu nhập kho nào phù hợp với điều kiện tìm kiếm.</p>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" onclick="openMultiImportModal()">
                    <i class="bi bi-plus-circle me-1"></i> Tạo phiếu nhập đầu tiên
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th class="px-4 py-3">Mã phiếu</th>
                            <th class="py-3">Hình thức &amp; Xuất xứ</th>
                            <th class="py-3">Nhà cung cấp &amp; Hóa đơn</th>
                            <th class="py-3">Kho tiếp nhận</th>
                            <th class="py-3" style="max-width:280px;">Mặt hàng nhập (Nhiều SP)</th>
                            <th class="py-3 text-center">Tổng SL</th>
                            <th class="py-3 text-end">Tổng tiền hàng</th>
                            <th class="py-3 text-center">Thanh toán &amp; Công nợ</th>
                            <th class="py-3">Ngày &amp; Người lập</th>
                            <th class="py-3 px-4 text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            decimal totalAmount = r.TotalAmount > 0 ? r.TotalAmount : r.Quantity * r.ImportPrice;
                            int totalQty = r.Items.Any() ? r.Items.Sum(i => i.Quantity) : r.Quantity;
                            <tr>
                                <td class="px-4 py-3">
                                    <span class="badge bg-primary-subtle text-primary fw-bold font-monospace px-2 py-1">
                                        @r.ReceiptCode
                                    </span>
                                </td>
                                <td class="py-3">
                                    @if (r.ReceiptType == "Import")
                                    {
                                        <span class="badge px-2 py-1 rounded-pill fw-bold" style="background:#fef3c7; color:#b45309;">
                                            <i class="bi bi-globe-americas me-1"></i> Nhập khẩu
                                        </span>
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-flag me-1"></i>@(r.OriginCountry ?? "Quốc tế")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge px-2 py-1 rounded-pill fw-bold" style="background:#e0f2fe; color:#0369a1;">
                                            <i class="bi bi-house-door me-1"></i> Nội địa
                                        </span>
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-flag me-1"></i>Việt Nam
                                        </div>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (r.SupplierRef != null)
                                    {
                                        <a asp-area="Admin" asp-controller="Suppliers" asp-action="Details" asp-route-id="@r.SupplierRef.Id" class="fw-bold text-decoration-none text-dark hover-primary">
                                            @r.SupplierRef.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark">@(r.Supplier ?? "—")</div>
                                    }
                                    @if (!string.IsNullOrEmpty(r.InvoiceNumber))
                                    {
                                        <div class="small text-muted font-monospace mt-1">
                                            <i class="bi bi-file-earmark-text me-1 text-primary"></i>HĐ: @r.InvoiceNumber
                                        </div>
                                    }
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@(r.Store?.Name ?? "Kho chính")</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>@(r.Store?.ProvinceName ?? "TP. Hồ Chí Minh")
                                    </div>
                                </td>
                                <td class="py-3" style="max-width:280px;">
                                    @if (r.Items.Any())
                                    {
                                        <div class="fw-bold text-dark small">
                                            <span class="badge bg-secondary-subtle text-secondary me-1">@r.Items.Count mặt hàng</span>
                                        </div>
                                        <div class="small text-muted text-truncate mt-1" title="@string.Join(", ", r.Items.Select(i => $"{i.Variant?.Product?.Name} ({i.Quantity} sp)"))">
                                            @string.Join(", ", r.Items.Select(i => $"{i.Variant?.Product?.Name} ({i.Quantity})"))
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark small">@r.Variant?.Product?.Name</div>
                                        <div class="small text-muted"><code>@r.Variant?.SKU</code></div>
                                    }
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge rounded-pill px-3 py-2 fw-900 fs-6" style="background:#e6f5ef;color:#006E4A;">
                                        +@totalQty
                                    </span>
                                </td>
                                <td class="py-3 text-end fw-bold text-dark">
                                    @totalAmount.ToString("N0") đ
                                </td>
                                <td class="py-3 text-center">
                                    @if (r.PaymentStatus == "Paid")
                                    {
                                        <span class="badge rounded-pill px-2 py-1" style="background:#dcfce7; color:#15803d;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Đã thanh toán
                                        </span>
                                    }
                                    else if (r.PaymentStatus == "Unpaid")
                                    {
                                        <span class="badge rounded-pill px-2 py-1" style="background:#fee2e2; color:#b91c1c;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i> Chưa trả (Nợ: @r.DebtAmount.ToString("N0")đ)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-2 py-1" style="background:#fef3c7; color:#b45309;">
                                            <i class="bi bi-clock-history me-1"></i> Còn nợ @r.DebtAmount.ToString("N0")đ
                                        </span>
                                    }
                                </td>
                                <td class="py-3">
                                    <div class="text-muted small fw-semibold">
                                        <i class="bi bi-calendar3 me-1"></i>@r.ImportDate.ToString("dd/MM/yyyy")
                                    </div>
                                    <small class="text-muted">Bởi: @(r.CreatedByName ?? "NV kho")</small>
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-primary" title="Xem chi tiết phiếu nhập" onclick="viewReceiptDetail(@r.Id)">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                        @if (r.PaymentStatus != "Paid" && r.DebtAmount > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Thanh toán công nợ cho phiếu này" onclick="openPaymentModal(@r.Id, '@r.ReceiptCode', @r.DebtAmount, '@Html.Raw(r.Supplier?.Replace("'", "\\'"))')">
                                                <i class="bi bi-cash-coin"></i>
                                            </button>
                                        }
                                        @if (r.StoreId == 1)
                                        {
                                            <a href="/Admin/Transfers/Create?sourceStoreId=1&targetStoreId=5" class="btn btn-sm btn-outline-warning" title="Chuyển hàng từ Kho tổng này về Kho Tây Nam Bộ (Yêu cầu 7)">
                                                <i class="bi bi-truck text-dark"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL TẠO PHIẾU NHẬP KHO NHIỀU SẢN PHẨM (YÊU CẦU 1, 2, 3, 4, 5, 6, 7, 10) -->
<!-- ========================================================================= -->
<div class="modal fade" id="multiImportModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 bg-light rounded-top-4 pb-3">
                <div>
                    <h5 class="modal-title fw-800 text-dark mb-1">
                        <i class="bi bi-box-seam text-primary me-2"></i>Lập phiếu nhập kho nhiều sản phẩm
                    </h5>
                    <div class="text-muted small">
                        Quy định: Nhập cùng chuyến/lô nhãn hiệu <strong>bắt buộc gồm từ 2 sản phẩm trở lên</strong> (son, phấn, chì kẻ...).
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="multiImportForm">
                    <!-- 1. THÔNG TIN CHỨNG TỪ & NHÀ CUNG CẤP -->
                    <div class="card border p-3 rounded-4 mb-4 bg-light">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle-fill text-primary me-2"></i>Thông tin chứng từ &amp; Đối tác</h6>
                        
                        <div class="row g-3 mb-3">
                            <!-- HÌNH THỨC NHẬP HÀNG (YÊU CẦU 6) -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-secondary">Hình thức nhập hàng <span class="text-danger">*</span></label>
                                <div class="d-flex gap-3 pt-1">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="modalReceiptType" id="mTypeDomestic" value="Domestic" checked onchange="onModalReceiptTypeChange()">
                                        <label class="form-check-label fw-semibold" for="mTypeDomestic">
                                            <i class="bi bi-house-door me-1 text-primary"></i> Nhập trong nước
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="modalReceiptType" id="mTypeImport" value="Import" onchange="onModalReceiptTypeChange()">
                                        <label class="form-check-label fw-semibold" for="mTypeImport">
                                            <i class="bi bi-globe-americas me-1 text-warning"></i> Nhập khẩu quốc tế
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- NHÀ CUNG CẤP (YÊU CẦU 2 & 3) -->
                            <div class="col-md-5">
                                <label class="form-label fw-bold small text-secondary">
                                    Nhà cung cấp / Đối tác <span class="text-danger">*</span>
                                </label>
                                <select id="mSupplierId" class="form-select py-2 shadow-sm" required onchange="onSupplierChange()">
                                    <option value="">-- Chọn nhà cung cấp --</option>
                                    @foreach (var s in suppliers)
                                    {
                                        <option value="@s.Id" 
                                                data-name="@s.Name"
                                                data-country="@s.Country"
                                                data-address="@s.Address"
                                                data-phone="@s.Phone"
                                                data-contact="@s.ContactPerson">
                                            @s.Name [@s.Country]
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- XUẤT XỨ HÀNG HÓA (YÊU CẦU 5) -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary">Quốc gia xuất xứ <span class="text-danger">*</span></label>
                                <input type="text" id="mOriginCountry" class="form-control py-2 shadow-sm" value="Việt Nam" required />
                            </div>
                        </div>

                        <!-- THẺ THÔNG TIN NCC & ĐỊA CHỈ PHẢN HỒI KHI HÀNG LỖI (YÊU CẦU 2) -->
                        <div id="supplierInfoCard" class="alert alert-secondary py-2 px-3 small rounded-3 mb-3 d-none">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong id="sCardName" class="text-dark fs-6"></strong>
                                <span id="sCardCountry" class="badge bg-light text-dark border"></span>
                            </div>
                            <div class="text-dark">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i><strong>Địa chỉ phản hồi khi hàng lỗi:</strong> <span id="sCardAddress"></span>
                            </div>
                            <div class="text-muted mt-1">
                                <span class="me-3"><i class="bi bi-person me-1"></i>Đại diện: <strong id="sCardContact"></strong></span>
                                <span><i class="bi bi-telephone me-1"></i>SĐT: <strong id="sCardPhone"></strong></span>
                            </div>
                        </div>

                        <!-- KHUNG LỊCH SỬ NHẬP CỦA NCC NÀY ĐỂ ĐỐI CHIẾU (YÊU CẦU 8) -->
                        <div id="supplierHistoryCard" class="card border p-2 rounded-3 mb-3 bg-white d-none">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-primary"><i class="bi bi-clock-history me-1"></i>Lịch sử các lần nhập trước của NCC này (Đối chiếu tránh trùng &amp; So sánh giá nhập - Yêu cầu 8):</span>
                                <small class="text-muted">5 lần nhập gần nhất</small>
                            </div>
                            <div id="supplierHistoryList" class="small">
                                <!-- Ajax load -->
                            </div>
                        </div>

                        <!-- PHẦN CẢNG THÔNG QUAN CHO HÀNG QUỐC TẾ (YÊU CẦU 6) -->
                        <div id="mPortSection" class="row g-3 mb-3 d-none">
                            <div class="col-md-7">
                                <label class="form-label fw-bold small text-secondary">
                                    Cảng thông quan quốc tế (Sân bay / Cảng biển) <span class="text-danger">*</span>
                                </label>
                                <select id="mImportPortId" class="form-select py-2 shadow-sm" onchange="onModalPortSelectChange()">
                                    <option value="">-- Chọn cảng tiếp nhận thông quan --</option>
                                    @foreach (var p in activePorts)
                                    {
                                        <option value="@p.Id" 
                                                data-province="@p.ProvinceName"
                                                data-province-code="@p.ProvinceCode"
                                                data-port-type="@p.PortType">
                                            [@(p.PortType == "Sea" ? "Cảng biển" : "Sân bay QT")] @p.Name — @p.ProvinceName
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold small text-secondary">
                                    Số vận đơn / Tờ khai hải quan
                                </label>
                                <input type="text" id="mCustomsDeclarationNumber" class="form-control py-2 shadow-sm" placeholder="Ví dụ: TKHQ-10492852 / BL-8829" />
                            </div>
                            <div id="mPortAlert" class="col-12 py-1 small fw-semibold text-danger d-none"></div>
                        </div>

                        <!-- CHỌN KHO NHẬP HÀNG (YÊU CẦU 7) -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-secondary">
                                    Kho tiếp nhận hàng <span class="text-danger">*</span>
                                </label>
                                <select id="mStoreId" class="form-select py-2 shadow-sm" required onchange="onModalStoreChange()">
                                    @foreach (var s in stores)
                                    {
                                        <option value="@s.Id" 
                                                data-province="@s.ProvinceName"
                                                data-province-code="@s.ProvinceCode"
                                                data-region="@s.Region"
                                                data-store-type="@s.StoreType">
                                            [@(s.Region ?? "Toàn quốc")] @s.Name — @s.ProvinceName (@(s.StoreType ?? "Kho hàng"))
                                        </option>
                                    }
                                </select>
                                <small class="text-muted d-block mt-1">
                                    <i class="bi bi-info-circle me-1"></i>Hàng quốc tế nhập về kho tổng TP.HCM / Hà Nội rồi có thể chuyển tiếp về kho Tây Nam Bộ (Cần Thơ) khi thiếu hàng.
                                </small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary">Số hóa đơn tài chính (VAT)</label>
                                <input type="text" id="mInvoiceNumber" class="form-control py-2 shadow-sm" placeholder="Số hóa đơn GTGT..." />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary">Ngày nhập hàng <span class="text-danger">*</span></label>
                                <input type="datetime-local" id="mImportDate" class="form-control py-2 shadow-sm" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                            </div>
                        </div>

                        <!-- THANH TOÁN VÀ CÔNG NỢ (YÊU CẦU 5) -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-secondary">Trạng thái thanh toán <span class="text-danger">*</span></label>
                                <select id="mPaymentStatus" class="form-select py-2 shadow-sm" onchange="onModalPaymentStatusChange()">
                                    <option value="Paid">Đã thanh toán (Trả tiền ngay bằng CK/Tiền mặt)</option>
                                    <option value="Unpaid">Chưa thanh toán (Ghi nhận công nợ nhà cung cấp)</option>
                                    <option value="Partial">Thanh toán một phần (Trả trước một phần, còn lại ghi nợ)</option>
                                </select>
                            </div>
                            <div class="col-md-6" id="mPaidAmountContainer" style="display:none;">
                                <label class="form-label fw-bold small text-secondary">Số tiền đã trả trước (VNĐ)</label>
                                <div class="input-group shadow-sm">
                                    <input type="number" id="mPaidAmount" class="form-control py-2 text-end fw-bold" min="0" step="1000" value="0" />
                                    <span class="input-group-text bg-white text-muted">đ</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. DANH SÁCH MẶT HÀNG NHẬP (YÊU CẦU 1, 3, 4, 9, 10) -->
                    <div class="card border p-3 rounded-4 mb-3 bg-white">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="fw-bold text-dark mb-1">
                                    <i class="bi bi-cart-plus-fill text-success me-2"></i>Chi tiết các mặt hàng nhập kho
                                    <span class="badge bg-danger ms-2" id="req1Badge">Bắt buộc tối thiểu 2 sản phẩm (Yêu cầu 1)</span>
                                </h6>
                                <small class="text-muted">
                                    Chọn loại sản phẩm (son môi, kem chống nắng...) -> lọc danh sách sản phẩm theo loại và theo nhà cung cấp -> nhập số lượng, đơn giá và định lại giá bán.
                                </small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-3 shadow-sm" onclick="addNewItemRow()">
                                <i class="bi bi-plus-circle-fill me-1"></i> Thêm mặt hàng khác
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle mb-0" id="receiptItemsTable">
                                <thead style="background:#f1f5f9;">
                                    <tr>
                                        <th style="width: 40px;" class="text-center">#</th>
                                        <th style="width: 170px;">1. Loại sản phẩm (Yêu cầu 4)</th>
                                        <th style="min-width: 250px;">2. Sản phẩm &amp; Biến thể (Yêu cầu 3)</th>
                                        <th style="width: 110px;" class="text-center">3. Số lượng</th>
                                        <th style="width: 180px;" class="text-end">4. Đơn giá nhập</th>
                                        <th style="width: 140px;" class="text-end">5. Thành tiền</th>
                                        <th style="min-width: 230px;">6. Định giá bán lẻ mới (Yêu cầu 10)</th>
                                        <th style="width: 50px;" class="text-center">Xóa</th>
                                    </tr>
                                </thead>
                                <tbody id="receiptItemsBody">
                                    <!-- Dynamic rows -->
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td colspan="3" class="text-end text-uppercase small">Tổng cộng phiếu nhập:</td>
                                        <td class="text-center fs-6 text-primary" id="footerTotalQty">0 sp</td>
                                        <td></td>
                                        <td class="text-end fs-6 text-danger" id="footerTotalAmount">0 đ</td>
                                        <td colspan="2" class="text-muted small fst-italic" id="footerValidationText">
                                            Chưa đủ 2 sản phẩm
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- GHI CHÚ -->
                    <div class="mb-2">
                        <label class="form-label fw-bold small text-secondary">Ghi chú phiếu nhập</label>
                        <textarea id="mNote" class="form-control shadow-sm" rows="2" placeholder="Ghi chú số lô, hạn sử dụng, tình trạng niêm phong thùng hàng..."></textarea>
                    </div>

                    <div id="mValidationAlert" class="alert alert-danger py-2 small d-none mt-3"></div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light fw-bold rounded-3" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="btnSubmitMultiReceipt" class="btn btn-primary fw-800 rounded-3 px-4 shadow-sm" onclick="submitMultiItemReceipt()">
                    <i class="bi bi-check-circle-fill me-1"></i> Lưu và nhập kho toàn bộ
                </button>
            </div>
        </div>
    </div>
</div>

