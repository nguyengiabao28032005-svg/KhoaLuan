@section Scripts {
<script>
    // Toàn bộ dữ liệu Categories phục vụ lọc sản phẩm (Yêu cầu 4)
    const allCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(categories.Select(c => new { id = c.Id, name = c.Name })));
    let rowCounter = 0;

    // Mở modal tạo phiếu nhập nhiều sản phẩm
    function openMultiImportModal() {
        document.getElementById('multiImportForm').reset();
        document.getElementById('receiptItemsBody').innerHTML = '';
        rowCounter = 0;
        document.getElementById('supplierInfoCard').classList.add('d-none');
        document.getElementById('supplierHistoryCard').classList.add('d-none');
        document.getElementById('mValidationAlert').classList.add('d-none');

        // Khởi tạo sẵn 2 dòng sản phẩm theo Yêu cầu 1 (Tối thiểu 2 sản phẩm)
        addNewItemRow();
        addNewItemRow();

        onModalReceiptTypeChange();
        new bootstrap.Modal(document.getElementById('multiImportModal')).show();
    }

    // Khi thay đổi loại phiếu nhập (Trong nước vs Nhập khẩu) (Yêu cầu 6)
    function onModalReceiptTypeChange() {
        const isImport = document.getElementById('mTypeImport').checked;
        const portSection = document.getElementById('mPortSection');
        const portSelect = document.getElementById('mImportPortId');
        const originInput = document.getElementById('mOriginCountry');

        if (isImport) {
            portSection.classList.remove('d-none');
            portSelect.required = true;
            if (originInput.value === 'Việt Nam' || !originInput.value) {
                originInput.value = 'Hàn Quốc'; // Mặc định quốc tế
            }
            onModalPortSelectChange();
        } else {
            portSection.classList.add('d-none');
            portSelect.required = false;
            document.getElementById('mPortAlert').classList.add('d-none');
            originInput.value = 'Việt Nam';

            // Mở lại toàn bộ các kho cho phiếu trong nước
            const storeSelect = document.getElementById('mStoreId');
            for (let i = 0; i < storeSelect.options.length; i++) {
                storeSelect.options[i].disabled = false;
                storeSelect.options[i].hidden = false;
            }
        }
    }

    // Lọc kho cùng địa bàn với cảng nhập (Yêu cầu 6)
    function onModalPortSelectChange() {
        const isImport = document.getElementById('mTypeImport').checked;
        if (!isImport) return;

        const portSelect = document.getElementById('mImportPortId');
        const storeSelect = document.getElementById('mStoreId');
        const alertBox = document.getElementById('mPortAlert');

        if (portSelect.selectedIndex <= 0) {
            alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>Vui lòng chọn cảng thông quan để lọc kho tiếp nhận phù hợp.';
            alertBox.classList.remove('d-none');
            return;
        }

        const selectedPortOpt = portSelect.options[portSelect.selectedIndex];
        const portProvince = (selectedPortOpt.getAttribute('data-province') || '').trim().toLowerCase();
        const portProvinceCode = (selectedPortOpt.getAttribute('data-province-code') || '').trim();

        let matchingCount = 0;
        let firstMatchingIndex = -1;

        for (let i = 0; i < storeSelect.options.length; i++) {
            const opt = storeSelect.options[i];
            const storeProvince = (opt.getAttribute('data-province') || '').trim().toLowerCase();
            const storeProvinceCode = (opt.getAttribute('data-province-code') || '').trim();

            const isMatch = (portProvinceCode && storeProvinceCode && portProvinceCode === storeProvinceCode) ||
                            (portProvince && storeProvince && (portProvince === storeProvince || portProvince.includes(storeProvince) || storeProvince.includes(portProvince)));

            if (isMatch) {
                opt.disabled = false;
                opt.hidden = false;
                matchingCount++;
                if (firstMatchingIndex === -1) firstMatchingIndex = i;
            } else {
                opt.disabled = true;
                opt.hidden = true;
            }
        }

        if (matchingCount > 0) {
            alertBox.classList.add('d-none');
            if (storeSelect.selectedIndex === -1 || storeSelect.options[storeSelect.selectedIndex].disabled) {
                storeSelect.selectedIndex = firstMatchingIndex;
            }
        } else {
            alertBox.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i><strong>Chưa có kho phù hợp:</strong> Địa bàn "${selectedPortOpt.getAttribute('data-province')}" chưa có kho.`;
            alertBox.classList.remove('d-none');
        }
    }

