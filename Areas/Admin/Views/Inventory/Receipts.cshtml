                if (result.success && result.data && result.data.length > 0) {
                    result.data.forEach(item => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td>
                                <strong class="text-dark">${item.supplierName}</strong>
                                ${item.supplierPhone ? `<div class="small text-muted"><i class="bi bi-telephone me-1"></i>${item.supplierPhone}</div>` : ''}
                            </td>
                            <td>
                                <div class="fw-semibold">${item.productName}</div>
                                <small class="text-muted"><code>${item.sku}</code> ${item.colorName || ''} ${item.volume || ''}</small>
                            </td>
                            <td class="text-end fw-bold text-success fs-6">
                                ${Number(item.importPrice).toLocaleString('vi-VN')} đ
                            </td>
                            <td class="small text-muted">
                                <span class="badge bg-light text-secondary border">${item.sourceType}</span>
