    // Khi chọn Category trên 1 dòng -> Load đúng sản phẩm thuộc loại đó và thuộc NCC đã chọn (Yêu cầu 3 & 4)
    function onRowCategoryChange(rowId) {
        const row = document.getElementById(rowId);
        const catId = row.querySelector('.row-category').value;
        const variantSelect = row.querySelector('.row-variant');
        const supplierId = document.getElementById('mSupplierId').value;

        if (!catId) {
            variantSelect.innerHTML = '<option value="">-- Vui lòng chọn Loại SP trước --</option>';
            variantSelect.disabled = true;
            return;
        }

        variantSelect.innerHTML = '<option value="">Đang tải sản phẩm...</option>';
        variantSelect.disabled = true;

        let url = `/Admin/Inventory/GetProductsByCategoryAndSupplier?categoryId=${catId}`;
        if (supplierId) {
            url += `&supplierId=${supplierId}`;
        }

        fetch(url)
            .then(res => res.json())
            .then(result => {
                if (result.success && result.data && result.data.length > 0) {
                    let opts = '<option value="">-- Chọn sản phẩm & biến thể --</option>';
                    result.data.forEach(v => {
                        const detail = (v.colorName ? ` - ${v.colorName}` : '') + (v.volume ? ` (${v.volume})` : '');
                        opts += `<option value="${v.variantId}" 
                                         data-product-name="${v.productName}"
                                         data-sku="${v.sku}"
                                         data-retail-price="${v.currentRetailPrice}"
                                         data-original-price="${v.originalPrice}">
                                    ${v.productName} [${v.sku}]${detail}
                                 </option>`;
                    });
                    variantSelect.innerHTML = opts;
                    variantSelect.disabled = false;
                } else {
                    variantSelect.innerHTML = '<option value="">(Không có sản phẩm nào thuộc loại này do NCC cung cấp)</option>';
                    variantSelect.disabled = true;
                }
            });
    }

    // Khi chọn biến thể trên 1 dòng
    function onRowVariantChange(rowId) {
        const row = document.getElementById(rowId);
        const variantSelect = row.querySelector('.row-variant');
        const opt = variantSelect.options[variantSelect.selectedIndex];

        if (variantSelect.selectedIndex <= 0) {
            row.querySelector('.row-product-info').innerText = '';
            row.querySelector('.row-current-retail').innerText = '0 đ';
            return;
        }

        const sku = opt.getAttribute('data-sku');
        const retailPrice = parseFloat(opt.getAttribute('data-retail-price') || '0');
        const originalPrice = parseFloat(opt.getAttribute('data-original-price') || '0');

        row.querySelector('.row-product-info').innerHTML = `<code>SKU: ${sku}</code>`;
        row.querySelector('.row-current-retail').innerText = retailPrice.toLocaleString('vi-VN') + ' đ';
        row.querySelector('.row-current-retail').setAttribute('data-price', retailPrice);

        if (originalPrice > 0) {
            row.querySelector('.row-last-price').innerText = `Gần nhất: ${originalPrice.toLocaleString('vi-VN')}đ`;
            row.querySelector('.row-price').value = originalPrice;
        }

        // Tự động gợi ý giá bán lẻ ban đầu nếu chưa có giá mới
        if (retailPrice > 0) {
            row.querySelector('.row-new-retail').value = retailPrice;
        } else {
            const currentImport = parseFloat(row.querySelector('.row-price').value || '0');
            row.querySelector('.row-new-retail').value = Math.round(currentImport * 1.3 / 1000) * 1000;
        }

        calculateRowTotal(rowId);
    }

    // Tính thành tiền và kiểm tra quan hệ Giá nhập vs Giá bán lẻ (Yêu cầu 10)
    function calculateRowTotal(rowId) {
        const row = document.getElementById(rowId);
        const qty = parseInt(row.querySelector('.row-qty').value || '0');
        const price = parseFloat(row.querySelector('.row-price').value || '0');

        const total = qty * price;
        row.querySelector('.row-total').innerText = total.toLocaleString('vi-VN') + ' đ';
        row.querySelector('.row-total').setAttribute('data-val', total);

        checkPriceMargin(rowId);
        calculateAllTotals();
    }

    // KIỂM TRA QUAN HỆ GIÁ NHẬP VÀ GIÁ BÁN (YÊU CẦU 10)
    function checkPriceMargin(rowId) {
        const row = document.getElementById(rowId);
        const importPrice = parseFloat(row.querySelector('.row-price').value || '0');
        const currentRetail = parseFloat(row.querySelector('.row-current-retail').getAttribute('data-price') || '0');
        const newRetail = parseFloat(row.querySelector('.row-new-retail').value || '0');
        const warningBox = row.querySelector('.row-price-warning');

        const effectiveRetail = newRetail > 0 ? newRetail : currentRetail;

        if (importPrice > 0 && effectiveRetail > 0 && importPrice >= effectiveRetail) {
            warningBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Cảnh báo lỗ:</strong> Giá nhập (${importPrice.toLocaleString('vi-VN')}đ) ≥ Giá bán (${effectiveRetail.toLocaleString('vi-VN')}đ)! Vui lòng tăng giá bán mới.`;
            warningBox.classList.remove('d-none');
        } else {
            warningBox.classList.add('d-none');
        }
    }

    // Tự động tính giá bán theo % Markup (Yêu cầu 10)
    function applyMarkup(rowId, markupRate) {
        const row = document.getElementById(rowId);
        const importPrice = parseFloat(row.querySelector('.row-price').value || '0');
        if (importPrice > 0) {
            const calculatedPrice = Math.round((importPrice * (1 + markupRate)) / 1000) * 1000;
            row.querySelector('.row-new-retail').value = calculatedPrice;
            checkPriceMargin(rowId);
        }
    }

    // Cập nhật lại sản phẩm trên các dòng khi đổi NCC
    function refreshAllItemRowProducts() {
        const rows = document.querySelectorAll('.item-row');
        rows.forEach(r => {
            onRowCategoryChange(r.id);
        });
    }

    // Tính tổng toàn bộ phiếu nhập
    function calculateAllTotals() {
        const rows = document.querySelectorAll('.item-row');
        let totalQty = 0;
        let totalAmt = 0;

        rows.forEach(r => {
            const qty = parseInt(r.querySelector('.row-qty').value || '0');
            const total = parseFloat(r.querySelector('.row-total').getAttribute('data-val') || '0');
            totalQty += qty;
            totalAmt += total;
        });

        document.getElementById('footerTotalQty').innerText = totalQty + ' sp';
        document.getElementById('footerTotalAmount').innerText = totalAmt.toLocaleString('vi-VN') + ' đ';

        const validationText = document.getElementById('footerValidationText');
        const submitBtn = document.getElementById('btnSubmitMultiReceipt');
        const req1Badge = document.getElementById('req1Badge');

        if (rows.length < 2) {
            validationText.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-exclamation-octagon-fill me-1"></i>Chưa đủ điều kiện: Cần tối thiểu 2 mặt hàng (Hiện có: ' + rows.length + ')</span>';
            req1Badge.className = 'badge bg-danger ms-2';
            submitBtn.disabled = true;
        } else {
            validationText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Hợp lệ: Đã có ' + rows.length + ' mặt hàng khác nhau trong chuyến nhập</span>';
            req1Badge.className = 'badge bg-success ms-2';
            submitBtn.disabled = false;
        }
    }

    // Mở popup so sánh giá nhập từ các nơi khác (Yêu cầu 9)
    function openPriceComparisonForRow(rowId) {
        const row = document.getElementById(rowId);
        const variantId = row.querySelector('.row-variant').value;
        if (!variantId) {
            alert('Vui lòng chọn sản phẩm và biến thể trước khi xem so sánh giá.');
            return;
        }

        fetch(`/Admin/Inventory/GetPriceComparison?variantId=${variantId}`)
            .then(res => res.json())
            .then(result => {
                const tbody = document.getElementById('priceComparisonTableBody');
