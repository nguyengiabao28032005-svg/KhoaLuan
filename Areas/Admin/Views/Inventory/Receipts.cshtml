@model IEnumerable<BeautyShop.Models.StockReceipt>
@{
    ViewData["Title"] = "Quản lý nhập kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var suppliers = ViewBag.Suppliers as List<BeautyShop.Models.Supplier> ?? new();
    var stores = ViewBag.Stores as List<BeautyShop.Models.Store> ?? new();
    var importPorts = ViewBag.ImportPorts as List<BeautyShop.Models.ImportPort> ?? new();
    var storeProvinces = stores.Select(s => s.ProvinceCode).Where(c => !string.IsNullOrEmpty(c)).ToHashSet();
    var activePorts = importPorts.Where(p => p.AllowImport && (string.IsNullOrEmpty(p.ProvinceCode) || storeProvinces.Contains(p.ProvinceCode))).ToList();

    decimal totalVal = ViewBag.TotalValue != null ? (decimal)ViewBag.TotalValue : 0;
    int totalCount = ViewBag.TotalReceipts != null ? (int)ViewBag.TotalReceipts : Model.Count();
}

<!-- TIÊU ĐỀ VÀ THANH CÔNG CỤ -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-800 mb-1" style="color:#1a1a2e;">📦 Đặt hàng &amp; Nhập kho</h2>
        <p class="text-muted mb-0">Quy trình khép kín: Đặt hàng NCC &rarr; Quản lý duyệt &rarr; Hàng về đối chiếu phiếu nhập &rarr; Lưu vào kho</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline-info fw-bold px-3 py-2 rounded-3 shadow-sm bg-white" onclick="openPriceComparisonMatrixModal()">
            <i class="bi bi-grid-3x3-gap-fill me-1"></i> Ma trận so sánh giá đa NCC
        </button>
        <a asp-area="Admin" asp-controller="Suppliers" asp-action="SupplierProducts" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 bg-white rounded-3 shadow-sm">
            <i class="bi bi-table me-1"></i> Bảng giá cung ứng biến thể
        </a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 bg-white rounded-3 shadow-sm">
            <i class="bi bi-boxes me-1"></i> Tồn kho hiện tại
        </a>
        <button type="button" class="btn btn-sm btn-primary fw-bold px-3 py-2 rounded-3 shadow-sm" onclick="openCreateReceiptModal()">
            <i class="bi bi-cart-plus-fill me-1"></i> Đặt hàng với nhà cung cấp
        </button>
    </div>
</div>

<!-- 2 THẺ THỐNG KÊ TRỌNG TÂM (ĐÃ LOẠI BỎ THẺ DƯ THỪA) -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-primary" style="background:#eff6ff;">
                    <i class="bi bi-receipt" style="font-size: 2rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng số phiếu nhập</div>
                    <div class="fw-900 fs-2 text-dark">@totalCount <span class="fs-6 fw-normal text-muted">phiếu</span></div>
                    <small class="text-muted">Tổng số chuyến nhập kho đã lập trong hệ thống</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-success" style="background:#f0fdf4;">
                    <i class="bi bi-cash-stack" style="font-size: 2rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng giá trị nhập kho</div>
                    <div class="fw-900 fs-2 text-success">@totalVal.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                    <small class="text-muted">Tổng giá trị vốn hàng hóa nhập về toàn chuỗi kho</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- THANH LỌC VÀ TÌM KIẾM PHIẾU NHẬP -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Receipts" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-start-0" placeholder="Mã phiếu, NCC, HĐ, người lập..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="supplierId" class="form-select form-select-sm">
                    <option value="">-- Tất cả nhà cung cấp --</option>
                    @foreach (var sup in suppliers)
                    {
                        <option value="@sup.Id" selected="@(ViewBag.SupplierId == sup.Id)">@sup.Name [@sup.Country]</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="storeId" class="form-select form-select-sm">
                    <option value="">-- Tất cả kho tiếp nhận --</option>
                    @foreach (var st in stores)
                    {
                        <option value="@st.Id" selected="@(ViewBag.SelectedStoreId == st.Id)">@st.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="receiptType" class="form-select form-select-sm">
                    <option value="">-- Tất cả hình thức --</option>
                    <option value="Domestic" selected="@(ViewBag.ReceiptType == "Domestic")">Trong nước</option>
                    <option value="Import" selected="@(ViewBag.ReceiptType == "Import")">Nhập khẩu quốc tế</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" title="Từ ngày" />
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" title="Đến ngày" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm w-100 fw-bold rounded-3 text-white" style="background:#006E4A;">
                    <i class="bi bi-funnel-fill"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty((string)ViewBag.Keyword) || ViewBag.SupplierId != null || ViewBag.SelectedStoreId != null || !string.IsNullOrEmpty((string)ViewBag.ReceiptType) || !string.IsNullOrEmpty((string)ViewBag.FromDate))
                {
                    <a asp-action="Receipts" class="btn btn-sm btn-outline-secondary rounded-3" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- TAB ĐIỀU HƯỚNG TÁCH BẠCH QUY TRÌNH: ĐẶT HÀNG NCC VS. NHẬP HÀNG KHI HÀNG VỀ (YÊU CẦU 2) -->
<ul class="nav nav-pills bg-white p-2 rounded-4 shadow-sm mb-3 border" id="receiptStageTabs">
    <li class="nav-item">
        <a class="nav-link py-2 px-3 fw-bold rounded-3 @(string.IsNullOrEmpty((string)ViewBag.Stage) || (string)ViewBag.Stage == "all" ? "active shadow-sm" : "text-secondary")" 
           asp-action="Receipts" asp-route-stage="all" asp-route-keyword="@ViewBag.Keyword" asp-route-supplierId="@ViewBag.SupplierId" asp-route-storeId="@ViewBag.SelectedStoreId">
            <i class="bi bi-collection-fill me-1"></i> Tất cả chứng từ (@ViewBag.TotalReceipts)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link py-2 px-3 fw-bold rounded-3 @((string)ViewBag.Stage == "orders" ? "active shadow-sm" : "text-secondary")" 
           asp-action="Receipts" asp-route-stage="orders" asp-route-keyword="@ViewBag.Keyword" asp-route-supplierId="@ViewBag.SupplierId" asp-route-storeId="@ViewBag.SelectedStoreId">
            <i class="bi bi-cart-plus-fill me-1"></i> Đặt hàng với nhà cung cấp (@(ViewBag.PendingOrdersCount + ViewBag.ApprovedOrdersCount + ViewBag.OrderedCount))
            @if (ViewBag.PendingOrdersCount > 0)
            {
                <span class="badge bg-warning text-dark rounded-pill ms-1">@ViewBag.PendingOrdersCount chờ duyệt</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link py-2 px-3 fw-bold rounded-3 @((string)ViewBag.Stage == "received" ? "active shadow-sm" : "text-secondary")" 
           asp-action="Receipts" asp-route-stage="received" asp-route-keyword="@ViewBag.Keyword" asp-route-supplierId="@ViewBag.SupplierId" asp-route-storeId="@ViewBag.SelectedStoreId">
            <i class="bi bi-box-seam-fill me-1"></i> Phiếu nhập kho (Hàng đã về) (@ViewBag.ReceivedCount)
        </a>
    </li>
</ul>

<!-- BẢNG DANH SÁCH CHỨNG TỪ (ĐẶT HÀNG & NHẬP KHO) -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4 px-4 d-flex align-items-center justify-content-between">
        <div>
            <h5 class="fw-700 mb-0">📋 Danh sách chứng từ đặt hàng &amp; nhập kho</h5>
            <small class="text-muted">Theo dõi quy trình đặt hàng NCC, phê duyệt quản lý, đối chiếu phiếu xuất kho và lưu kho thực tế</small>
        </div>
        <span class="text-muted small">Hiển thị <strong>@Model.Count()</strong> chứng từ</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3.5rem;"></i>
                <p class="mt-2 mb-3">Chưa có chứng từ nào phù hợp với bộ lọc hiện tại.</p>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" onclick="openCreateReceiptModal()">
                    <i class="bi bi-cart-plus me-1"></i> Lập đơn đặt hàng mới với NCC
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background:#f8fafc;">
                        <tr class="small text-secondary text-uppercase fw-bold">
                            <th class="px-4 py-3">Mã chứng từ</th>
                            <th class="py-3">Giai đoạn quy trình</th>
                            <th class="py-3">Hình thức</th>
                            <th class="py-3">Nhà cung cấp</th>
                            <th class="py-3">Kho tiếp nhận</th>
                            <th class="py-3 text-center">SL đặt / thực nhập</th>
                            <th class="py-3 text-end">Tổng tiền hàng</th>
                            <th class="py-3">Ngày lập</th>
                            <th class="py-3 px-4 text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            decimal totalAmount = r.TotalAmount > 0 ? r.TotalAmount : r.Quantity * r.ImportPrice;
                            int totalQty = r.Items.Any() ? r.Items.Sum(i => i.Quantity) : r.Quantity;
                            int actualQty = r.Items.Any() ? r.Items.Sum(i => i.ActualQuantity) : (r.ReceiptStage == "Received" ? r.Quantity : 0);

                            string stageBadge = r.ReceiptStage switch
                            {
                                "PendingApproval" => "bg-warning text-dark",
                                "Approved" => "bg-info text-dark",
                                "Ordered" => "bg-primary text-white",
                                "Received" => "bg-success text-white",
                                "Cancelled" => "bg-danger text-white",
                                _ => "bg-success text-white"
                            };

                            string stageLabel = r.ReceiptStage switch
                            {
                                "PendingApproval" => "1. Chờ QL duyệt",
                                "Approved" => "2. QL đã duyệt",
                                "Ordered" => "3. Đã gửi NCC",
                                "Received" => "4. Đã nhập kho",
                                "Cancelled" => "Đã hủy",
                                _ => "Đã nhập kho"
                            };

                            <tr>
                                <td class="px-4 py-3">
                                    <span class="badge @(r.ReceiptStage == "Received" ? "bg-success-subtle text-success" : "bg-primary-subtle text-primary") fw-bold font-monospace px-2 py-1">
                                        @r.ReceiptCode
                                    </span>
                                    @if (!string.IsNullOrEmpty(r.SupplierDeliveryNoteCode))
                                    {
                                        <div class="small font-monospace text-muted mt-1" title="Phiếu xuất kho của Nhà cung cấp">
                                            <i class="bi bi-file-earmark-check me-1"></i>PXK: @r.SupplierDeliveryNoteCode
                                        </div>
                                    }
                                </td>
                                <td class="py-3">
                                    <span class="badge @stageBadge px-2 py-1 rounded-pill fw-bold">
                                        @stageLabel
                                    </span>
                                    @if (r.ApprovedAt.HasValue && !string.IsNullOrEmpty(r.ApprovedByName))
                                    {
                                        <div class="small text-muted mt-1" style="font-size:10.5px;">
                                            Duyệt bởi: @r.ApprovedByName
                                        </div>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (r.ReceiptType == "Import")
                                    {
                                        <span class="badge px-2 py-1 rounded-pill fw-bold" style="background:#fef3c7; color:#b45309;">
                                            <i class="bi bi-globe-americas me-1"></i> Nhập khẩu
                                        </span>
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-flag me-1"></i>@(r.OriginCountry ?? "Quốc tế")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge px-2 py-1 rounded-pill fw-bold" style="background:#e0f2fe; color:#0369a1;">
                                            <i class="bi bi-house-door me-1"></i> Trong nước
                                        </span>
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-flag me-1"></i>Việt Nam
                                        </div>
                                    }
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@(r.SupplierRef?.Name ?? r.Supplier ?? "—")</div>
                                    <div class="small text-muted">
                                        @(r.Items.Any() ? $"{r.Items.Count} mặt hàng" : "1 mặt hàng")
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@(r.Store?.Name ?? "Kho chính")</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>@(r.Store?.ProvinceName ?? "TP. Hồ Chí Minh")
                                    </div>
                                </td>
                                <td class="py-3 text-center">
                                    @if (r.ReceiptStage == "Received")
                                    {
                                        <span class="badge rounded-pill px-3 py-1.5 fw-900 fs-6" style="background:#e6f5ef;color:#006E4A;" title="Số lượng thực nhập đã lưu vào kho">
                                            +@actualQty sp
                                        </span>
                                        @if (totalQty > actualQty)
                                        {
                                            <div class="small text-muted font-monospace mt-1" style="font-size:11px;">
                                                Đặt @totalQty (hủy @(totalQty - actualQty))
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-primary border border-primary-subtle rounded-pill px-3 py-1.5 font-monospace fw-bold" title="Số lượng đang đặt">
                                            Đặt @totalQty sp
                                        </span>
                                    }
                                </td>
                                <td class="py-3 text-end fw-bold text-dark font-monospace">
                                    <div>@totalAmount.ToString("N0") đ</div>
                                    @if (r.DepositAmount > 0)
                                    {
                                        <div class="small text-primary font-monospace" style="font-size:10.5px;">
                                            Cọc: @r.DepositAmount.ToString("N0") đ
                                        </div>
                                    }
                                    @if (r.ReceiptStage == "Received")
                                    {
                                        @if (r.PaymentStatus == "Unpaid")
                                        {
                                            <div class="small font-monospace text-danger fw-bold" style="font-size:11px;" title="Chưa thanh toán cho nhà cung cấp"><i class="bi bi-clock-history me-1"></i>Nợ: @((r.DebtAmount > 0 ? r.DebtAmount : totalAmount).ToString("N0")) đ</div>
                                        }
                                        else if (r.PaymentStatus == "Partial")
                                        {
                                            <div class="small font-monospace text-warning-emphasis fw-bold" style="font-size:11px;" title="Thanh toán một phần"><i class="bi bi-pie-chart me-1"></i>Nợ: @r.DebtAmount.ToString("N0") đ</div>
                                        }
                                        else
                                        {
                                            <div class="small font-monospace text-success" style="font-size:11px;"><i class="bi bi-check-circle me-1"></i>Đã tất toán</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="small text-muted font-monospace" style="font-size:10.5px;">(Chưa nhập kho)</div>
                                    }
                                </td>
                                <td class="py-3 small text-muted">
                                    <div>@r.ImportDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="text-secondary"><i class="bi bi-person me-1"></i>@(r.CreatedByName ?? "Hệ thống")</div>
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-flex justify-content-end align-items-center gap-1">
                                        @if (r.ReceiptStage == "PendingApproval")
                                        {
                                            <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-2.5 fw-bold shadow-xs text-nowrap"
                                                    onclick="openApproveModal(@r.Id, '@r.ReceiptCode')">
                                                <i class="bi bi-check2-circle me-1"></i> Duyệt đơn
                                            </button>
                                        }
                                        else if (r.ReceiptStage == "Approved")
                                        {
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-2.5 fw-bold shadow-xs text-nowrap"
                                                    onclick="openSendSupplierModal(@r.Id, '@r.ReceiptCode', @totalAmount, '@(r.SupplierRef?.Name ?? r.Supplier ?? "")')">
                                                <i class="bi bi-send-fill me-1"></i> Gửi NCC &amp; Cọc
                                            </button>
                                        }
                                        else if (r.ReceiptStage == "Ordered")
                                        {
                                            <button type="button" class="btn btn-sm btn-success rounded-pill px-2.5 fw-bold shadow-xs text-nowrap"
                                                    onclick="openReconcileModal(@r.Id)">
                                                <i class="bi bi-box-arrow-in-down-left me-1"></i> Đối chiếu &amp; Nhập kho
                                            </button>
                                        }
                                        else if (r.ReceiptStage == "Received" && r.PaymentStatus != "Paid")
                                        {
                                            <button type="button" class="btn btn-sm btn-success rounded-pill px-2.5 fw-bold shadow-xs text-nowrap" 
                                                    onclick="openPayDebtModal(@r.Id, '@r.ReceiptCode', @(r.DebtAmount > 0 ? r.DebtAmount : totalAmount), '@(r.SupplierRef?.Name ?? r.Supplier ?? "")')"
                                                    title="Thanh toán công nợ phiếu nhập này">
                                                <i class="bi bi-cash-stack me-1"></i> Trả nợ
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold shadow-xs text-nowrap" onclick="openReceiptDetailModal(@r.Id)">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: ĐẶT HÀNG VỚI NHÀ CUNG CẤP & NHẬP KHO (YÊU CẦU 1 & 2) -->
<!-- ========================================================================= -->
<div class="modal fade" id="createReceiptModal" tabindex="-1" aria-labelledby="createReceiptModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" style="max-width: 95vw;">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-white border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-800 text-dark mb-0" id="createReceiptModalLabel">
                        <i class="bi bi-cart-plus-fill text-primary me-2"></i>Đặt hàng với nhà cung cấp
                    </h5>
                    <small class="text-muted fw-semibold">
                        Lập đơn đặt hàng gửi quản lý duyệt &rarr; Gửi NCC &amp; Đặt cọc &rarr; Hàng về đối chiếu PXK rồi mới lưu kho.
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 bg-light position-relative">
                <form id="createReceiptForm" novalidate onsubmit="event.preventDefault(); submitCreateReceipt();">
                    <div id="cValidationAlert" class="alert alert-danger d-none rounded-3 py-2 px-3 small fw-semibold mb-3"></div>

                    <!-- KHỐI 1: THÔNG TIN BẮT BUỘC -->
                    <div class="card border p-3 rounded-4 mb-3 bg-white shadow-xs">
                        <div class="row g-3">
                            <!-- 0. CHẾ ĐỘ CHỨNG TỪ (YÊU CẦU 2: TÁCH ĐẶT HÀNG VS NHẬP TRỰC TIẾP) -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary">
                                    Quy trình chứng từ <span class="text-danger">*</span>
                                </label>
                                <select id="cReceiptStage" class="form-select py-2 shadow-sm fw-bold text-primary" onchange="onReceiptStageChange()">
                                    <option value="PendingApproval" selected>1. Đặt hàng NCC (Chờ QL duyệt - Mặc định)</option>
                                    <option value="Received">2. Nhập kho trực tiếp ngay (Hàng có sẵn)</option>
                                </select>
                                <small id="cStageHelpText" class="text-muted d-block mt-1" style="font-size:11px;">Chưa tăng tồn kho, cần QL duyệt trước khi gửi NCC.</small>
                            </div>

                            <!-- 1. HÌNH THỨC NHẬP HÀNG (2 NÚT RADIO CĂN CHỈNH GỌN GÀNG TRONG THẺ) -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary">
                                    Hình thức cung ứng <span class="text-danger">*</span>
                                </label>
                                <div class="btn-group w-100 shadow-xs" role="group">
                                    <input type="radio" class="btn-check" name="cReceiptType" id="cTypeDomestic" value="Domestic" checked autocomplete="off" onchange="onReceiptTypeChange()">
                                    <label class="btn btn-outline-primary py-2 fw-bold small text-nowrap" for="cTypeDomestic">
                                        <i class="bi bi-house-door-fill me-1"></i> Trong nước
                                    </label>

                                    <input type="radio" class="btn-check" name="cReceiptType" id="cTypeImport" value="Import" autocomplete="off" onchange="onReceiptTypeChange()">
                                    <label class="btn btn-outline-primary py-2 fw-bold small text-nowrap" for="cTypeImport">
                                        <i class="bi bi-globe me-1"></i> Nhập khẩu
                                    </label>
                                </div>
                            </div>

                            <!-- 2. CẢNG THÔNG QUAN (CHỈ HIỆN KHI NHẬP KHẨU) -->
                            <div class="col-md-3 d-none" id="cPortContainer">
                                <label class="form-label fw-bold small text-secondary">
                                    Cảng thông quan quốc tế <span class="text-danger">*</span>
                                </label>
                                <select id="cImportPortId" class="form-select py-2 shadow-sm" onchange="onPortSelectChange()">
                                    <option value="">-- Chọn cảng thông quan --</option>
                                    @foreach (var p in activePorts)
                                    {
                                        <option value="@p.Id" 
                                                data-province="@p.ProvinceName"
                                                data-province-code="@p.ProvinceCode"
                                                data-port-type="@p.PortType">
                                            [@(p.PortType == "Sea" ? "Cảng biển" : "Sân bay QT")] @p.Name — @p.ProvinceName
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- 3. NHÀ CUNG CẤP -->
                            <div class="col-md-3" id="cSupplierContainer">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label fw-bold small text-secondary mb-0">
                                        Nhà cung cấp <span class="text-danger">*</span>
                                    </label>
                                    <span id="cOriginBadge" class="badge bg-secondary-subtle text-secondary border small">Xuất xứ: Tự động</span>
                                </div>
                                <select id="cSupplierId" class="form-select py-2 shadow-sm" required onchange="onSupplierChange()">
                                    <option value="">-- Chọn nhà cung cấp --</option>
                                    @foreach (var s in suppliers)
                                    {
                                        <option value="@s.Id" 
                                                data-name="@s.Name"
                                                data-country="@(s.Country ?? "Việt Nam")"
                                                data-address="@s.Address"
                                                data-is-domestic="@(s.Country?.Trim() == "Việt Nam" ? "true" : "false")">
                                            @s.Name [@(s.Country ?? "Việt Nam")]
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- 4. KHO TIẾP NHẬN HÀNG -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary">
                                    Kho tiếp nhận hàng <span class="text-danger">*</span>
                                </label>
                                <select id="cStoreId" class="form-select py-2 shadow-sm" required onchange="onStoreChange()">
                                    @foreach (var s in stores)
                                    {
                                        <option value="@s.Id" 
                                                selected="@(s.Id == 1)"
                                                data-province="@s.ProvinceName"
                                                data-province-code="@s.ProvinceCode"
                                                data-region="@s.Region">
                                            [@(s.Region ?? "Toàn quốc")] @s.Name — @s.ProvinceName
                                        </option>
                                    }
                                </select>
                                <small id="cStoreNotice" class="text-muted d-block mt-1" style="font-size:11.5px;"></small>
                            </div>

                            <!-- 5. NGÀY LẬP PHIẾU NHẬP (CHẶN NGÀY TƯƠNG LAI) -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary">
                                    Ngày nhập kho <span class="text-danger">*</span>
                                </label>
                                <input type="datetime-local" id="cImportDate" class="form-control py-2 shadow-sm"
                                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                       max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                                <small class="text-muted d-block mt-1" style="font-size:11px;">Mặc định thời điểm hiện tại, không chọn ngày tương lai.</small>
                            </div>
                        </div>
                    </div>

                    <!-- KHỐI 2: BẢNG CHỌN NHIỀU SẢN PHẨM & LỌC THEO DANH MỤC (YÊU CẦU ĐIỀU CHỈNH GIAI ĐOẠN 1) -->
                    <div class="card border p-3 rounded-4 mb-3 bg-white shadow-xs">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-dark fs-6">
                                    <i class="bi bi-ui-checks-grid text-primary me-1"></i>Bảng chọn mặt hàng nhập kho
                                </span>
                                <span class="badge bg-primary rounded-pill px-3 py-1 font-monospace" id="cItemCountBadge">0 dòng đã chọn</span>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-3 py-1 fw-bold" onclick="clearAllSelectedReceiptItems()">
                                    <i class="bi bi-trash me-1"></i>Bỏ chọn tất cả
                                </button>
                            </div>
                        </div>

                        <!-- BỘ LỌC DANH MỤC & TÌM KIẾM THEO SKU/TÊN SẢN PHẨM -->
                        <div class="row g-2 mb-3 align-items-center bg-light p-2 rounded-3 border">
                            <div class="col-md-4">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white fw-bold text-secondary">
                                        <i class="bi bi-funnel me-1"></i>Danh mục:
                                    </span>
                                    <select id="cCategoryFilter" class="form-select" onchange="onCategoryFilterChange(this.value)">
                                        <option value="">-- Tất cả ngành hàng / Danh mục --</option>
                                        @if (ViewBag.Categories != null)
                                        {
                                            foreach (var cat in (List<BeautyShop.Models.Category>)ViewBag.Categories)
                                            {
                                                <option value="@cat.Id">@cat.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-end-0 text-primary"><i class="bi bi-search"></i></span>
                                    <input type="text" id="variantFilterKeyword" class="form-control border-start-0" placeholder="Lọc nhanh theo SKU, tên sản phẩm trong danh mục..." oninput="onFilterKeywordInput(this.value)" autocomplete="off" />
                                </div>
                            </div>
                            <div class="col-md-3 text-end">
                                <div class="form-check form-switch d-inline-block small text-muted">
                                    <input class="form-check-input" type="checkbox" id="showOnlySuppliedCheck" checked onchange="loadCatalogSelectionGrid()">
                                    <label class="form-check-label fw-bold" for="showOnlySuppliedCheck">Chỉ hiện SP nhà cung cấp</label>
                                </div>
                            </div>
                        </div>

                        <!-- BẢNG CHỌN SẢN PHẨM (CATALOG GRID) -->
                        <div class="table-responsive rounded-3 border" style="max-height: 380px; overflow-y: auto;">
                            <table class="table table-hover table-sm align-middle mb-0" id="catalogSelectionTable">
                                <thead class="table-light sticky-top shadow-xs">
                                    <tr class="small text-secondary">
                                        <th style="width: 40px;" class="text-center">
                                            <input type="checkbox" class="form-check-input" id="checkAllCatalogRows" onclick="toggleSelectAllVisibleRows(this.checked)" title="Chọn tất cả dòng đang hiển thị" />
                                        </th>
                                        <th style="min-width: 220px;">Sản phẩm / Phân loại &amp; SKU</th>
                                        <th style="width: 130px;">Danh mục</th>
                                        <th style="width: 120px;" class="text-center" title="Tồn kho khả dụng tại kho tiếp nhận được chọn">Tồn kho nhận</th>
                                        <th style="width: 120px;" class="text-center" title="Tổng tồn kho khả dụng trên toàn bộ chuỗi hệ thống">Tồn toàn chuỗi</th>
                                        <th style="width: 170px;" class="text-end">Đơn giá nhập (VNĐ) <span class="text-danger">*</span></th>
                                        <th style="width: 120px;" class="text-center">SL nhập <span class="text-danger">*</span></th>
                                        <th style="width: 150px;" class="text-end">Thành tiền (VNĐ)</th>
                                    </tr>
                                </thead>
                                <tbody id="catalogSelectionBody">
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">
                                            <div class="spinner-border spinner-border-sm text-primary me-2"></div> Đang tải danh sách sản phẩm...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- KHỐI 3: THÔNG TIN BỔ SUNG (THU GỌN MẶC ĐỊNH) -->
                    <div class="accordion mb-3" id="additionalInfoAccordion">
                        <div class="accordion-item rounded-4 border overflow-hidden shadow-xs">
                            <h2 class="accordion-header" id="headingAdditional">
                                <button class="accordion-button py-2 bg-white fw-bold text-secondary small" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAdditional" aria-expanded="true" aria-controls="collapseAdditional">
                                    <i class="bi bi-journal-text text-primary me-2"></i>Thông tin bổ sung (Hóa đơn VAT, Tờ khai Hải quan, Công nợ &amp; Ghi chú)
                                </button>
                            </h2>
                            <div id="collapseAdditional" class="accordion-collapse collapse show" aria-labelledby="headingAdditional" data-bs-parent="#additionalInfoAccordion">
                                <div class="accordion-body bg-light p-3">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold small text-secondary">Số hóa đơn tài chính (VAT)</label>
                                            <input type="text" id="cInvoiceNumber" class="form-control form-control-sm py-2 shadow-xs" placeholder="Số hóa đơn GTGT..." />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold small text-secondary">Số vận đơn / Tờ khai hải quan</label>
                                            <input type="text" id="cCustomsDeclarationNumber" class="form-control form-control-sm py-2 shadow-xs" placeholder="VD: TKHQ-104928 / BL-992..." />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold small text-secondary">Hình thức chuyển khoản / Thanh toán</label>
                                            <select id="cPaymentMethod" class="form-select form-select-sm py-2 shadow-xs">
                                                <option value="Chuyển khoản Vietcombank" selected>Chuyển khoản ngân hàng (Vietcombank)</option>
                                                <option value="Chuyển khoản MB Bank">Chuyển khoản ngân hàng (MB Bank)</option>
                                                <option value="Chuyển khoản Techcombank">Chuyển khoản ngân hàng (Techcombank)</option>
                                                <option value="Tiền mặt tại kho">Tiền mặt tại kho</option>
                                            </select>
                                        </div>

                                        <!-- THÔNG TIN ĐẶT CỌC & CHUYỂN KHOẢN (YÊU CẦU 2) -->
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold small text-secondary">Tiền đặt cọc nhà cung cấp (VNĐ)</label>
                                            <input type="number" id="cDepositAmount" class="form-control form-control-sm py-2 text-end font-monospace fw-bold" min="0" step="any" value="0" placeholder="0 đ" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold small text-secondary">Ngày chuyển khoản cọc</label>
                                            <input type="date" id="cDepositTransferDate" class="form-control form-control-sm py-2 shadow-xs" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold small text-secondary">Ngày NCC xác nhận nhận cọc</label>
                                            <input type="date" id="cDepositReceivedDate" class="form-control form-control-sm py-2 shadow-xs" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-bold small text-secondary">Trạng thái thanh toán ban đầu</label>
                                            <select id="cPaymentStatus" class="form-select form-select-sm py-2 shadow-xs" onchange="onPaymentStatusChange()">
                                                <option value="Unpaid" selected>Chưa thanh toán (Ghi nhận công nợ NCC - Mặc định)</option>
                                                <option value="Paid">Đã thanh toán đủ</option>
                                                <option value="Partial">Thanh toán một phần (Đặt cọc)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4 d-none" id="cPaidAmountContainer">
                                            <label class="form-label fw-bold small text-secondary">Số tiền đã trả trước (VNĐ)</label>
                                            <input type="number" id="cPaidAmount" class="form-control form-control-sm py-2 text-end fw-bold" min="0" step="any" value="0" />
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label fw-bold small text-secondary">Ghi chú đơn đặt hàng</label>
                                            <input type="text" id="cNote" class="form-control form-control-sm py-2 shadow-xs" placeholder="Ghi chú nội bộ cho chuyến nhập này..." />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- THANH CỐ ĐỊNH TÓM TẮT DÒNG ĐÃ CHỌN (STICKY BOTTOM BAR) -->
                    <div id="receiptStickyBar" class="d-flex flex-wrap align-items-center justify-content-between p-3 bg-dark text-white rounded-4 shadow-lg mb-2">
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <span class="text-secondary small d-block">Mặt hàng đã chọn:</span>
                                <span class="fs-5 fw-bold text-white"><span id="stickyItemCount" class="text-warning font-monospace">0</span> dòng</span>
                            </div>
                            <div class="border-start border-secondary ps-3">
                                <span class="text-secondary small d-block">Tổng số lượng:</span>
                                <span class="fs-5 fw-bold text-info"><span id="stickyTotalQuantity" class="font-monospace">0</span> sp</span>
                            </div>
                            <div class="border-start border-secondary ps-3">
                                <span class="text-secondary small d-block">Tổng giá trị phiếu nhập:</span>
                                <span class="fs-5 fw-bold text-success"><span id="stickyTotalAmount" class="font-monospace">0</span> đ</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-2 mt-md-0">
                            <button type="button" class="btn btn-outline-light rounded-pill px-3 fw-bold btn-sm shadow-sm" onclick="openSelectedItemsReviewModal()">
                                <i class="bi bi-list-check me-1"></i> Xem các dòng đã chọn (<span id="btnReviewCount">0</span>)
                            </button>
                            <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                            <button type="button" id="cSubmitBtn" onclick="submitCreateReceipt()" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Lưu phiếu nhập kho
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: XEM VÀ CHỈNH SỬA TẤT CẢ DÒNG ĐÃ CHỌN TRÊN MỌI DANH MỤC -->
<!-- ========================================================================= -->
<div class="modal fade" id="selectedItemsReviewModal" tabindex="-1" aria-labelledby="selectedItemsReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-white border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark mb-0" id="selectedItemsReviewModalLabel">
                    <i class="bi bi-list-stars text-primary me-2"></i>Chi tiết các dòng hàng đã chọn (Tổng hợp mọi danh mục)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light">
                <div class="table-responsive rounded-3 border bg-white">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>#</th>
                                <th>Sản phẩm &amp; SKU</th>
                                <th>Danh mục</th>
                                <th class="text-end">Đơn giá nhập (VNĐ)</th>
                                <th class="text-center" style="width: 100px;">SL nhập</th>
                                <th class="text-end">Thành tiền</th>
                                <th class="text-center" style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="selectedReviewTableBody">
                            <!-- Rendered dynamically -->
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="3" class="text-end text-secondary">Tổng cộng:</td>
                                <td class="text-end text-muted small">Tổng tiền:</td>
                                <td class="text-center text-primary" id="modalReviewTotalQty">0</td>
                                <td class="text-end text-success" id="modalReviewTotalAmount">0 đ</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-white border-0 py-2 px-4">
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-bold" onclick="clearAllSelectedReceiptItems()">
                    <i class="bi bi-trash me-1"></i> Xóa tất cả lựa chọn
                </button>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Đóng lại</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: MA TRẬN SO SÁNH GIÁ ĐA NHÀ CUNG CẤP (YÊU CẦU 3 & ĐIỀU CHỈNH GIAI ĐOẠN 1) -->
<!-- Hàng là Biến thể, Cột là Nhà cung cấp, Highlight ô giá thấp nhất trên từng dòng -->
<!-- ========================================================================= -->
<div class="modal fade" id="priceComparisonMatrixModal" tabindex="-1" aria-labelledby="priceMatrixModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" style="max-width: 95vw;">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-white border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-800 text-dark mb-0" id="priceMatrixModalLabel">
                        <i class="bi bi-grid-3x3-gap-fill text-info me-2"></i>Ma trận so sánh giá Biến thể giữa các Nhà cung cấp
                    </h5>
                    <small class="text-muted">
                        Bảng ma trận chung: Hàng là từng biến thể, Cột là Nhà cung cấp. Ô thể hiện đơn giá nhập gần nhất hoặc giá tham chiếu; ô xanh lá là giá thấp nhất.
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 bg-light">
                <!-- BỘ LỌC DANH MỤC TRÊN MA TRẬN -->
                <div class="row g-2 align-items-center mb-3 bg-white p-3 rounded-4 shadow-xs border">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light fw-bold text-secondary">Ngành hàng / Danh mục:</span>
                            <select id="matrixCategorySelect" class="form-select" onchange="loadPriceComparisonMatrix(this.value)">
                                <option value="">-- Tất cả ngành hàng --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in (List<BeautyShop.Models.Category>)ViewBag.Categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <input type="text" id="matrixSearchInput" class="form-control form-control-sm" placeholder="Tìm kiếm SKU hoặc tên sản phẩm trên ma trận..." oninput="filterMatrixRows(this.value)" />
                    </div>
                    <div class="col-md-3 text-end small text-muted">
                        <span class="badge bg-success-subtle text-success border border-success-subtle me-1">■ Giá tốt nhất</span>
                        <span class="badge bg-light text-secondary border">■ Giá tham khảo</span>
                    </div>
                </div>

                <!-- BẢNG MA TRẬN GIÁ -->
                <div class="table-responsive rounded-4 border bg-white shadow-xs" style="max-height: 520px; overflow-y: auto;">
                    <table class="table table-bordered table-hover align-middle mb-0" id="priceMatrixTable">
                        <thead class="table-light sticky-top shadow-xs" id="priceMatrixThead">
                            <!-- Rendered dynamically -->
                        </thead>
                        <tbody id="priceMatrixTbody">
                            <!-- Rendered dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-white border-0 py-2 px-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
<!-- ========================================================================= -->
<!-- MODAL: XEM CHI TIẾT PHIẾU NHẬP KHO -->
<!-- ========================================================================= -->
<div class="modal fade" id="receiptDetailModal" tabindex="-1" aria-labelledby="receiptDetailModalLabel" aria-hidden="true">
