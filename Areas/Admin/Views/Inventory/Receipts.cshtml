                } else {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted fst-italic">Chưa có dữ liệu so sánh giá từ các nhà cung cấp khác cho sản phẩm này.</td></tr>';
                }
                new bootstrap.Modal(document.getElementById('priceComparisonModal')).show();
