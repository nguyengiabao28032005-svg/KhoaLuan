@model IEnumerable<BeautyShop.Models.StockReceipt>
@{
    ViewData["Title"] = "Bảng nhập kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var variants = ViewBag.AllVariants as List<BeautyShop.Models.ProductVariant> ?? new();
    var stores = ViewBag.Stores as List<BeautyShop.Models.Store> ?? new();
    var importPorts = ViewBag.ImportPorts as List<BeautyShop.Models.ImportPort> ?? new();
    var activePorts = importPorts.Where(p => p.AllowImport).ToList();
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-800 mb-1" style="color:#1a1a2e;">📥 Bảng nhập kho</h2>
        <p class="text-muted mb-0">Quản lý và theo dõi chi tiết chứng từ nhập hàng. Phiếu đã lưu không cho phép sửa/xóa nhằm bảo đảm tính toàn vẹn tồn kho và kế toán giá vốn.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group shadow-sm rounded-3 overflow-hidden me-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 bg-white">
                <i class="bi bi-boxes me-1"></i> Tồn kho hiện tại
            </a>
            <a asp-action="Receipts" class="btn btn-sm btn-success fw-bold px-3 py-2">
                <i class="bi bi-receipt me-1"></i> Bảng nhập kho
            </a>
            <a asp-area="Admin" asp-controller="Transfers" asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 bg-white">
                <i class="bi bi-truck me-1"></i> Chuyển kho liên tỉnh
            </a>
        </div>
        <a asp-controller="ImportPorts" asp-action="Index" class="btn btn-sm btn-outline-info fw-bold px-3 py-2 rounded-3 shadow-sm bg-white">
            <i class="bi bi-geo-alt-fill me-1"></i> Danh mục cảng (@activePorts.Count cảng mở)
        </a>
        <button type="button" class="btn btn-sm btn-primary fw-bold px-3 py-2 rounded-3 shadow-sm" onclick="openImportModal()">
            <i class="bi bi-plus-circle-fill me-1"></i> Tạo phiếu nhập kho
        </button>
    </div>
</div>

<!-- THỐNG KÊ NHANH -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-primary" style="background:#eff6ff;">
                    <i class="bi bi-receipt" style="font-size: 1.8rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng số phiếu nhập</div>
                    <div class="fw-900 fs-3 text-dark">@(ViewBag.TotalReceipts ?? 0)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-success" style="background:#f0fdf4;">
                    <i class="bi bi-box-seam-fill" style="font-size: 1.8rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng số lượng SP nhập</div>
                    <div class="fw-900 fs-3" style="color:#006E4A;">@(ViewBag.TotalQuantity ?? 0) <span class="fs-6 fw-normal text-muted">sản phẩm</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 text-warning" style="background:#fffbeb;">
                    <i class="bi bi-cash-stack" style="font-size: 1.8rem;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng giá trị tiền nhập</div>
                    <div class="fw-900 fs-3 text-dark">@(((decimal)(ViewBag.TotalValue ?? 0)).ToString("N0")) <span class="fs-6 fw-normal text-muted">đ</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BỘ LỌC TÌM KIẾM -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Receipts" asp-area="Admin" asp-controller="Inventory" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword"
                           class="form-control border-start-0 ps-0"
                           placeholder="Mã phiếu, tên SP, SKU, tờ khai hải quan, người nhập..." />
                </div>
            </div>
            <div class="col-md-2">
                <input type="text" name="supplier" value="@ViewBag.Supplier"
                       class="form-control" placeholder="Nhà cung cấp..." />
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" value="@ViewBag.FromDate"
                       class="form-control" title="Từ ngày nhập" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" value="@ViewBag.ToDate"
                       class="form-control" title="Đến ngày nhập" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn w-100 fw-700 rounded-3 text-white" style="background:#006E4A;">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty((string)ViewBag.Keyword) || !string.IsNullOrEmpty((string)ViewBag.Supplier) || !string.IsNullOrEmpty((string)ViewBag.FromDate) || !string.IsNullOrEmpty((string)ViewBag.ToDate))
                {
                    <a asp-action="Receipts" class="btn btn-outline-secondary rounded-3" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- BẢNG DANH SÁCH PHIẾU NHẬP KHO -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4 px-4 d-flex align-items-center justify-content-between">
        <div>
            <h5 class="fw-700 mb-0">📋 Danh sách phiếu nhập hàng</h5>
            <small class="text-muted">Chứng từ kế toán kho — Chỉ xem chi tiết, không được phép sửa hoặc xóa</small>
        </div>
        <span class="text-muted small">Hiển thị <strong>@Model.Count()</strong> phiếu nhập</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3.5rem;"></i>
                <p class="mt-2 mb-3">Chưa có dữ liệu phiếu nhập kho nào.</p>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" onclick="openImportModal()">
                    <i class="bi bi-plus-circle me-1"></i> Tạo phiếu nhập đầu tiên
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th class="px-4 py-3">Mã phiếu</th>
                            <th class="py-3">Hình thức</th>
                            <th class="py-3">Cảng thông quan / Vận đơn</th>
                            <th class="py-3">Kho tiếp nhận</th>
                            <th class="py-3">Sản phẩm & Biến thể</th>
                            <th class="py-3 text-center">Số lượng</th>
                            <th class="py-3 text-end">Đơn giá nhập</th>
                            <th class="py-3 text-end">Thành tiền</th>
                            <th class="py-3">Ngày & Người nhập</th>
                            <th class="py-3 px-4 text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            decimal totalAmount = r.Quantity * r.ImportPrice;
                            <tr>
                                <td class="px-4 py-3">
                                    <span class="badge bg-primary-subtle text-primary fw-bold font-monospace px-2 py-1">
                                        @r.ReceiptCode
                                    </span>
                                </td>
                                <td class="py-3">
                                    @if (r.ReceiptType == "Import")
                                    {
                                        <span class="badge px-2 py-1 rounded-pill fw-bold" style="background:#fef3c7; color:#b45309;">
                                            <i class="bi bi-globe-americas me-1"></i> Nhập khẩu
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge px-2 py-1 rounded-pill fw-bold" style="background:#e0f2fe; color:#0369a1;">
                                            <i class="bi bi-house-door me-1"></i> Trong nước
                                        </span>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (r.ReceiptType == "Import" && r.ImportPort != null)
                                    {
                                        <div class="fw-semibold text-dark">
                                            @if (r.ImportPort.PortType == "Sea")
                                            {
                                                <i class="bi bi-water text-primary me-1" title="Cảng biển"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-airplane text-warning me-1" title="Sân bay quốc tế"></i>
                                            }
                                            @r.ImportPort.Name
                                        </div>
                                        @if (!string.IsNullOrEmpty(r.CustomsDeclarationNumber))
                                        {
                                            <div class="small text-muted font-monospace">
                                                <i class="bi bi-file-earmark-text me-1"></i>TK: @r.CustomsDeclarationNumber
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">— (Nội địa)</span>
                                    }
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@(r.Store?.Name ?? "Kho chính")</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>@(r.Store?.ProvinceName ?? "TP. Hồ Chí Minh")
                                        @if (!string.IsNullOrEmpty(r.Store?.Region))
                                        {
                                            <span class="badge bg-light text-secondary border ms-1">@r.Store.Region</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold" style="color:#1a1a2e;">@r.Variant?.Product?.Name</div>
                                    <div class="small text-muted d-flex gap-2 align-items-center mt-1">
                                        <code>@r.Variant?.SKU</code>
                                        @if (!string.IsNullOrEmpty(r.Variant?.ColorName))
                                        {
                                            <span class="badge" style="background:#e6f5ef;color:#006E4A;">@r.Variant.ColorName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(r.Variant?.Volume))
                                        {
                                            <span class="badge" style="background:#eff6ff;color:#1d4ed8;">@r.Variant.Volume</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge rounded-pill px-3 py-2 fw-900 fs-6" style="background:#e6f5ef;color:#006E4A;">
                                        +@r.Quantity
                                    </span>
                                </td>
                                <td class="py-3 text-end fw-bold text-muted">
                                    @(r.ImportPrice > 0 ? r.ImportPrice.ToString("N0") + " đ" : "—")
                                </td>
                                <td class="py-3 text-end fw-bold text-danger">
                                    @(totalAmount > 0 ? totalAmount.ToString("N0") + " đ" : "—")
                                </td>
                                <td class="py-3">
                                    <div class="text-muted small fw-semibold">
                                        <i class="bi bi-calendar3 me-1"></i>@r.ImportDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge bg-light text-dark border px-2 py-0 fw-semibold" style="font-size:0.75rem;">
                                            <i class="bi bi-person me-1"></i>@(r.CreatedByName ?? "N/A")
                                        </span>
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold rounded-3 shadow-sm px-3" onclick="viewReceiptDetail(@r.Id)">
                                        <i class="bi bi-eye me-1"></i> Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL TẠO PHIẾU NHẬP KHO -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-800 text-dark"><i class="bi bi-box-arrow-in-down me-2 text-primary"></i>Tạo phiếu nhập kho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateReceipt" asp-area="Admin" asp-controller="Inventory" id="createReceiptForm">
                <div class="modal-body pt-3">
                    
                    <!-- LOẠI PHIẾU NHẬP -->
                    <div class="card p-3 mb-3 border-0 bg-light rounded-3">
                        <label class="form-label fw-800 text-dark mb-2">
                            <i class="bi bi-shuffle me-1 text-primary"></i> Hình thức nguồn hàng nhập <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="receiptType" id="typeDomestic" value="Domestic" checked onchange="onReceiptTypeChange()">
                                <label class="form-check-label fw-bold text-dark" for="typeDomestic">
                                    📦 Nhập trong nước
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="receiptType" id="typeImport" value="Import" onchange="onReceiptTypeChange()">
                                <label class="form-check-label fw-bold text-dark" for="typeImport">
                                    🚢 Nhập khẩu quốc tế
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- KHU VỰC CẢNG NHẬP KHẨU VÀ TỜ KHAI HẢI QUAN (CHỈ HIỆN KHI LÀ NHẬP KHẨU) -->
                    <div id="importPortSection" class="card p-3 mb-3 border border-warning-subtle bg-warning-subtle rounded-3 d-none">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label fw-800 text-dark small mb-1">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> Cảng nhập khẩu thông quan <span class="text-danger">*</span>
                                </label>
                                <select name="importPortId" id="modal-import-portId" class="form-select py-2 shadow-sm" onchange="onPortSelectChange()">
                                    <option value="">-- Chọn cảng biển / sân bay quốc tế đang mở --</option>
                                    @foreach (var p in activePorts)
                                    {
                                        <option value="@p.Id" 
                                                data-province="@p.ProvinceName" 
                                                data-province-code="@p.ProvinceCode"
                                                data-type="@p.PortType">
                                            [@(p.PortType == "Sea" ? "⚓ Biển" : "✈️ Hàng không")] @p.Name — @p.ProvinceName
                                        </option>
                                    }
                                </select>
                                <small class="text-muted d-block mt-1">Chỉ hiển thị các cảng đang mở tiếp nhận hàng hóa.</small>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-700 text-secondary small mb-1">
                                    Số vận đơn / Tờ khai hải quan
                                </label>
                                <input type="text" name="customsDeclarationNumber" id="modal-import-customs" class="form-control py-2 shadow-sm"
                                       placeholder="Ví dụ: TKHQ-10492852 / BL-8829" />
                                <small class="text-muted d-block mt-1">Mã tờ khai hải quan phục vụ đối chiếu chứng từ (nếu có).</small>
                            </div>
                        </div>
                        <div id="portFilterAlert" class="mt-2 py-1 small fw-semibold text-danger d-none"></div>
                    </div>

                    <!-- CHỌN KHO NHẬP HÀNG (TỰ ĐỘNG LỌC THEO TỈNH CỦA CẢNG KHI NHẬP KHẨU) -->
                    <div class="mb-3">
                        <label class="form-label fw-700 small text-secondary">
                            Kho lưu trữ tiếp nhận hàng <span class="text-danger">*</span>
                        </label>
                        <select name="storeId" id="modal-import-storeId" class="form-select py-2 shadow-sm" required onchange="onStoreSelectChange()">
                            @foreach (var s in stores)
                            {
                                <option value="@s.Id" 
                                        data-province="@s.ProvinceName"
                                        data-province-code="@s.ProvinceCode"
                                        data-region="@s.Region"
                                        data-store-type="@s.StoreType">
                                    [@(s.Region ?? "Toàn quốc")] @s.Name — @s.ProvinceName (@(s.StoreType ?? "Kho hàng"))
                                </option>
                            }
                        </select>
                        <div id="storePortHint" class="form-text small mt-1"></div>
                    </div>

                    <!-- CHỌN BIẾN THỂ SẢN PHẨM -->
                    <div class="mb-3">
                        <label class="form-label fw-700 small text-secondary">Chọn sản phẩm & Biến thể <span class="text-danger">*</span></label>
                        <select name="variantId" id="modal-import-variantId" class="form-select py-2 shadow-sm" required>
                            <option value="">-- Chọn sản phẩm cần nhập --</option>
                            @foreach (var v in variants)
                            {
                                string variantInfo = (!string.IsNullOrEmpty(v.ColorName) ? $" - {v.ColorName}" : "") + (!string.IsNullOrEmpty(v.Volume) ? $" ({v.Volume})" : "");
                                <option value="@v.Id">@v.Product?.Name (@v.SKU)@variantInfo</option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-700 small text-secondary">Số lượng nhập (Bao nhiêu sp) <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-123"></i></span>
                                <input type="number" name="quantity" id="modal-import-quantity" class="form-control py-2 fw-bold text-primary"
                                       min="1" value="10" required placeholder="Nhập số lượng..." />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-700 small text-secondary">Đơn giá nhập (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm">
                                <input type="number" name="importPrice" id="modal-import-price" class="form-control py-2 text-end fw-bold"
                                       min="1000" step="any" value="100000" required placeholder="Giá nhập mỗi sản phẩm" />
                                <span class="input-group-text bg-white text-muted">đ</span>
                            </div>
                            <small class="text-muted">Đơn giá vốn mỗi sản phẩm (VNĐ).</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-700 small text-secondary">Ngày nhập hàng <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="importDate" class="form-control py-2 shadow-sm"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-700 small text-secondary">Người thực hiện nhập</label>
                            <input type="text" class="form-control py-2 shadow-sm bg-light"
                                   value="@(Context.Session.GetString("FullName") ?? "Nhân viên")" readonly />
                            <small class="text-muted fst-italic">Tự động ghi nhận theo tài khoản đang đăng nhập</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-700 small text-secondary">Nhà cung cấp / Đối tác cung ứng</label>
                        <input type="text" name="supplier" class="form-control py-2 shadow-sm"
                               placeholder="Ví dụ: Công ty Phân phối Mỹ phẩm L'Oréal VN, NPP Hasaki, Hãng Estee Lauder Quốc tế..." />
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-700 small text-secondary">Ghi chú phiếu nhập</label>
                        <textarea name="note" class="form-control shadow-sm" rows="2"
                                  placeholder="Ghi chú số lô sản xuất, tình trạng niêm phong, kiểm định chất lượng..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light fw-700 rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitReceipt" class="btn btn-primary fw-800 rounded-3 px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Lưu phiếu nhập
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL XEM CHI TIẾT PHIẾU NHẬP (CHỈ ĐỌC - READ ONLY) -->
<div class="modal fade" id="receiptDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 bg-light rounded-top-4 pb-3">
                <div>
                    <h5 class="modal-title fw-800 text-dark mb-0">
                        <i class="bi bi-file-earmark-check-fill text-success me-2"></i>Chi tiết phiếu nhập kho
                    </h5>
                    <span id="dt-receiptCode" class="badge bg-primary-subtle text-primary font-monospace fs-6 mt-1"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info py-2 small mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                    <div>Chứng từ nhập kho đã được khóa bảo vệ. Toàn bộ thông tin được lưu cố định phục vụ đối soát kế toán và truy vết lịch sử tồn kho.</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small text-uppercase fw-bold">Hình thức nhập hàng</div>
                            <div id="dt-receiptTypeLabel" class="fw-bold fs-6 mt-1"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small text-uppercase fw-bold">Cảng thông quan / Vận đơn</div>
                            <div id="dt-portInfo" class="fw-bold fs-6 mt-1"></div>
                            <div id="dt-customs" class="small text-muted font-monospace mt-1"></div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small text-uppercase fw-bold">Kho tiếp nhận</div>
                            <div id="dt-storeName" class="fw-bold fs-6 mt-1 text-dark"></div>
                            <div id="dt-storeMeta" class="small text-muted mt-1"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small text-uppercase fw-bold">Nhà cung cấp</div>
                            <div id="dt-supplier" class="fw-bold fs-6 mt-1 text-secondary"></div>
                        </div>
                    </div>
                </div>

                <div class="card border p-3 rounded-3 mb-3">
                    <div class="text-muted small text-uppercase fw-bold mb-2">Hàng hóa nhập kho</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div id="dt-productName" class="fw-bold fs-6 text-dark"></div>
                            <div class="small text-muted mt-1">
                                <code id="dt-sku"></code> — <span id="dt-variantDetails"></span>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="small text-muted">Số lượng</div>
                            <div id="dt-quantity" class="badge bg-success-subtle text-success fs-5 fw-900 px-3 py-1"></div>
                        </div>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-muted small">Đơn giá nhập vốn: <strong id="dt-importPrice" class="text-dark"></strong></div>
                        <div class="text-muted small">Tổng giá trị: <strong id="dt-totalAmount" class="text-danger fs-6"></strong></div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <small class="text-muted">Ngày thực hiện nhập: <strong id="dt-importDate" class="text-dark"></strong></small><br />
                        <small class="text-muted">Người lập phiếu: <strong id="dt-createdByName" class="text-dark"></strong></small>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Ghi chú: <span id="dt-note" class="fst-italic"></span></small>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary fw-bold rounded-3 px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openImportModal(variantId) {
        if (variantId > 0) {
            document.getElementById('modal-import-variantId').value = variantId;
        }
        new bootstrap.Modal(document.getElementById('importModal')).show();
        onReceiptTypeChange();
    }

    function onReceiptTypeChange() {
        const isImport = document.getElementById('typeImport').checked;
        const portSection = document.getElementById('importPortSection');
        const portSelect = document.getElementById('modal-import-portId');
        const storeSelect = document.getElementById('modal-import-storeId');
        const alertBox = document.getElementById('portFilterAlert');

        if (isImport) {
            portSection.classList.remove('d-none');
            portSelect.required = true;
            onPortSelectChange();
        } else {
            portSection.classList.add('d-none');
            portSelect.required = false;
            alertBox.classList.add('d-none');

            // Mở lại toàn bộ các kho cho phiếu trong nước
            for (let i = 0; i < storeSelect.options.length; i++) {
                const opt = storeSelect.options[i];
                opt.disabled = false;
                opt.hidden = false;
            }
            onStoreSelectChange();
        }
    }

    function onPortSelectChange() {
        const isImport = document.getElementById('typeImport').checked;
        if (!isImport) return;

        const portSelect = document.getElementById('modal-import-portId');
        const storeSelect = document.getElementById('modal-import-storeId');
        const alertBox = document.getElementById('portFilterAlert');
        const submitBtn = document.getElementById('btnSubmitReceipt');

        if (portSelect.selectedIndex <= 0) {
            alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>Vui lòng chọn cảng nhập khẩu để hệ thống lọc kho thuộc cùng tỉnh/thành phố.';
            alertBox.classList.remove('d-none');
            submitBtn.disabled = true;

            // Vô hiệu hóa chọn kho cho đến khi chọn cảng
            for (let i = 0; i < storeSelect.options.length; i++) {
                storeSelect.options[i].disabled = true;
            }
            return;
        }

        const selectedPortOpt = portSelect.options[portSelect.selectedIndex];
        const portProvince = (selectedPortOpt.getAttribute('data-province') || '').trim().toLowerCase();
        const portProvinceCode = (selectedPortOpt.getAttribute('data-province-code') || '').trim();

        let matchingCount = 0;
        let firstMatchingIndex = -1;

        for (let i = 0; i < storeSelect.options.length; i++) {
            const opt = storeSelect.options[i];
            const storeProvince = (opt.getAttribute('data-province') || '').trim().toLowerCase();
            const storeProvinceCode = (opt.getAttribute('data-province-code') || '').trim();

            const isMatch = (portProvinceCode && storeProvinceCode && portProvinceCode === storeProvinceCode) ||
                            (portProvince && storeProvince && (portProvince === storeProvince || portProvince.includes(storeProvince) || storeProvince.includes(portProvince)));

            if (isMatch) {
                opt.disabled = false;
                opt.hidden = false;
                matchingCount++;
                if (firstMatchingIndex === -1) firstMatchingIndex = i;
            } else {
                opt.disabled = true;
                opt.hidden = true;
            }
        }

        if (matchingCount > 0) {
            alertBox.classList.add('d-none');
            submitBtn.disabled = false;
            // Tự động chọn kho hợp lệ đầu tiên nếu kho hiện tại không hợp lệ
            if (storeSelect.selectedIndex === -1 || storeSelect.options[storeSelect.selectedIndex].disabled) {
                storeSelect.selectedIndex = firstMatchingIndex;
            }
            onStoreSelectChange();
        } else {
            alertBox.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i><strong>Chưa có kho phù hợp:</strong> Tỉnh/thành "<strong>${selectedPortOpt.getAttribute('data-province')}</strong>" hiện chưa có kho tiếp nhận nào. Vui lòng chọn cảng khác (ví dụ: TP.HCM, Hà Nội, Hải Phòng, Đà Nẵng, Cần Thơ) hoặc tạo kho tại tỉnh này.`;
            alertBox.classList.remove('d-none');
            submitBtn.disabled = true;
            storeSelect.selectedIndex = -1;
            document.getElementById('storePortHint').innerHTML = '<span class="text-danger fw-bold">Không có kho nào cùng địa bàn với cảng đã chọn!</span>';
        }
    }

    function onStoreSelectChange() {
        const isImport = document.getElementById('typeImport').checked;
        const storeSelect = document.getElementById('modal-import-storeId');
        const hint = document.getElementById('storePortHint');
        const submitBtn = document.getElementById('btnSubmitReceipt');

        if (storeSelect.selectedIndex < 0 || storeSelect.selectedOptions.length === 0) {
            hint.innerHTML = '';
            return;
        }

        const selected = storeSelect.selectedOptions[0];
        const province = selected.getAttribute('data-province') || '';
        const region = selected.getAttribute('data-region') || '';
        const storeType = selected.getAttribute('data-store-type') || '';

        if (isImport) {
            hint.innerHTML = `<span class="text-muted"><i class="bi bi-geo-alt me-1"></i>Địa chỉ kho: <strong>${province}</strong> (${region} - ${storeType}).</span>`;
            submitBtn.disabled = false;
        } else {
            hint.innerHTML = `<span class="text-muted"><i class="bi bi-geo-alt me-1"></i>Địa chỉ kho: <strong>${province}</strong> (${region} - ${storeType}).</span>`;
            submitBtn.disabled = false;
        }
    }

    function viewReceiptDetail(receiptId) {
        fetch(`/Admin/Inventory/GetReceiptDetail?id=${receiptId}`)
            .then(res => res.json())
            .then(result => {
                if (!result.success) {
                    alert(result.message || 'Lỗi khi tải chi tiết phiếu nhập.');
                    return;
                }
                const d = result.data;
                document.getElementById('dt-receiptCode').innerText = d.receiptCode;
                document.getElementById('dt-receiptTypeLabel').innerHTML = d.receiptType === 'Import' 
                    ? '<span class="badge bg-warning-subtle text-warning fs-6 px-3 py-1"><i class="bi bi-globe-americas me-1"></i>Nhập khẩu quốc tế</span>'
                    : '<span class="badge bg-info-subtle text-info fs-6 px-3 py-1"><i class="bi bi-house-door me-1"></i>Nhập trong nước</span>';
                
                document.getElementById('dt-portInfo').innerText = d.receiptType === 'Import' ? `${d.portName} (${d.portType})` : '—';
                document.getElementById('dt-customs').innerText = d.customsDeclarationNumber && d.customsDeclarationNumber !== '—' ? `Số tờ khai / Vận đơn: ${d.customsDeclarationNumber}` : '';
                document.getElementById('dt-storeName').innerText = d.storeName;
                document.getElementById('dt-storeMeta').innerText = `${d.storeAddress} — ${d.storeProvince} (${d.storeRegion} / ${d.storeType})`;
                document.getElementById('dt-supplier').innerText = d.supplier;
                document.getElementById('dt-productName').innerText = d.productName;
                document.getElementById('dt-sku').innerText = d.sku;
                document.getElementById('dt-variantDetails').innerText = d.variantDetails;
                document.getElementById('dt-quantity').innerText = `+${d.quantity} sp`;
                document.getElementById('dt-importPrice').innerText = Number(d.importPrice).toLocaleString('vi-VN') + ' đ';
                document.getElementById('dt-totalAmount').innerText = Number(d.totalAmount).toLocaleString('vi-VN') + ' đ';
                document.getElementById('dt-importDate').innerText = d.importDate;
                document.getElementById('dt-createdByName').innerText = d.createdByName;
                document.getElementById('dt-note').innerText = d.note;

                new bootstrap.Modal(document.getElementById('receiptDetailModal')).show();
            })
            .catch(err => {
                alert('Không thể kết nối đến máy chủ.');
            });
    }

    document.addEventListener('DOMContentLoaded', function() {
        onReceiptTypeChange();
    });
</script>
}
