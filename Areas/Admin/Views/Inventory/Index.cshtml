@model IEnumerable<BeautyShop.Models.Inventory>
@{
    ViewData["Title"] = "Quản lý kho hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var missingVariants = ViewBag.MissingVariants as List<BeautyShop.Models.ProductVariant> ?? new();
    var stores = ViewBag.Stores as List<BeautyShop.Models.Store> ?? new();
    int? selectedStoreId = ViewBag.SelectedStoreId as int?;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-800 mb-1" style="color:#1a1a2e;">📦 Quản lý kho hàng</h2>
        <p class="text-muted mb-0">Theo dõi tồn kho theo từng kho hàng, nhập hàng và điều chỉnh số lượng toàn hệ thống</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group shadow-sm rounded-3 overflow-hidden me-2">
            <a asp-action="Index" class="btn btn-sm btn-success fw-bold px-3 py-2">
                <i class="bi bi-boxes me-1"></i> Tồn kho hiện tại
            </a>
            <a asp-action="Receipts" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 bg-white">
                <i class="bi bi-receipt me-1"></i> Bảng nhập kho
            </a>
            <a asp-area="Admin" asp-controller="Transfers" asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 bg-white">
                <i class="bi bi-truck me-1"></i> Chuyển kho liên tỉnh
            </a>
        </div>
        @if ((int)(ViewBag.OutOfStock ?? 0) > 0)
        {
            <span class="badge rounded-pill px-3 py-2 fw-700" style="background:#fef2f2;color:#dc2626;font-size:13px;">
                <i class="bi bi-exclamation-circle-fill me-1"></i>Hết hàng: @ViewBag.OutOfStock
            </span>
        }
        @if ((int)(ViewBag.LowStock ?? 0) > 0)
        {
            <span class="badge rounded-pill px-3 py-2 fw-700" style="background:#fffbeb;color:#d97706;font-size:13px;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>Sắp hết: @ViewBag.LowStock
            </span>
        }
    </div>
</div>

<!-- FORM TIM KIEM & LOC -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" asp-area="Admin" asp-controller="Inventory" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword"
                           class="form-control border-start-0 ps-0"
                           placeholder="Tìm theo tên sản phẩm hoặc mã SKU..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="storeId" class="form-select">
                    <option value="">-- Tất cả kho hàng --</option>
                    @foreach (var s in stores)
                    {
                        if (selectedStoreId == s.Id)
                        {
                            <option value="@s.Id" selected>📍 @s.Name (@s.ProvinceName)</option>
                        }
                        else
                        {
                            <option value="@s.Id">📍 @s.Name (@s.ProvinceName)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                @{
                    var currentStockStatus = (string)(ViewBag.CurrentStockStatus ?? "");
                }
                <select name="stockStatus" class="form-select">
                    <option value="">-- Tất cả trạng thái kho --</option>
                    @if (currentStockStatus == "ok")
                    {
                        <option value="ok" selected>✅ Còn hàng (> 5)</option>
                    }
                    else
                    {
                        <option value="ok">✅ Còn hàng (> 5)</option>
                    }
                    @if (currentStockStatus == "low")
                    {
                        <option value="low" selected>⚠️ Sắp hết hàng (1 - 5)</option>
                    }
                    else
                    {
                        <option value="low">⚠️ Sắp hết hàng (1 - 5)</option>
                    }
                    @if (currentStockStatus == "out")
                    {
                        <option value="out" selected>🔴 Hết hàng (= 0)</option>
                    }
                    else
                    {
                        <option value="out">🔴 Hết hàng (= 0)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn w-100 fw-700 rounded-3" style="background:#006E4A;color:#fff;">
                    <i class="bi bi-funnel-fill me-1"></i>Lọc
                </button>
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- BANG TON KHO DA CO -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4 px-4 d-flex align-items-center justify-content-between">
        <h5 class="fw-700 mb-0">📋 Danh sách tồn kho</h5>
        @if (!string.IsNullOrEmpty((string)(ViewBag.Keyword ?? "")) || !string.IsNullOrEmpty((string)(ViewBag.CurrentStockStatus ?? "")))
        {
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Kết quả: <strong>@ViewBag.TotalCount</strong> biến thể</span>
                <a asp-action="Index" asp-area="Admin" asp-controller="Inventory" class="btn btn-sm btn-outline-secondary rounded-pill">
                    <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                </a>
            </div>
        }
        else
        {
            <span class="text-muted small">Tổng: <strong>@((Model?.Count() ?? 0) + (ViewBag.MissingVariants as List<BeautyShop.Models.ProductVariant> ?? new()).Count)</strong> biến thể</span>
        }
    </div>
    <div class="card-body p-0">
        @if (!Model.Any() && !missingVariants.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-box" style="font-size:3rem;"></i>
                <p class="mt-2">Chưa có dữ liệu kho hàng.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th class="px-4 py-3">Sản phẩm</th>
                            <th class="py-3">SKU</th>
                            <th class="py-3">Màu / Size</th>
                            <th class="py-3">Kho hàng</th>
                            <th class="py-3 text-center">Tồn kho</th>
                            <th class="py-3 text-center">Trạng thái</th>
                            <th class="py-3 text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model)
                        {
                            string statusClass = inv.StockQuantity == 0 ? "danger" :
                                                 inv.StockQuantity <= 5 ? "warning" : "success";
                            string statusText  = inv.StockQuantity == 0 ? "Hết hàng" :
                                                 inv.StockQuantity <= 5 ? "Sắp hết" : "Còn hàng";
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="fw-700" style="color:#1a1a2e;">@inv.Variant?.Product?.Name</div>
                                </td>
                                <td class="py-3">
                                    <code class="text-muted">@inv.Variant?.SKU</code>
                                </td>
                                <td class="py-3">
                                    @if (!string.IsNullOrEmpty(inv.Variant?.ColorName))
                                    {
                                        <span class="badge" style="background:#e6f5ef;color:#006E4A;">@inv.Variant.ColorName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(inv.Variant?.Volume))
                                    {
                                        <span class="badge" style="background:#eff6ff;color:#1d4ed8;">@inv.Variant.Volume</span>
                                    }
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold text-dark">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(inv.Store?.Name ?? "Kho chính")
                                    </div>
                                    <div class="small text-muted">
                                        @(inv.Store?.ProvinceName ?? "TP.HCM")
                                        @if (!string.IsNullOrEmpty(inv.Store?.Region))
                                        {
                                            <span class="badge bg-light text-secondary border ms-1">@inv.Store.Region</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="fw-900" style="font-size:1.3rem;color:#@(inv.StockQuantity == 0 ? "e53935" : inv.StockQuantity <= 5 ? "f59e0b" : "006E4A");">
                                        @inv.StockQuantity
                                    </span>
                                    @if (inv.InTransitQuantity > 0)
                                    {
                                        <div>
                                            <span class="badge rounded-pill fw-bold" style="background:#fffbeb; color:#d97706; font-size:11px;" title="Số lượng hàng đang trên đường chuyển kho">
                                                <i class="bi bi-truck me-1"></i>+@inv.InTransitQuantity đang chuyển
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge bg-@statusClass-subtle text-@statusClass rounded-pill px-3 py-2 fw-700">
                                        @statusText
                                    </span>
                                </td>
                                <td class="py-3 text-center">
                                    <button class="btn btn-sm btn-outline-success me-1 fw-700"
                                            onclick="openSetModal(@inv.Variant!.Id, '@Html.Raw(inv.Variant.Product?.Name?.Replace("'", "\\'"))', @inv.StockQuantity, @inv.StoreId, '@Html.Raw(inv.Store?.Name?.Replace("'", "\\'"))')">
                                        <i class="bi bi-pencil-square"></i> Cập nhật
                                    </button>
                                    <a href="@Url.Action("Logs", "Inventory", new { area = "Admin", variantId = inv.Variant!.Id })"
                                       class="btn btn-sm btn-outline-secondary fw-700">
                                        <i class="bi bi-clock-history"></i> Lịch sử
                                    </a>
                                </td>
                            </tr>
                        }

                        @* San pham chua co ban ghi kho *@
                        @foreach (var v in missingVariants)
                        {
                            <tr style="background:#fffbeb;">
                                <td class="px-4 py-3">
                                    <div class="fw-700" style="color:#92400e;">@v.Product?.Name</div>
                                    <small class="text-muted">Chưa có tồn kho</small>
                                </td>
                                <td class="py-3"><code class="text-muted">@v.SKU</code></td>
                                <td class="py-3">
                                    @if (!string.IsNullOrEmpty(v.ColorName))
                                    { <span class="badge" style="background:#fde68a;color:#92400e;">@v.ColorName</span> }
                                    @if (!string.IsNullOrEmpty(v.Volume))
                                    { <span class="badge" style="background:#eff6ff;color:#1d4ed8;">@v.Volume</span> }
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-secondary border">Toàn hệ thống (Chưa nhập)</span>
                                </td>
                                <td class="py-3 text-center"><span class="text-muted fw-700">—</span></td>
                                <td class="py-3 text-center">
                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2 fw-700">Chưa nhập</span>
                                </td>
                                <td class="py-3 text-center">
                                    <a asp-action="Receipts" class="btn btn-sm btn-outline-primary fw-700 shadow-sm">
                                        <i class="bi bi-receipt"></i> Tạo phiếu nhập
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL: CẬP NHẬT TRỰC TIẾP SỐ LƯỢNG TỒN KHO -->
<div class="modal fade" id="setModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-800">📦 Cập nhật tồn kho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="SetQuantity" asp-area="Admin" asp-controller="Inventory">
                <div class="modal-body pt-3">
                    <input type="hidden" name="variantId" id="modal-variantId" />
                    <input type="hidden" name="storeId" id="modal-storeId" value="1" />
                    <div class="mb-3">
                        <label class="form-label fw-700 text-muted" style="font-size:13px;">SẢN PHẨM</label>
                        <p class="fw-800 mb-0" id="modal-productName" style="color:#1a1a2e;"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-700 text-muted" style="font-size:13px;">KHO HÀNG ĐIỀU CHỈNH</label>
                        <p class="fw-bold text-primary mb-0" id="modal-storeName"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Kho chính</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-700">Số lượng tồn kho mới</label>
                        <input type="number" name="quantity" id="modal-quantity" class="form-control form-control-lg fw-700"
                               min="0" required style="font-size:1.5rem;text-align:center;color:#006E4A;" />
                        <div class="form-text">Tồn kho hiện tại: <strong id="modal-current">0</strong></div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-700">Ghi chú</label>
                        <input type="text" name="note" class="form-control" placeholder="VD: Kiểm kê kho định kỳ..." />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light fw-700 rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn fw-800 rounded-3 px-4" style="background:#006E4A;color:#fff;">
                        <i class="bi bi-check-circle me-1"></i>Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openSetModal(variantId, productName, current, storeId, storeName) {
        document.getElementById('modal-variantId').value  = variantId;
        document.getElementById('modal-storeId').value    = storeId || 1;
        document.getElementById('modal-productName').textContent = productName;
        document.getElementById('modal-storeName').innerHTML = '<i class="bi bi-geo-alt-fill text-danger me-1"></i>' + (storeName || 'Kho chính');
        document.getElementById('modal-quantity').value   = current;
        document.getElementById('modal-current').textContent = current;
        new bootstrap.Modal(document.getElementById('setModal')).show();
    }
</script>
}
