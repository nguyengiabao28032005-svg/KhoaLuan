@model IEnumerable<BeautyShop.Models.DeliveryTrip>
@{
    ViewData["Title"] = "Danh sách chuyến giao hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var shippers = ViewBag.Shippers as List<BeautyShop.Models.User> ?? new List<BeautyShop.Models.User>();
    var selectedDate = (DateTime?)ViewBag.Date;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-800 mb-1" style="color:#1a1a2e;">📋 Danh sách các chuyến giao hàng</h2>
        <p class="text-muted mb-0">Theo dõi trạng thái các chuyến giao, phân công shipper và tiến độ điểm dừng</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Planner" class="btn btn-primary fw-bold rounded-3 shadow-sm px-3 py-2">
            <i class="bi bi-calendar2-range me-1"></i> Lập chuyến mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1">Ngày giao</label>
            <input type="date" name="date" class="form-control" value="@(selectedDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1">Ca giao</label>
            <select name="shift" class="form-select">
                <option value="">-- Tất cả ca --</option>
                <option value="Morning" selected="@(ViewBag.Shift == "Morning")">Ca Sáng (08:00 - 12:00)</option>
                <option value="Afternoon" selected="@(ViewBag.Shift == "Afternoon")">Ca Chiều (13:00 - 17:00)</option>
                <option value="Evening" selected="@(ViewBag.Shift == "Evening")">Ca Tối (18:00 - 21:00)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1">Trạng thái</label>
            <select name="status" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Draft" selected="@(ViewBag.Status == "Draft")">Nháp</option>
                <option value="Assigned" selected="@(ViewBag.Status == "Assigned")">Đã gán shipper</option>
                <option value="InTransit" selected="@(ViewBag.Status == "InTransit")">Đang giao</option>
                <option value="Completed" selected="@(ViewBag.Status == "Completed")">Hoàn tất</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary fw-bold w-100 py-2 rounded-3">
                <i class="bi bi-funnel me-1"></i> Lọc chuyến
            </button>
            <a asp-action="Trips" class="btn btn-light fw-bold py-2 rounded-3 text-secondary">
                <i class="bi bi-arrow-clockwise"></i>
            </a>
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small fw-bold text-uppercase">
                <tr>
                    <th class="ps-4">Mã chuyến</th>
                    <th>Ngày giao</th>
                    <th>Ca giao</th>
                    <th>Cụm khu vực</th>
                    <th>Shipper phụ trách</th>
                    <th class="text-center">Số đơn</th>
                    <th>Tiền COD dự kiến</th>
                    <th>Tiền COD thực thu</th>
                    <th>Trạng thái</th>
                    <th>Quyết toán COD</th>
                    <th class="pe-4 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td class="ps-4 font-monospace fw-bold text-primary">
                                <a asp-action="Detail" asp-route-id="@t.Id" class="text-decoration-none">@t.TripCode</a>
                            </td>
                            <td>@t.TripDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-light text-dark border">@DeliveryConfig.GetShiftDisplayName(t.Shift)</span></td>
                            <td><span class="badge bg-info-subtle text-info fw-bold">@t.ClusterCode</span></td>
                            <td>
                                @if (t.ShipperUser != null)
                                {
                                    <span class="fw-bold text-dark"><i class="bi bi-person-fill text-primary me-1"></i>@t.ShipperUser.FullName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Chưa gán</span>
                                }
                            </td>
                            <td class="text-center fw-bold">@t.TotalOrders đơn</td>
                            <td class="fw-bold text-dark">@t.TotalCodExpected.ToString("N0") đ</td>
                            <td class="fw-bold text-success">@t.TotalCodCollected.ToString("N0") đ</td>
                            <td>
                                @switch (t.Status)
                                {
                                    case "Draft":
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill fw-bold">Nháp</span>
                                        break;
                                    case "Assigned":
                                        <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-bold">Đã gán</span>
                                        break;
                                    case "InTransit":
                                        <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill fw-bold">Đang giao</span>
                                        break;
                                    case "Completed":
                                        <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-bold">Hoàn tất</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (t.SettlementStatus == "Settled")
                                {
                                    <span class="badge bg-success-subtle text-success fw-bold">
                                        <i class="bi bi-check-all me-1"></i> Đã nộp tiền
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning fw-bold">Chưa nộp tiền</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-action="Detail" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary fw-bold rounded-3">
                                    <i class="bi bi-eye me-1"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy chuyến giao hàng nào phù hợp với bộ lọc.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
