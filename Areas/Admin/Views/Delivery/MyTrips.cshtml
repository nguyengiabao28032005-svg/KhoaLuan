@model IEnumerable<BeautyShop.Models.DeliveryTrip>
@{
    ViewData["Title"] = "Chuyến giao hàng của tôi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var tripDate = (DateTime)ViewBag.TripDate;
    string activeTab = (string)(ViewBag.ActiveTab ?? "trips");
    decimal codHolding = (decimal)(ViewBag.CodHolding ?? 0m);
    decimal codSettled = (decimal)(ViewBag.CodSettled ?? 0m);
    var unsettledTrips = ViewBag.UnsettledTrips as List<BeautyShop.Models.DeliveryTrip> ?? new List<BeautyShop.Models.DeliveryTrip>();
    var deliveredHistory = ViewBag.DeliveredHistory as List<BeautyShop.Models.DeliveryTripStop> ?? new List<BeautyShop.Models.DeliveryTripStop>();
    int totalOrdersHandled = (int)(ViewBag.TotalOrdersHandled ?? 0);
    int successOrdersCount = (int)(ViewBag.SuccessOrdersCount ?? 0);
    int failedOrdersCount = (int)(ViewBag.FailedOrdersCount ?? 0);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-800 mb-1" style="color:#1a1a2e;">🛵 Khu vực làm việc của Shipper</h2>
        <p class="text-muted mb-0">Theo dõi chuyến giao hàng, lịch sử đơn đã giao và đối soát tiền mặt COD nộp về quầy</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <input type="hidden" name="activeTab" value="@activeTab" />
            <input type="date" name="date" class="form-control form-control-sm fw-bold" value="@tripDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- THẺ TỔNG KẾT TÀI CHÍNH & TIỀN COD -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100 @(codHolding > 0 ? "bg-warning-subtle border-start border-4 border-warning" : "bg-white")">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase mb-1">Tiền COD đang giữ (Chưa nộp)</div>
                    <div class="fw-900 fs-3 @(codHolding > 0 ? "text-danger" : "text-success")">
                        @codHolding.ToString("N0") đ
                    </div>
                    <div class="small mt-1 text-muted">
                        @if (codHolding > 0)
                        {
                            <span class="text-danger fw-bold"><i class="bi bi-exclamation-circle-fill me-1"></i>Có @unsettledTrips.Count chuyến cần nộp về quầy</span>
                        }
                        else
                        {
                            <span class="text-success fw-bold"><i class="bi bi-check2-all me-1"></i>Đã nộp đủ tiền về quầy</span>
                        }
                    </div>
                </div>
                <div class="rounded-3 p-3 @(codHolding > 0 ? "bg-warning text-dark" : "bg-light text-secondary") fs-2">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase mb-1">Tổng COD đã nộp quầy</div>
                    <div class="fw-900 fs-3 text-success">
                        @codSettled.ToString("N0") đ
                    </div>
                    <div class="small mt-1 text-muted">
                        <i class="bi bi-shield-check text-success me-1"></i>Thu ngân đã ký nhận đối soát
                    </div>
                </div>
                <div class="rounded-3 p-3 bg-success-subtle text-success fs-2">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase mb-1">Hiệu suất giao hàng</div>
                    <div class="fw-900 fs-3 text-dark">
                        @successOrdersCount / @totalOrdersHandled đơn
                    </div>
                    <div class="small mt-1 text-muted">
                        Thành công: <strong class="text-success">@(totalOrdersHandled > 0 ? (successOrdersCount * 100 / totalOrdersHandled) : 100)%</strong>
                        | Thất bại: <strong class="text-danger">@failedOrdersCount</strong>
                    </div>
                </div>
                <div class="rounded-3 p-3 bg-primary-subtle text-primary fs-2">
                    <i class="bi bi-speedometer2"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ĐIỀU HƯỚNG TAB -->
<ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-4 shadow-sm" role="tablist">
    <li class="nav-item">
        <button class="nav-link fw-bold px-4 py-2 rounded-3 @(activeTab == "trips" ? "active" : "")" id="trips-tab" data-bs-toggle="pill" data-bs-target="#trips-pane" type="button">
            <i class="bi bi-bicycle me-1"></i> Chuyến hôm nay (@Model.Count())
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link fw-bold px-4 py-2 rounded-3 @(activeTab == "history" ? "active" : "")" id="history-tab" data-bs-toggle="pill" data-bs-target="#history-pane" type="button">
            <i class="bi bi-clock-history me-1"></i> Lịch sử đơn hàng đã giao (@deliveredHistory.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link fw-bold px-4 py-2 rounded-3 position-relative @(activeTab == "settlement" ? "active" : "")" id="settlement-tab" data-bs-toggle="pill" data-bs-target="#settlement-pane" type="button">
            <i class="bi bi-cash-coin me-1"></i> Nộp tiền COD về quầy
            @if (unsettledTrips.Any())
            {
                <span class="badge bg-danger rounded-pill ms-1">@unsettledTrips.Count</span>
            }
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- TAB 1: CHUYẾN GIAO TRONG NGÀY -->
    <div class="tab-pane fade @(activeTab == "trips" ? "show active" : "")" id="trips-pane">
        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <i class="bi bi-bicycle text-muted fs-1 mb-3"></i>
                <h5 class="fw-bold text-dark">Bạn chưa có chuyến giao hàng nào trong ngày @tripDate.ToString("dd/MM/yyyy")</h5>
                <p class="text-muted mb-0">Vui lòng liên hệ Quản lý điều phối để được xếp chuyến giao hàng.</p>
            </div>
        }
        else
        {
            foreach (var trip in Model)
            {
                var stops = trip.Stops.OrderBy(s => s.StopOrder).ToList();
                var completedCount = stops.Count(s => s.StopStatus == "Success");
                var failedCount = stops.Count(s => s.StopStatus == "Failed");

                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
                    <!-- HEADER CHUYẾN -->
                    <div class="card-header bg-light border-0 py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-5 fw-900 font-monospace text-primary">@trip.TripCode</span>
                                <span class="badge @(trip.Status == "Completed" ? "bg-success" : (trip.Status == "InTransit" ? "bg-warning" : "bg-primary")) px-3 py-1 rounded-pill fw-bold">
                                    @(trip.Status == "InTransit" ? "Đang giao" : (trip.Status == "Completed" ? "Đã giao xong" : "Chờ xuất phát"))
                                </span>
                                <span class="badge bg-info-subtle text-info fw-bold">@DeliveryConfig.GetShiftDisplayName(trip.Shift)</span>
                                <span class="badge bg-secondary-subtle text-secondary font-monospace">@trip.ClusterCode</span>
                            </div>
                            <div class="small text-muted mt-1">
                                Tiến độ: <strong>@completedCount/@stops.Count</strong> thành công | Tiền COD thu được: <strong class="text-success">@trip.TotalCodCollected.ToString("N0") đ</strong> / @trip.TotalCodExpected.ToString("N0") đ
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (trip.Status == "Assigned" || trip.Status == "Draft")
                            {
                                <form asp-action="StartTrip" method="post" class="d-inline">
                                    <input type="hidden" name="tripId" value="@trip.Id" />
                                    <button type="submit" class="btn btn-warning fw-800 rounded-3 shadow-sm px-4">
                                        <i class="bi bi-play-circle-fill me-1"></i> Xuất phát đi giao
                                    </button>
                                </form>
                            }
                            else if (trip.Status == "Completed")
                            {
                                @if (trip.SettlementStatus == "Settled")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-3 fw-bold">
                                        <i class="bi bi-check2-circle me-1"></i> Đã nộp tiền cho Thu ngân: @(trip.SettlementReceivedAmount?.ToString("N0")) đ
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-danger fw-bold rounded-3 shadow-sm px-3"
                                            onclick="openSettlementModal(@trip.Id, '@trip.TripCode', @trip.TotalCodCollected)">
                                        <i class="bi bi-cash-stack me-1"></i> Báo nộp tiền về quầy (@trip.TotalCodCollected.ToString("N0") đ)
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <!-- THẺ NHẮC NỘP TIỀN COD NẾU ĐÃ GIAO XONG -->
                    @if (trip.Status == "Completed" && trip.SettlementStatus == "Unsettled" && trip.TotalCodCollected > 0)
                    {
                        <div class="alert alert-warning border-0 rounded-0 m-0 py-2 px-4 d-flex align-items-center justify-content-between">
                            <div class="small fw-bold text-dark">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                                Chuyến xe đã giao xong. Bạn đang giữ <strong>@trip.TotalCodCollected.ToString("N0") đ</strong> tiền mặt COD. Vui lòng mang tiền về quầy Thu ngân để quyết toán.
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-dark fw-bold" onclick="openSettlementModal(@trip.Id, '@trip.TripCode', @trip.TotalCodCollected)">
                                Báo nộp tiền
                            </button>
                        </div>
                    }

                    <!-- DANH SÁCH ĐIỂM DỪNG CỦA SHIPPER -->
                    <div class="card-body p-4">
                        <div class="row g-3">
                            @foreach (var stop in stops)
                            {
                                var order = stop.Order;
                                bool isFinished = stop.StopStatus == "Success" || stop.StopStatus == "Failed" || stop.StopStatus == "Removed";

                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 rounded-4 border p-3 @(stop.StopStatus == "Success" ? "border-success bg-success-subtle" : (stop.StopStatus == "Failed" ? "border-danger bg-danger-subtle" : "border-light-subtle shadow-sm bg-white"))">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge rounded-circle bg-primary text-white fs-6 fw-bold p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">
                                                    @stop.StopOrder
                                                </span>
                                                <span class="fw-bold font-monospace text-dark">#@(order?.OrderCode ?? stop.OrderId.ToString())</span>
                                            </div>
                                            <div>
                                                @if (stop.StopStatus == "Success")
                                                {
                                                    <span class="badge bg-success text-white fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Đã giao</span>
                                                }
                                                else if (stop.StopStatus == "Failed")
                                                {
                                                    <span class="badge bg-danger text-white fw-bold"><i class="bi bi-x-circle-fill me-1"></i>Thất bại</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold">Chờ giao</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div class="fw-800 text-dark fs-6">@(order?.CustomerName ?? "Khách hàng")</div>
                                            <div class="text-primary fw-bold small">
                                                <i class="bi bi-telephone-fill me-1"></i>
                                                <a href="tel:@(order?.PhoneNumber)" class="text-decoration-none">@(order?.PhoneNumber ?? "—")</a>
                                            </div>
                                        </div>

                                        <div class="small text-secondary mb-2">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                            <strong>[@(order?.DeliveryZone?.ZoneName ?? "Khu vực")]</strong> @(order?.ShippingAddress ?? "—")
                                        </div>

                                        <div class="d-flex align-items-center justify-content-between py-2 border-top border-bottom my-2 small">
                                            <span class="text-muted fw-bold">Thu tiền COD:</span>
                                            <span class="fw-900 fs-6 @(order?.PaymentMethod == "COD" ? "text-danger" : "text-success")">
                                                @(order?.PaymentMethod == "COD" ? stop.CodExpectedAmount.ToString("N0") + " đ" : "0 đ (Đã thanh toán)")
                                            </span>
                                        </div>

                                        @if (!isFinished && trip.Status == "InTransit")
                                        {
                                            <div class="d-flex gap-2 mt-auto pt-2">
                                                <button type="button" class="btn btn-sm btn-success fw-bold w-100 py-2 rounded-3 shadow-sm"
                                                        onclick="openSuccessModal(@stop.Id, '#@(order?.OrderCode)', @stop.CodExpectedAmount, '@(order?.PaymentMethod)')">
                                                    <i class="bi bi-check-circle me-1"></i> Giao thành công
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger fw-bold w-100 py-2 rounded-3"
                                                        onclick="openFailedModal(@stop.Id, '#@(order?.OrderCode)')">
                                                    <i class="bi bi-x-circle me-1"></i> Thất bại
                                                </button>
                                            </div>
                                        }
                                        else if (stop.StopStatus == "Success")
                                        {
                                            <div class="small text-success fw-bold mt-2">
                                                <i class="bi bi-cash-stack me-1"></i> Đã thu: @stop.CodCollectedAmount.ToString("N0") đ
                                                @if (stop.CompletedAt.HasValue)
                                                {
                                                    <span class="text-muted fw-normal d-block">Lúc: @stop.CompletedAt.Value.ToString("HH:mm dd/MM")</span>
                                                }
                                            </div>
                                        }
                                        else if (stop.StopStatus == "Failed")
                                        {
                                            <div class="small text-danger fw-bold mt-2">
                                                Lý do: @stop.FailureReason
                                                @if (!string.IsNullOrEmpty(stop.Notes))
                                                {
                                                    <span class="d-block text-muted fw-normal">(@stop.Notes)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- TAB 2: LỊCH SỬ ĐƠN HÀNG ĐÃ GIAO -->
    <div class="tab-pane fade @(activeTab == "history" ? "show active" : "")" id="history-pane">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-list-check me-2 text-primary"></i>Nhật ký những đơn hàng bạn đã xử lý</h6>
                <span class="badge bg-primary rounded-pill px-3 py-2 fw-bold">Tổng: @deliveredHistory.Count đơn</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small fw-bold text-uppercase">
                        <tr>
                            <th class="ps-4">Mã đơn</th>
                            <th>Thời gian xử lý</th>
                            <th>Mã chuyến</th>
                            <th>Khách hàng</th>
                            <th>Địa chỉ nhận hàng</th>
                            <th>Tiền COD thu được</th>
                            <th>Kết quả</th>
                            <th class="pe-4 text-end">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (deliveredHistory.Any())
                        {
                            foreach (var item in deliveredHistory)
                            {
                                var o = item.Order;
                                <tr>
                                    <td class="ps-4 font-monospace fw-bold text-primary">#@(o?.OrderCode ?? item.OrderId.ToString())</td>
                                    <td class="small text-muted">
                                        @(item.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? item.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">
                                            @(item.DeliveryTrip?.TripCode ?? "—")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@(o?.CustomerName ?? "Khách hàng")</div>
                                        <div class="text-muted small">@(o?.PhoneNumber ?? "—")</div>
                                    </td>
                                    <td class="small text-secondary" style="max-width: 250px;">
                                        <strong>[@(o?.DeliveryZone?.ZoneName ?? "Khu vực")]</strong> @(o?.ShippingAddress ?? "—")
                                    </td>
                                    <td class="fw-bold @(item.CodCollectedAmount > 0 ? "text-success" : "text-muted")">
                                        @item.CodCollectedAmount.ToString("N0") đ
                                    </td>
                                    <td>
                                        @if (item.StopStatus == "Success" || item.StopStatus == "Delivered")
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-bold">
                                                <i class="bi bi-check-circle-fill me-1"></i> Thành công
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill fw-bold" title="@item.FailureReason">
                                                <i class="bi bi-x-circle-fill me-1"></i> Thất bại
                                            </span>
                                            <div class="small text-muted mt-1" style="font-size:0.75rem;">@item.FailureReason</div>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <span class="text-muted small">@item.Notes</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Bạn chưa có lịch sử đơn hàng nào đã giao hoàn tất.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 3: CÁC CHUYẾN CẦN NỘP TIỀN COD -->
    <div class="tab-pane fade @(activeTab == "settlement" ? "show active" : "")" id="settlement-pane">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-cash-stack me-2 text-danger"></i>Danh sách các chuyến xe cần nộp tiền mặt COD cho Thu ngân</h6>
            </div>
            @if (unsettledTrips.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small fw-bold text-uppercase">
                            <tr>
                                <th class="ps-4">Mã chuyến</th>
                                <th>Ngày giao</th>
                                <th>Ca giao</th>
                                <th>Cụm khu vực</th>
                                <th>Tổng đơn</th>
                                <th>Tiền COD đang giữ</th>
                                <th>Ghi chú của Shipper</th>
                                <th class="pe-4 text-end">Thao tác nộp tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ut in unsettledTrips)
                            {
                                <tr>
                                    <td class="ps-4 font-monospace fw-bold text-primary">@ut.TripCode</td>
                                    <td>@ut.TripDate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-info-subtle text-info fw-bold">@DeliveryConfig.GetShiftDisplayName(ut.Shift)</span></td>
                                    <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@ut.ClusterCode</span></td>
                                    <td class="fw-bold">@ut.TotalOrders đơn</td>
                                    <td class="fw-bold text-danger fs-6">@ut.TotalCodCollected.ToString("N0") đ</td>
                                    <td class="small text-muted">@(ut.SettlementNotes ?? "Chưa gửi thông báo")</td>
                                    <td class="pe-4 text-end">
                                        <button type="button" class="btn btn-sm btn-danger fw-bold rounded-3 px-3 shadow-sm"
                                                onclick="openSettlementModal(@ut.Id, '@ut.TripCode', @ut.TotalCodCollected)">
                                            <i class="bi bi-send-fill me-1"></i> Báo nộp tiền về quầy
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-shield-check text-success fs-1 mb-2 d-block"></i>
                    <h5 class="fw-bold text-dark">Bạn đã nộp đầy đủ tiền mặt COD cho Thu ngân!</h5>
                    <p class="mb-0">Hiện không có khoản tiền COD nào tồn đọng cần bàn giao.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL GIAO THÀNH CÔNG -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 bg-success text-white rounded-top-4">
                <h5 class="modal-title fw-800"><i class="bi bi-check-circle-fill me-2"></i>Xác nhận Giao hàng thành công</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateStop" method="post">
                <input type="hidden" name="stopId" id="modal-success-stopId" />
                <input type="hidden" name="status" value="Success" />
                <div class="modal-body p-4">
                    <p class="mb-3">Đơn hàng: <strong id="modal-success-orderCode" class="text-primary font-monospace"></strong></p>
                    <div class="mb-3" id="modal-cod-group">
                        <label class="form-label fw-bold small text-secondary">Số tiền COD thực thu của khách (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" name="codCollected" id="modal-success-cod" class="form-control py-2 fw-bold text-success fs-5 text-end" required />
                            <span class="input-group-text bg-light fw-bold">đ</span>
                        </div>
                        <small class="text-muted">Đơn không COD sẽ tự động ghi nhận là 0đ.</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small text-secondary">Ghi chú giao hàng (nếu có)</label>
                        <input type="text" name="notes" class="form-control" placeholder="Giao cho người nhà nhận hộ, bảo vệ giữ hộ..." />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light fw-bold rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success fw-bold rounded-3 px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Lưu kết quả
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL GIAO THẤT BẠI -->
<div class="modal fade" id="failedModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 bg-danger text-white rounded-top-4">
                <h5 class="modal-title fw-800"><i class="bi bi-exclamation-triangle-fill me-2"></i>Báo cáo Giao hàng thất bại</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateStop" method="post">
                <input type="hidden" name="stopId" id="modal-failed-stopId" />
                <input type="hidden" name="status" value="Failed" />
                <div class="modal-body p-4">
                    <p class="mb-3">Đơn hàng: <strong id="modal-failed-orderCode" class="text-primary font-monospace"></strong></p>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Bắt buộc chọn lý do thất bại <span class="text-danger">*</span></label>
                        <select name="failureReason" class="form-select py-2 fw-bold" required>
                            <option value="">-- Chọn lý do --</option>
                            <option value="Khách hẹn giao lại ca sau">Khách hẹn giao lại ca sau / ngày khác</option>
                            <option value="Gọi điện nhiều lần không nghe máy">Gọi điện nhiều lần không nghe máy (Thuê bao)</option>
                            <option value="Địa chỉ không chính xác / Không tìm thấy nhà">Địa chỉ không chính xác / Không tìm thấy nhà</option>
                            <option value="Khách từ chối nhận hàng (Đổi ý)">Khách từ chối nhận hàng (Đổi ý / Không có tiền)</option>
                            <option value="Thời tiết mưa bão / Đường ngập không thể tiếp cận">Thời tiết mưa bão / Đường ngập không thể tiếp cận</option>
                            <option value="Lý do khác">Lý do khác</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small text-secondary">Ghi chú chi tiết</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Chi tiết thời gian gọi, phản hồi của khách..." required></textarea>
                        <small class="text-muted">Đơn hàng sẽ tự động quay lại hàng chờ điều phối cho chuyến tiếp theo.</small>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light fw-bold rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold rounded-3 px-4 shadow-sm">
                        <i class="bi bi-x-circle-fill me-1"></i> Xác nhận thất bại
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL BÁO NỘP TIỀN VỀ QUẦY -->
<div class="modal fade" id="settlementModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 bg-warning text-dark rounded-top-4">
                <h5 class="modal-title fw-800"><i class="bi bi-cash-stack me-2"></i>Báo nộp tiền COD về quầy Thu ngân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RequestSettlement" method="post">
                <input type="hidden" name="tripId" id="modal-settlement-tripId" />
                <div class="modal-body p-4">
                    <p class="mb-2">Chuyến xe: <strong id="modal-settlement-tripCode" class="text-primary font-monospace fs-5"></strong></p>
                    <div class="alert alert-info py-2 small mb-3">
                        Số tiền COD thực thu cần bàn giao: <strong class="fs-5 text-danger d-block mt-1" id="modal-settlement-amount"></strong>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small text-secondary">Ghi chú bàn giao cho Thu ngân</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Ví dụ: Đã về quầy nộp đủ tiền mặt, không phát sinh chênh lệch..."></textarea>
                        <small class="text-muted">Sau khi gửi, vui lòng bàn giao trực tiếp tiền mặt tại quầy để Thu ngân xác nhận.</small>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light fw-bold rounded-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning fw-800 rounded-3 px-4 shadow-sm">
                        <i class="bi bi-send-check-fill me-1"></i> Xác nhận báo nộp tiền
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openSuccessModal(stopId, orderCode, expectedCod, paymentMethod) {
        document.getElementById('modal-success-stopId').value = stopId;
        document.getElementById('modal-success-orderCode').textContent = orderCode;
        var codInput = document.getElementById('modal-success-cod');
        var codGroup = document.getElementById('modal-cod-group');
        
        if (paymentMethod === 'COD') {
            codInput.value = expectedCod;
            codInput.readOnly = false;
            codGroup.classList.remove('d-none');
        } else {
            codInput.value = 0;
            codInput.readOnly = true;
            codGroup.classList.add('d-none');
        }
        var modal = new bootstrap.Modal(document.getElementById('successModal'));
        modal.show();
    }

    function openFailedModal(stopId, orderCode) {
        document.getElementById('modal-failed-stopId').value = stopId;
        document.getElementById('modal-failed-orderCode').textContent = orderCode;
        var modal = new bootstrap.Modal(document.getElementById('failedModal'));
        modal.show();
    }

    function openSettlementModal(tripId, tripCode, amount) {
        document.getElementById('modal-settlement-tripId').value = tripId;
        document.getElementById('modal-settlement-tripCode').textContent = tripCode;
        document.getElementById('modal-settlement-amount').textContent = Number(amount).toLocaleString('vi-VN') + ' đ';
        var modal = new bootstrap.Modal(document.getElementById('settlementModal'));
        modal.show();
    }
</script>
