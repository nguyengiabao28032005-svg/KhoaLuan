@model IEnumerable<BeautyShop.ViewModels.VariantPricingRowViewModel>

@{
    ViewData["Title"] = "Thiết lập giá bán";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int unpricedCount = Model.Count(m => !m.HasPrice);
}

<div class="container-fluid px-4 py-4">
    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Sản phẩm</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Thiết lập giá bán</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-tag-fill me-2 text-primary"></i>Thiết Lập Giá Bán</h3>
            <p class="text-muted small mb-0">Cài đặt giá bán lẻ & giá bán sỉ cho biến thể sau khi đã ghi nhận tồn kho từ phiếu nhập</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Inventory" asp-action="Receipts" class="btn btn-outline-success px-3 rounded-3 fw-semibold shadow-sm">
                <i class="bi bi-box-arrow-in-down me-1"></i>Xem phiếu nhập kho
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-3 rounded-3 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Danh sách sản phẩm
            </a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Thống kê nhanh & Bộ lọc -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Pricing" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-secondary mb-1">Lọc theo sản phẩm:</label>
                    <select name="productId" class="form-select" asp-items="ViewBag.Products" onchange="this.form.submit()">
                        <option value="">-- Tất cả sản phẩm --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">Trạng thái giá:</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="onlyUnpriced" value="true" id="filterUnpriced" @(ViewBag.OnlyUnpriced == true ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label fw-semibold text-dark small" for="filterUnpriced">
                            Chỉ hiện biến thể <span class="badge bg-warning text-dark ms-1">Chưa thiết lập giá (@unpricedCount)</span>
                        </label>
                    </div>
                </div>
                <div class="col-md-3 text-end d-flex align-items-end justify-content-end">
                    <a asp-action="Pricing" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách biến thể định giá -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase small font-weight-bold">
                        <tr>
                            <th class="ps-4" style="width: 70px;">Ảnh</th>
                            <th>Biến thể / SKU</th>
                            <th>Phân loại</th>
                            <th class="text-center">Tồn kho</th>
                            <th class="text-end">Giá vốn (Gần nhất)</th>
                            <th class="text-end">Giá bán lẻ</th>
                            <th class="text-end">Giá bán sỉ</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-4" style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "/images/no-image.png" : item.ThumbnailUrl)"
                                             alt="@item.ProductName" class="img-thumbnail rounded-2 shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 260px;" title="@item.ProductName">
                                            @item.ProductName
                                        </div>
                                        <span class="badge bg-light text-secondary border font-monospace small">@item.SKU</span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">
                                            @(item.Volume ?? "Mặc định")
                                            @if (!string.IsNullOrEmpty(item.ColorName))
                                            {
                                                <span> • @item.ColorName</span>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.StockQuantity > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-bold">
                                                <i class="bi bi-box-seam me-1"></i>@item.StockQuantity sp
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-exclamation-circle me-1"></i>Hết / Chưa nhập
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.CostPrice.HasValue && item.CostPrice.Value > 0)
                                        {
                                            <span class="text-secondary fw-semibold">@item.CostPrice.Value.ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic small">Chưa có giá vốn</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.HasPrice)
                                        {
                                            <strong class="text-danger fs-6">@item.RetailPrice!.Value.ToString("N0") đ</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic small">Chưa đặt</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.WholesalePrice.HasValue && item.WholesalePrice.Value > 0)
                                        {
                                            <span class="text-primary fw-semibold">@item.WholesalePrice.Value.ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic small">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.HasPrice)
                                        {
                                            <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Đang mở bán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2.5 py-1.5 rounded-pill fw-bold">
                                                <i class="bi bi-exclamation-circle me-1"></i>Chưa thiết lập giá
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.CanSetPrice)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary px-3 rounded-2 fw-semibold btn-set-price"
                                                    data-id="@item.VariantId"
                                                    data-sku="@item.SKU"
                                                    data-name="@item.ProductName"
                                                    data-stock="@item.StockQuantity"
                                                    data-cost="@(item.CostPrice?.ToString("F0") ?? "0")"
                                                    data-retail="@(item.RetailPrice?.ToString("F0") ?? "")"
                                                    data-wholesale="@(item.WholesalePrice?.ToString("F0") ?? "")">
                                                <i class="bi bi-pencil-square me-1"></i>@(item.HasPrice ? "Sửa giá" : "Đặt giá")
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-light text-muted px-3 rounded-2" disabled title="Cần lập phiếu nhập kho trước khi thiết lập giá">
                                                <i class="bi bi-lock-fill me-1"></i>Chưa có kho
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy biến thể nào theo tiêu chí đã chọn.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thiết lập giá bán -->
<div class="modal fade" id="pricingModal" tabindex="-1" aria-labelledby="pricingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            <form asp-action="SetPricing" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="VariantId" id="modalVariantId" />

                <div class="modal-header bg-light border-0 py-3">
                    <h5 class="modal-title fw-bold text-dark" id="pricingModalLabel">
                        <i class="bi bi-tag-fill me-2 text-primary"></i>Thiết Lập Giá Bán
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="fw-bold text-dark" id="modalProductName">Tên sản phẩm</div>
                        <div class="small text-muted mt-1">
                            SKU: <strong class="font-monospace text-dark" id="modalSKU"></strong> |
                            Tồn kho: <strong class="text-success" id="modalStock">0</strong> sp |
                            Giá vốn: <strong class="text-secondary" id="modalCost">0 đ</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">
                            Giá bán lẻ thực tế (VNĐ) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" name="RetailPrice" id="modalRetailPrice" class="form-control py-2 text-danger fw-bold fs-6" min="1000" step="500" placeholder="Ví dụ: 250000" required />
                            <span class="input-group-text bg-white text-muted">đ</span>
                        </div>
                        <div class="form-text small text-muted">Giá niêm yết bán cho khách hàng trên website.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">
                            Giá bán sỉ / Đại lý (VNĐ) <small class="text-muted fw-normal">(Tùy chọn)</small>
                        </label>
                        <div class="input-group">
                            <input type="number" name="WholesalePrice" id="modalWholesalePrice" class="form-control py-2 text-primary fw-bold" min="0" step="500" placeholder="Ví dụ: 200000" />
                            <span class="input-group-text bg-white text-muted">đ</span>
                        </div>
                        <div class="form-text small text-muted">Giá ưu đãi dành cho đơn hàng sỉ hoặc khách đại lý.</div>
                    </div>
                </div>

                <div class="modal-footer border-0 bg-light py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i>Lưu thiết lập giá
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var pricingModalEl = document.getElementById('pricingModal');
            var pricingModal = pricingModalEl ? new bootstrap.Modal(pricingModalEl) : null;

            document.querySelectorAll('.btn-set-price').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    var sku = this.getAttribute('data-sku');
                    var name = this.getAttribute('data-name');
                    var stock = this.getAttribute('data-stock');
                    var cost = parseFloat(this.getAttribute('data-cost')) || 0;
                    var retail = this.getAttribute('data-retail');
                    var wholesale = this.getAttribute('data-wholesale');

                    document.getElementById('modalVariantId').value = id;
                    document.getElementById('modalProductName').innerText = name;
                    document.getElementById('modalSKU').innerText = sku;
                    document.getElementById('modalStock').innerText = stock;
                    document.getElementById('modalCost').innerText = cost > 0 ? cost.toLocaleString('vi-VN') + ' đ' : 'Chưa có';
                    document.getElementById('modalRetailPrice').value = retail || '';
                    document.getElementById('modalWholesalePrice').value = wholesale || '';

                    if (pricingModal) pricingModal.show();
                });
            });
        });
    </script>
}
