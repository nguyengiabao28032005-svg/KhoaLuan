@model IEnumerable<BeautyShop.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1">Quản Lý Sản Phẩm</h3>
            <p class="text-muted small mb-0">Hệ thống quản lý, cập nhật thông tin và biến thể sản phẩm</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Pricing" class="btn btn-outline-primary px-3 py-2 rounded-3 fw-semibold shadow-sm">
                <i class="bi bi-tag-fill me-1"></i>Thiết lập giá bán
            </a>
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm mới
            </a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="keyword" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Tìm tên sản phẩm hoặc mã SKU..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select text-muted" asp-items="ViewBag.Categories">
                        <option value="">-- Tất cả danh mục --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="brandId" class="form-select text-muted" asp-items="ViewBag.Brands">
                        <option value="">-- Tất cả thương hiệu --</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Lọc</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase small font-weight-bold">
                        <tr>
                            <th class="ps-4" style="width: 80px;">Ảnh</th>
                            <th>Thông tin sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Thương hiệu</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-4" style="width: 210px;">Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                bool hasUnpriced = item.ProductVariants != null && item.ProductVariants.Any(v => !v.HasPrice);
                                <tr>
                                    <td class="ps-4">
                                        <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "/images/no-image.png" : item.ThumbnailUrl)"
                                             alt="@item.Name" class="img-thumbnail rounded-2 shadow-sm" style="width: 55px; height: 55px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 320px;">@item.Name</div>
                                        <span class="badge bg-light text-secondary border mt-1 small">ID: @item.Id</span>
                                    </td>
                                    <td><span class="text-dark">@(item.Category?.Name ?? "N/A")</span></td>
                                    <td><span class="text-secondary fw-medium">@(item.Brand?.Name ?? "N/A")</span></td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Đang bán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Khóa</span>
                                        }

                                        @if (hasUnpriced)
                                        {
                                            <div class="mt-1">
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1 rounded-pill small" title="Có biến thể chưa được thiết lập giá bán lẻ">
                                                    <i class="bi bi-exclamation-circle me-1"></i>Chưa thiết lập giá
                                                </span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-2">
                                            <a asp-action="Pricing" asp-route-productId="@item.Id" class="btn btn-sm btn-outline-success" title="Thiết lập giá bán"><i class="bi bi-tag-fill"></i></a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa thông tin"><i class="bi bi-pencil-square"></i></a>
                                            <a asp-action="Variants" asp-route-productId="@item.Id" class="btn btn-sm btn-outline-info" title="Quản lý biến thể (Dung tích/Màu)"><i class="bi bi-boxes"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa sản phẩm"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không có sản phẩm nào khớp với bộ lọc tìm kiếm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>