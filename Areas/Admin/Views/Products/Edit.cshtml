@model BeautyShop.Models.Product

@{
    ViewData["Title"] = "Cập nhật sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4" style="max-width: 960px;">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Sản phẩm</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh sửa thông tin sản phẩm</h3>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-secondary">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control py-2 shadow-sm" />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold small text-secondary">Danh mục ngành hàng <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select py-2 shadow-sm" asp-items="ViewBag.CategoryId"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BrandId" class="form-label fw-semibold small text-secondary">Thương hiệu nhãn hàng <span class="text-danger">*</span></label>
                        <select asp-for="BrandId" class="form-select py-2 shadow-sm" asp-items="ViewBag.BrandId"></select>
                        <span asp-validation-for="BrandId" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ThumbnailUrl" class="form-label fw-semibold small text-secondary">Đường dẫn ảnh đại diện sản phẩm (URL)</label>
                    <input asp-for="ThumbnailUrl" class="form-control py-2 shadow-sm" />
                    <span asp-validation-for="ThumbnailUrl" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold small text-secondary">Mô tả chi tiết công dụng</label>
                    <textarea asp-for="Description" class="form-control shadow-sm" rows="4" placeholder="Nhập mô tả chi tiết công dụng sản phẩm..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Ingredients" class="form-label fw-semibold small text-secondary"><i class="bi bi-flask me-1 text-success"></i>Thành phần đầy đủ (Ingredients)</label>
                        <textarea asp-for="Ingredients" class="form-control shadow-sm" rows="5" placeholder="Ví dụ: Water, Glycerin, Niacinamide..."></textarea>
                        <span asp-validation-for="Ingredients" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HowToUse" class="form-label fw-semibold small text-secondary"><i class="bi bi-hand-index-thumb me-1 text-primary"></i>Hướng dẫn sử dụng (How to use)</label>
                        <textarea asp-for="HowToUse" class="form-control shadow-sm" rows="5" placeholder="Ví dụ: Thoa đều lên da mặt sau bước làm sạch..."></textarea>
                        <span asp-validation-for="HowToUse" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch p-0 ps-5 mt-2">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" />
                        <label class="form-check-label fw-semibold text-dark ps-2" asp-for="IsActive">Kích hoạt mở bán công khai</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-medium">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-warning text-dark px-5 rounded-3 fw-semibold shadow-sm">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>