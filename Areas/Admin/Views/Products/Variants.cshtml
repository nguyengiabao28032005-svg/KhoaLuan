@model BeautyShop.Models.Product

@{
    ViewData["Title"] = "Quản lý biến thể sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var variants = ViewBag.Variants as IEnumerable<BeautyShop.Models.ProductVariant>;
}

<div class="container-fluid px-4 py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small text-secondary fw-semibold"><i class="bi bi-arrow-left me-1"></i>Trở lại danh sách sản phẩm</a>
        <h3 class="fw-bold text-dark mt-2">Biến Thể Sản Phẩm</h3>
        <p class="text-primary fw-medium mb-0">Sản phẩm: @Model.Name</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-0 py-3">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-plus-square-fill me-2 text-success"></i>Thêm biến thể mới</h6>
                </div>
                <div class="card-body p-3">
                    <form asp-action="AddVariant" method="post">
                        <input type="hidden" name="ProductId" value="@Model.Id" />

                        <div class="mb-2.5">
                            <label class="form-label small fw-semibold text-secondary mb-1">Mã định danh SKU <span class="text-danger">*</span></label>
                            <input type="text" name="SKU" class="form-control form-control-sm shadow-sm" placeholder="Ví dụ: SKU-COCOON-100" required />
                        </div>
                        <div class="mb-2.5">
                            <label class="form-label small fw-semibold text-secondary mb-1">Dung tích / Kích thước (Volume)</label>
                            <input type="text" name="Volume" class="form-control form-control-sm shadow-sm" placeholder="Ví dụ: 50ml, 140ml..." />
                        </div>
                        <div class="mb-2.5">
                            <label class="form-label small fw-semibold text-secondary mb-1">Tên màu sắc (ColorName)</label>
                            <input type="text" name="ColorName" class="form-control form-control-sm shadow-sm" placeholder="Ví dụ: Hồng cánh sen, Tự nhiên..." />
                        </div>
                        <div class="alert alert-info py-2 px-3 small mb-3 border-0 bg-light">
                            <i class="bi bi-info-circle text-primary me-1"></i>
                            Giá vốn và số lượng sẽ cập nhật tự động khi <strong>nhập hàng</strong>. Giá bán được cài đặt tại mục <strong>Thiết lập giá</strong>.
                        </div>

                        <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold py-2 rounded-3 shadow-sm">
                            <i class="bi bi-file-earmark-plus me-1"></i>Xác nhận thêm biến thể
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary text-uppercase small font-weight-bold">
                                <tr>
                                    <th class="ps-3">Mã SKU</th>
                                    <th>Dung tích</th>
                                    <th>Màu sắc</th>
                                    <th class="text-end">Giá bán lẻ</th>
                                    <th class="text-end pe-3">Chức năng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (variants != null && variants.Any())
                                {
                                    foreach (var v in variants)
                                    {
                                        <tr>
                                            <td class="ps-3"><span class="fw-bold text-dark">@v.SKU</span></td>
                                            <td><span class="badge bg-info-subtle text-info rounded-2 px-2 py-1">@(v.Volume ?? "N/A")</span></td>
                                            <td><span class="text-secondary small">@(v.ColorName ?? "N/A")</span></td>
                                            <td class="text-end">
                                                @if (v.HasPrice)
                                                {
                                                    <span class="text-danger fw-bold">@v.RetailPrice!.Value.ToString("N0") đ</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">Chưa thiết lập giá</span>
                                                }
                                            </td>
                                            <td class="text-end pe-3">
                                                <a asp-action="DeleteVariant" asp-route-id="@v.Id" asp-route-productId="@Model.Id"
                                                   class="btn btn-sm btn-link text-danger p-1" onclick="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn biến thể này khỏi hệ thống?')" title="Xóa biến thể">
                                                    <i class="bi bi-trash-fill fs-5"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted small">
                                            <i class="bi bi-info-circle d-block fs-3 mb-2 text-secondary"></i>Sản phẩm này hiện tại chưa được tạo bất kỳ biến thể phân loại nào.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>