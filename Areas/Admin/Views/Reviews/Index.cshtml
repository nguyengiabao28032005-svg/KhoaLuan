@model IEnumerable<BeautyShop.Models.Review>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý đánh giá";
}

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title {
            color: #1e293b;
            font-weight: 700;
            margin: 0;
        }

        /* Table Styling */
        .table-card {
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .table-admin th {
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            padding: 15px 20px;
            border-bottom: 2px solid #e2e8f0;
        }

        .table-admin td {
            vertical-align: middle;
            padding: 15px 20px;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
        }

        .table-admin tr:last-child td {
            border-bottom: none;
        }

        /* Badges */
        .status-badge {
            padding: 6px 14px;
            border-radius: 50rem;
            font-weight: 600;
            font-size: 0.85rem;
            display: inline-block;
            text-align: center;
            min-width: 95px;
        }

        .badge-approved {
            background: #f0fdf4;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .badge-hidden {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #cbd5e1;
        }

        /* Stars & Action Buttons */
        .star-rating {
            color: #fbbf24; /* Vàng hổ phách */
            font-size: 1.1rem;
            letter-spacing: 2px;
        }

        .btn-action {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: var(--transition);
        }

            .btn-action:hover {
                transform: translateY(-2px);
            }
    </style>
}

<div class="page-header">
    <h2 class="page-title">
        <i class="bi bi-star-half me-2 text-primary"></i>Quản lý đánh giá
    </h2>
</div>

<div class="table-card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-admin mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Khách hàng</th>
                    <th>Sản phẩm</th>
                    <th>Số sao</th>
                    <th>Ngày đánh giá</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center pe-4" width="160">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                @(item.User?.FullName ?? "Ẩn danh")
                            </td>

                            <td class="fw-medium text-primary">
                                @(item.Product?.Name ?? "Sản phẩm không tồn tại")
                            </td>

                            <td>
                                <span class="star-rating">
                                    @for (int i = 0; i < item.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </span>
                                <span class="text-muted small ms-1">(@item.Rating/5)</span>
                            </td>

                            <td class="text-nowrap">
                                @item.CreatedAt.ToString("dd/MM/yyyy")
                            </td>

                            <td class="text-center">
                                @if (item.IsApproved)
                                {
                                    <span class="status-badge badge-approved">Đã duyệt</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-hidden">Đã ẩn</span>
                                }
                            </td>

                            <td class="text-center pe-4 text-nowrap">
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-info btn-action" title="Xem chi tiết đánh giá">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="ToggleApprove" asp-route-id="@item.Id" class="btn btn-outline-warning btn-action ms-1" title="@(item.IsApproved ? "Ẩn đánh giá này" : "Duyệt đánh giá này")">
                                    @if (item.IsApproved)
                                    {
                                        <i class="bi bi-eye-slash"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-eye"></i>
                                    }
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-chat-square-text fs-1 d-block mb-2 opacity-50"></i>
                            Chưa có phản hồi đánh giá nào được ghi nhận.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>