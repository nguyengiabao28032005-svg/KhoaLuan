@{
    ViewData["Title"] = "Lập Phiếu chuyển kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var stores = ViewBag.Stores as List<BeautyShop.Models.Store> ?? new();
    var categories = ViewBag.Categories as List<BeautyShop.Models.Category> ?? new();
    var brands = ViewBag.Brands as List<BeautyShop.Models.Brand> ?? new();
    string? batchCode = ViewBag.BatchCode as string;
    int? originStoreId = ViewBag.OriginStoreId as int?;
    int? targetStoreId = ViewBag.TargetStoreId as int?;
    int? orderId = ViewBag.OrderId as int?;
    string? orderCode = ViewBag.OrderCode as string;
    string? customerName = ViewBag.CustomerName as string;
    int? reqVariantId = ViewBag.RequestedVariantId as int?;
    string? reqVariantName = ViewBag.RequestedVariantName as string;
    string? reqVariantSKU = ViewBag.RequestedVariantSKU as string;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-800 mb-1" style="color:#1a1a2e;">
            <i class="bi bi-file-earmark-text-fill text-primary me-2"></i>@(string.IsNullOrEmpty(batchCode) ? "Lập Phiếu chuyển kho mới" : $"Tiếp tục luân chuyển Lô {batchCode}")
        </h2>
        <p class="text-muted mb-0">Chứng từ điều phối hàng hóa cụ thể giữa các chi nhánh theo Lộ trình vận chuyển quy chuẩn</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Routes" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 rounded-3 shadow-sm bg-white">
            <i class="bi bi-signpost-split-fill me-1"></i> Xem danh mục Lộ trình
        </a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 rounded-3 shadow-sm bg-white">
            <i class="bi bi-arrow-left me-1"></i> Bảng Phiếu chuyển kho
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (orderId.HasValue)
{
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="background:#eff6ff;border-left:5px solid #2563eb !important;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-receipt-cutoff text-primary fs-3"></i>
            <div>
                <span class="fw-bold text-dark">Nguồn tạo phiếu: Bổ sung hàng cho Đơn đặt hàng của khách</span>
                <strong class="text-primary font-monospace ms-1">#@orderCode</strong> (@customerName)
                <div class="small text-muted">Hệ thống đã tự động chọn Kho nhận là chi nhánh phụ trách đơn hàng và nạp sẵn danh sách mặt hàng khách đã đặt mua.</div>
            </div>
        </div>
    </div>
}

@if (reqVariantId.HasValue)
{
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="background:#fffbeb;border-left:5px solid #f59e0b !important;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-arrow-left-right text-warning fs-3"></i>
            <div>
                <span class="fw-bold text-dark">Kịch bản điều phối hàng thiếu:</span>
                <strong class="text-dark">@reqVariantName</strong> <code class="text-secondary">[@reqVariantSKU]</code>
                <div class="small text-muted">Chi nhánh nhận đang thiếu/hết hàng mặt hàng này. Hệ thống gợi ý chọn kho gửi từ các chi nhánh khác hiện đang còn tồn kho khả dụng.</div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(batchCode))
{
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="background:#eff6ff;border-left:5px solid #2563eb !important;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-info-circle-fill text-primary fs-4"></i>
            <div>
                <span class="fw-bold text-dark">Đang tạo chặng tiếp theo cho Lô hàng:</span>
                <strong class="text-primary font-monospace ms-1">@batchCode</strong>
                <div class="small text-muted">Lô hàng đã hoàn thành chặng trước và đang lưu tại Hub. Hệ thống sẽ tiếp tục chuyển đến kho đích cuối cùng.</div>
            </div>
        </div>
    </div>
}

<form method="post" asp-action="Create" id="transferForm">
    @if (!string.IsNullOrEmpty(batchCode))
    {
        <input type="hidden" name="batchCode" value="@batchCode" />
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN CHỨNG TỪ & ĐỊNH TUYẾN KHO -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-800 mb-3 text-dark border-bottom pb-2">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> 1. Thông tin Chứng từ &amp; Tuyến lộ trình
                </h5>

                <!-- 1.1 KHO GỬI -->
                <div class="mb-3">
                    <label class="form-label fw-700 small text-secondary">
                        Chi nhánh gửi hàng (Kho xuất) <span class="text-danger">*</span>
                    </label>
                    <select name="fromStoreId" id="selectFromStore" class="form-select py-2 shadow-sm" required onchange="onFromStoreChange()" @(!string.IsNullOrEmpty(batchCode) ? "readonly" : "")>
                        <option value="">-- Chọn kho xuất phát --</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.Id" selected="@(originStoreId == s.Id)">
                                [@(s.Region ?? "Toàn quốc")] @s.Name — @s.ProvinceName
                            </option>
                        }
                    </select>
                    <small class="text-muted d-block mt-1">Tồn kho tại kho gửi sẽ bị trừ ngay khi tạo phiếu.</small>
                </div>

                <!-- 1.2 KHO ĐÍCH CUỐI CÙNG -->
                <div class="mb-3">
                    <label class="form-label fw-700 small text-secondary">
                        Chi nhánh nhận hàng (Đích cuối) <span class="text-danger">*</span>
                    </label>
                    <select name="finalDestinationStoreId" id="selectFinalDest" class="form-select py-2 shadow-sm" required onchange="onFinalDestChange()">
                        <option value="">-- Chọn kho nhận hàng cuối cùng --</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.Id" selected="@(targetStoreId == s.Id)">
                                [@(s.Region ?? "Toàn quốc")] @s.Name — @s.ProvinceName
                            </option>
                        }
                    </select>
                    <div id="routeInfoBox" class="mt-2 p-3 rounded-3 small d-none" style="background:#f8fafc; border:1px dashed #cbd5e1;"></div>
                </div>

                <!-- 1.3 KHO TIẾP NHẬN CHẶNG HIỆN TẠI -->
                <div class="mb-3">
                    <label class="form-label fw-700 small text-secondary">
                        Kho tiếp nhận chặng này <span class="text-danger">*</span>
                    </label>
                    <select name="toStoreId" id="selectToStore" class="form-select py-2 shadow-sm bg-light" required>
                        <option value="">-- Tự động xác định theo tuyến lộ trình --</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.Id">[@(s.Region ?? "Toàn quốc")] @s.Name — @s.ProvinceName</option>
                        }
                    </select>
                    <small class="text-muted d-block mt-1 fst-italic">Hệ thống tự động chọn Hub Đà Nẵng nếu tuyến liên miền bắt buộc qua trạm gom hàng.</small>
                </div>

                <!-- GHI CHÚ -->
                <div class="mb-2">
                    <label class="form-label fw-700 small text-secondary">Ghi chú phiếu chuyển</label>
                    <textarea name="note" class="form-control shadow-sm" rows="2" placeholder="Ghi chú người vận chuyển, biển số xe, mục đích điều chuyển...">@(ViewBag.OrderNote as string)</textarea>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: CHỌN SẢN PHẨM & SỐ LƯỢNG CHUYỂN -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-2 mb-3 gap-2">
                    <h5 class="fw-800 mb-0 text-dark">
                        <i class="bi bi-box-seam-fill text-primary me-1"></i> 2. Mặt hàng luân chuyển
                    </h5>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-success fw-bold rounded-pill px-3 shadow-sm" onclick="openBulkModal()">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Chọn hàng loạt theo nhóm
                        </button>
                        <button type="button" id="btnAddRow" class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3" onclick="addRow()">
                            <i class="bi bi-plus-circle me-1"></i> Thêm từng món
                        </button>
                    </div>
                </div>

                <div id="stockAlert" class="alert alert-info py-2 small mb-3">
                    <i class="bi bi-info-circle me-1"></i> Vui lòng chọn <strong>Kho gửi hàng</strong> để hệ thống tải danh mục hàng hóa và tồn kho khả dụng.
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th class="small fw-bold">Sản phẩm &amp; Biến thể</th>
                                <th class="small fw-bold text-center" style="width:110px;">Tồn gửi</th>
                                <th class="small fw-bold text-center" style="width:120px;">SL Chuyển</th>
                                <th class="small fw-bold text-center" style="width:130px;">Tồn nhận sau nhận</th>
                                <th class="small fw-bold text-center" style="width:50px;">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="itemsTableBody">
                            <!-- Dòng hàng sẽ được thêm động bằng JS -->
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light fw-bold px-4 py-2 rounded-3">Hủy bỏ</a>
                    <button type="submit" id="btnSubmitTransfer" class="btn btn-primary fw-bold px-4 py-2 rounded-3 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Tạo Phiếu chuyển kho
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- MODAL CHỌN HÀNG LOẠT (BULK SELECTION MODAL) -->
<div class="modal fade" id="bulkSelectModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-800 text-dark">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Chọn nhanh mặt hàng luân chuyển hàng loạt
                    </h5>
                    <p class="text-muted small mb-0">Lọc theo Danh mục, Thương hiệu, hoặc Mặt hàng kho đích đang thiếu/hết hàng để đưa vào phiếu</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <!-- BỘ LỌC MODAL -->
                <div class="row g-2 mb-3 p-3 rounded-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Danh mục</label>
                        <select id="bulkCategory" class="form-select form-select-sm" onchange="loadBulkItems()">
                            <option value="">-- Tất cả danh mục --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Thương hiệu</label>
                        <select id="bulkBrand" class="form-select form-select-sm" onchange="loadBulkItems()">
                            <option value="">-- Tất cả thương hiệu --</option>
                            @foreach (var b in brands)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Tìm theo tên / SKU</label>
                        <input type="text" id="bulkKeyword" class="form-control form-control-sm" placeholder="Nhập tên sản phẩm..." oninput="debounceBulkSearch()" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="bulkOnlyShortage" onchange="loadBulkItems()" />
                            <label class="form-check-label small fw-bold text-danger" for="bulkOnlyShortage">
                                Chỉ lấy món kho nhận hết/thiếu
                            </label>
                        </div>
                    </div>
                </div>

                <!-- ĐIỀU KHIỂN HÀNG LOẠT -->
                <div class="d-flex flex-wrap align-items-center justify-content-between p-2 mb-2 rounded bg-light border gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small fw-bold text-dark">Đặt SL chuyển cho các món chọn:</span>
                        <input type="number" id="bulkDefaultQty" class="form-control form-control-sm text-center fw-bold" style="width:80px;" value="10" min="1" />
                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="applyDefaultQtyToChecked()">
                            Áp dụng
                        </button>
                    </div>
                    <div class="small text-muted fw-bold">
                        Đã chọn: <span id="bulkCheckedCount" class="text-primary fs-6">0</span> mặt hàng
                    </div>
                </div>

                <!-- BẢNG KẾT QUẢ TRONG MODAL -->
                <div class="table-responsive" style="max-height:360px;">
                    <table class="table table-hover align-middle mb-0" id="bulkItemsTable">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="text-center" style="width:40px;">
                                    <input type="checkbox" id="bulkSelectAll" onchange="toggleSelectAllBulk(this)" />
                                </th>
                                <th class="small fw-bold">Sản phẩm &amp; SKU</th>
                                <th class="small fw-bold">Danh mục / Hãng</th>
                                <th class="small fw-bold text-center" style="width:100px;">Tồn kho gửi</th>
                                <th class="small fw-bold text-center" style="width:140px;">Tình trạng kho nhận</th>
                                <th class="small fw-bold text-center" style="width:120px;">SL chuyển</th>
                            </tr>
                        </thead>
                        <tbody id="bulkTableBody">
                            <tr><td colspan="6" class="text-center py-4 text-muted">Vui lòng mở kho gửi và bấm tải hàng.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success fw-bold px-4" onclick="addBulkItemsToForm()">
                    <i class="bi bi-check2-all me-1"></i> Thêm vào Phiếu chuyển kho
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let availableVariants = [];
    let currentDestinations = [];
    let currentStoreRequestId = 0;
    let bulkLoadedItems = [];
    let searchDebounceTimeout = null;

    const presetOrderItems = @Html.Raw(ViewBag.PresetOrderItems != null ? System.Text.Json.JsonSerializer.Serialize(ViewBag.PresetOrderItems) : "null");
    const requestedVariantId = @(reqVariantId.HasValue ? reqVariantId.Value.ToString() : "null");

    document.addEventListener('DOMContentLoaded', function () {
        const fromSelect = document.getElementById('selectFromStore');
        if (fromSelect.value) {
            onFromStoreChange();
        }
    });

    async function onFromStoreChange() {
        const fromStoreId = document.getElementById('selectFromStore').value;
        const finalSelect = document.getElementById('selectFinalDest');
        const routeInfoBox = document.getElementById('routeInfoBox');
        const stockAlert = document.getElementById('stockAlert');
        const toStoreSelect = document.getElementById('selectToStore');
        const tbody = document.getElementById('itemsTableBody');
        const addBtn = document.getElementById('btnAddRow');
        const submitBtn = document.getElementById('btnSubmitTransfer');

        const requestId = ++currentStoreRequestId;
        tbody.innerHTML = '';

        if (!fromStoreId) {
            finalSelect.innerHTML = '<option value="">-- Chọn kho nhận hàng cuối cùng --</option>';
            toStoreSelect.innerHTML = '<option value="">-- Tự động xác định theo tuyến --</option>';
            routeInfoBox.classList.add('d-none');
            stockAlert.className = 'alert alert-info py-2 small mb-3';
            stockAlert.innerHTML = '<i class="bi bi-info-circle me-1"></i> Vui lòng chọn <strong>Kho gửi hàng</strong> để tải tồn kho.';
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Vui lòng chọn kho xuất phát để tải danh sách hàng.</td></tr>';
            if (addBtn) addBtn.disabled = true;
            if (submitBtn) submitBtn.disabled = true;
            return;
        }

        stockAlert.className = 'alert alert-info py-2 small mb-3';
        stockAlert.innerHTML = '<div class="spinner-border spinner-border-sm text-primary me-2"></div> Đang kiểm tra tuyến lộ trình và tồn kho khả dụng...';
        if (addBtn) addBtn.disabled = true;
        if (submitBtn) submitBtn.disabled = true;

        try {
            const [resRoutes, resStock] = await Promise.all([
                fetch(`/Admin/Transfers/GetDestinations?fromStoreId=${fromStoreId}&_t=${Date.now()}`),
                fetch(`/Admin/Transfers/GetStoreStock?storeId=${fromStoreId}&_t=${Date.now()}`)
            ]);

            if (requestId !== currentStoreRequestId) return;

            currentDestinations = await resRoutes.json();
            availableVariants = await resStock.json();

            const savedFinalVal = finalSelect.value;
            finalSelect.innerHTML = '<option value="">-- Chọn kho nhận hàng cuối cùng --</option>';

            currentDestinations.forEach(d => {
                const opt = document.createElement('option');
                opt.value = d.storeId;
                opt.textContent = `[${d.region || 'Toàn quốc'}] ${d.storeName} — ${d.provinceName || ''}`;
                if (d.transitStoreId) {
                    opt.textContent += ` (Qua Hub ${d.transitStoreName})`;
                } else {
                    opt.textContent += ' (Trực tiếp)';
                }
                finalSelect.appendChild(opt);
            });

            if (savedFinalVal && currentDestinations.some(d => d.storeId == savedFinalVal)) {
                finalSelect.value = savedFinalVal;
            }

            onFinalDestChange();

            if (Array.isArray(availableVariants) && availableVariants.length > 0) {
                stockAlert.className = 'alert alert-success py-2 small mb-3';
                stockAlert.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> Kho gửi có <strong>${availableVariants.length}</strong> mặt hàng có sẵn tồn kho khả dụng để chuyển.`;
                if (addBtn) addBtn.disabled = false;
                if (submitBtn) submitBtn.disabled = false;

                // Nếu có preset items từ Đơn đặt hàng
                if (presetOrderItems && presetOrderItems.length > 0) {
                    presetOrderItems.forEach(item => {
                        addRow(item.variantId, item.quantity);
                    });
                } else if (requestedVariantId) {
                    // Nếu có yêu cầu điều chuyển mặt hàng cụ thể
                    addRow(requestedVariantId, 10);
                } else {
                    addRow();
                }
            } else {
                stockAlert.className = 'alert alert-warning py-2 small mb-3';
                stockAlert.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Kho này hiện không có sản phẩm nào có sẵn tồn kho khả dụng để chuyển!';
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted"><i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>Kho này hiện không có sản phẩm nào có tồn kho để luân chuyển.<br/><small class="text-muted">Vui lòng chọn kho gửi khác hoặc tạo phiếu nhập hàng trước.</small></td></tr>`;
                if (addBtn) addBtn.disabled = true;
                if (submitBtn) submitBtn.disabled = true;
            }
        } catch (e) {
            if (requestId !== currentStoreRequestId) return;
            console.error('Lỗi tải dữ liệu kho:', e);
            stockAlert.className = 'alert alert-danger py-2 small mb-3';
            stockAlert.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Lỗi khi tải dữ liệu từ máy chủ. Vui lòng thử lại.';
        }
    }

    function onFinalDestChange() {
        const fromStoreId = document.getElementById('selectFromStore').value;
        const finalDestId = document.getElementById('selectFinalDest').value;
        const routeInfoBox = document.getElementById('routeInfoBox');
        const toStoreSelect = document.getElementById('selectToStore');
        const submitBtn = document.getElementById('btnSubmitTransfer');

        if (!fromStoreId || !finalDestId) {
            routeInfoBox.classList.add('d-none');
            return;
        }

        const matchedRoute = currentDestinations.find(d => d.storeId == finalDestId);

        if (!matchedRoute) {
            routeInfoBox.className = 'mt-2 p-3 rounded-3 small bg-danger-subtle text-danger';
            routeInfoBox.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> <strong>Không có tuyến:</strong> Hiện chưa có tuyến vận chuyển hợp lệ giữa 2 kho này!';
            routeInfoBox.classList.remove('d-none');
            submitBtn.disabled = true;
            return;
        }

        submitBtn.disabled = false;
        routeInfoBox.classList.remove('d-none');

        if (matchedRoute.transitStoreId) {
            routeInfoBox.className = 'mt-2 p-3 rounded-3 small bg-warning-subtle text-dark border border-warning-subtle';
            routeInfoBox.innerHTML = `
                <div class="fw-bold text-dark"><i class="bi bi-diagram-3-fill text-warning me-1"></i> Tuyến gom hàng liên miền (bắt buộc qua Hub):</div>
                <div class="mt-1">Lộ trình: <strong>${document.getElementById('selectFromStore').selectedOptions[0].text}</strong> ➔ <span class="badge bg-warning text-dark">Hub ${matchedRoute.transitStoreName}</span> ➔ <strong>${matchedRoute.storeName}</strong></div>
                <div class="mt-1 text-muted">Chặng 1 bắt buộc chuyển đến Hub trung chuyển để gom tải tối ưu chi phí vận chuyển.</div>
            `;
            toStoreSelect.value = matchedRoute.transitStoreId;
        } else {
            routeInfoBox.className = 'mt-2 p-3 rounded-3 small bg-success-subtle text-dark border border-success-subtle';
            routeInfoBox.innerHTML = `
                <div class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Tuyến vận chuyển trực tiếp:</div>
                <div class="mt-1">${matchedRoute.routeDescription || 'Vận chuyển thẳng không qua trạm trung chuyển.'} (Ước tính: ${matchedRoute.distanceKm || '—'} km, ${matchedRoute.estimatedHours || '—'} giờ)</div>
            `;
            toStoreSelect.value = matchedRoute.storeId;
        }
    }

    function addRow(presetVariantId = null, presetQty = 1) {
        const tbody = document.getElementById('itemsTableBody');
        const tr = document.createElement('tr');

        let selectOptions = '<option value="">-- Chọn sản phẩm --</option>';
        availableVariants.forEach(v => {
            const detail = (v.color ? ` - ${v.color}` : '') + (v.volume ? ` (${v.volume})` : '');
            const selected = (presetVariantId && presetVariantId == v.variantId) ? 'selected' : '';
            selectOptions += `<option value="${v.variantId}" data-stock="${v.availableStock}" ${selected}>${v.productName} [${v.sku}]${detail} (Còn: ${v.availableStock})</option>`;
        });

        tr.innerHTML = `
            <td>
                <select name="variantIds" class="form-select py-1 variant-selector" required onchange="onVariantChange(this)">
                    ${selectOptions}
                </select>
            </td>
            <td class="text-center fw-bold text-secondary variant-stock-display">—</td>
            <td>
                <input type="number" name="quantities" class="form-control py-1 text-center fw-bold text-primary variant-qty-input" min="1" value="${presetQty}" required oninput="validateQty(this)" />
                <div class="text-danger small qty-error-msg d-none">Vượt tồn!</div>
            </td>
            <td class="text-center small variant-target-stock-display text-muted">
                <span class="badge bg-light text-secondary border">+${presetQty} khi nhận</span>
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeRow(this)">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

        tbody.appendChild(tr);

        const sel = tr.querySelector('.variant-selector');
        if (sel.value) {
            onVariantChange(sel);
        }
    }

    function removeRow(btn) {
        const tr = btn.closest('tr');
        const tbody = document.getElementById('itemsTableBody');
        if (tbody.children.length > 1) {
            tr.remove();
        } else {
            alert('Cần có ít nhất một sản phẩm cần chuyển!');
        }
    }

    function clearAllRows() {
        const tbody = document.getElementById('itemsTableBody');
        tbody.innerHTML = '';
        addRow();
    }

    function onVariantChange(select) {
        const tr = select.closest('tr');
        const stockDisplay = tr.querySelector('.variant-stock-display');
        const qtyInput = tr.querySelector('.variant-qty-input');
        const targetDisplay = tr.querySelector('.variant-target-stock-display');
        const selectedOpt = select.selectedOptions[0];

        if (selectedOpt && selectedOpt.value) {
            const stock = parseInt(selectedOpt.getAttribute('data-stock') || '0');
            stockDisplay.textContent = stock;
            qtyInput.max = stock;
            validateQty(qtyInput);
            if (targetDisplay) {
                targetDisplay.innerHTML = `<span class="badge bg-light text-success border">+${qtyInput.value} sau nhận</span>`;
            }
        } else {
            stockDisplay.textContent = '—';
            if (targetDisplay) targetDisplay.textContent = '—';
        }
    }

    function validateQty(input) {
        const tr = input.closest('tr');
        const stockDisplay = tr.querySelector('.variant-stock-display');
        const errorMsg = tr.querySelector('.qty-error-msg');
        const targetDisplay = tr.querySelector('.variant-target-stock-display');
        const maxStock = parseInt(stockDisplay.textContent || '0');
        const currentQty = parseInt(input.value || '0');

        if (maxStock > 0 && currentQty > maxStock) {
            errorMsg.classList.remove('d-none');
            input.classList.add('is-invalid');
            document.getElementById('btnSubmitTransfer').disabled = true;
        } else {
            errorMsg.classList.add('d-none');
            input.classList.remove('is-invalid');
            document.getElementById('btnSubmitTransfer').disabled = false;
        }

        if (targetDisplay && currentQty > 0) {
            targetDisplay.innerHTML = `<span class="badge bg-light text-success border">+${currentQty} sau nhận</span>`;
        }
    }

    // =========================================================================
    // MODAL CHỌN HÀNG LOẠT (BULK SELECTION MODAL)
    // =========================================================================
    function openBulkModal() {
        const fromStoreId = document.getElementById('selectFromStore').value;
        if (!fromStoreId) {
            alert('Vui lòng chọn Kho gửi hàng trước!');
            document.getElementById('selectFromStore').focus();
            return;
        }
        const modal = new bootstrap.Modal(document.getElementById('bulkSelectModal'));
        modal.show();
        loadBulkItems();
    }

    function debounceBulkSearch() {
        clearTimeout(searchDebounceTimeout);
        searchDebounceTimeout = setTimeout(loadBulkItems, 300);
    }

    async function loadBulkItems() {
        const fromStoreId = document.getElementById('selectFromStore').value;
        const targetStoreId = document.getElementById('selectFinalDest').value;
        const categoryId = document.getElementById('bulkCategory').value;
        const brandId = document.getElementById('bulkBrand').value;
        const keyword = document.getElementById('bulkKeyword').value;
        const onlyShortage = document.getElementById('bulkOnlyShortage').checked;
        const tbody = document.getElementById('bulkTableBody');

        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Đang tải danh sách hàng...</td></tr>';

        try {
            const url = `/Admin/Transfers/GetBulkStockItems?fromStoreId=${fromStoreId}&targetStoreId=${targetStoreId || ''}&categoryId=${categoryId || ''}&brandId=${brandId || ''}&keyword=${encodeURIComponent(keyword || '')}&onlyReceiverShortage=${onlyShortage}&_t=${Date.now()}`;
            const res = await fetch(url);
            bulkLoadedItems = await res.json();

            if (!bulkLoadedItems || bulkLoadedItems.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Không tìm thấy mặt hàng nào phù hợp với bộ lọc.</td></tr>';
                document.getElementById('bulkCheckedCount').textContent = '0';
                return;
            }

            const defQty = parseInt(document.getElementById('bulkDefaultQty').value || '10');
            tbody.innerHTML = '';

            bulkLoadedItems.forEach((item, idx) => {
                const tr = document.createElement('tr');
                const defaultTransferQty = Math.min(defQty, item.availableStock);
                
                let targetBadge = '<span class="badge bg-light text-secondary border">Chưa có tại kho</span>';
                if (item.targetStatus.includes('Hết')) {
                    targetBadge = '<span class="badge bg-danger-subtle text-danger fw-bold">🔴 Hết hàng</span>';
                } else if (item.targetStatus.includes('Còn')) {
                    targetBadge = `<span class="badge bg-success-subtle text-success fw-bold">${item.targetStatus}</span>`;
                }

                tr.innerHTML = `
                    <td class="text-center">
                        <input type="checkbox" class="bulk-check-item" data-idx="${idx}" onchange="updateBulkCheckedCount()" />
                    </td>
                    <td>
                        <div class="fw-bold text-dark">${item.productName}</div>
                        <small class="text-muted"><code>${item.sku}</code> ${item.color ? '| ' + item.color : ''} ${item.volume ? '| ' + item.volume : ''}</small>
                    </td>
                    <td>
                        <span class="badge bg-light text-dark border">${item.categoryName}</span>
                        <small class="text-muted d-block">${item.brandName}</small>
                    </td>
                    <td class="text-center fw-bold text-primary fs-6">${item.availableStock}</td>
                    <td class="text-center">${targetBadge}</td>
                    <td class="text-center">
                        <input type="number" class="form-control form-control-sm text-center fw-bold bulk-qty-input" 
                               value="${defaultTransferQty}" min="1" max="${item.availableStock}" style="width:90px; margin:auto;" />
                    </td>
                `;
                tbody.appendChild(tr);
            });

            updateBulkCheckedCount();
        } catch (e) {
            console.error('Lỗi tải bulk items:', e);
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Lỗi khi tải dữ liệu. Vui lòng thử lại.</td></tr>';
        }
    }

    function toggleSelectAllBulk(headerCheck) {
        document.querySelectorAll('.bulk-check-item').forEach(chk => {
            chk.checked = headerCheck.checked;
        });
        updateBulkCheckedCount();
    }

    function updateBulkCheckedCount() {
        const checked = document.querySelectorAll('.bulk-check-item:checked');
        document.getElementById('bulkCheckedCount').textContent = checked.length;
    }

    function applyDefaultQtyToChecked() {
        const defQty = parseInt(document.getElementById('bulkDefaultQty').value || '10');
        document.querySelectorAll('.bulk-check-item:checked').forEach(chk => {
            const tr = chk.closest('tr');
            const qtyInput = tr.querySelector('.bulk-qty-input');
            const max = parseInt(qtyInput.max || '9999');
            qtyInput.value = Math.min(defQty, max);
        });
    }

    function addBulkItemsToForm() {
        const checkedBoxes = document.querySelectorAll('.bulk-check-item:checked');
        if (checkedBoxes.length === 0) {
            alert('Vui lòng tích chọn ít nhất một mặt hàng!');
            return;
        }

        const tbody = document.getElementById('itemsTableBody');
        // Nếu dòng đầu tiên đang trống/chưa chọn sản phẩm, xóa nó
        if (tbody.children.length === 1) {
            const firstSelect = tbody.querySelector('.variant-selector');
            if (firstSelect && !firstSelect.value) {
                tbody.innerHTML = '';
            }
        }

        let addedCount = 0;
        checkedBoxes.forEach(chk => {
            const idx = parseInt(chk.getAttribute('data-idx'));
            const item = bulkLoadedItems[idx];
            const tr = chk.closest('tr');
            const qty = parseInt(tr.querySelector('.bulk-qty-input').value || '1');

            if (item) {
                addRow(item.variantId, qty);
                addedCount++;
            }
        });

        bootstrap.Modal.getInstance(document.getElementById('bulkSelectModal')).hide();
        alert(`Đã thêm ${addedCount} mặt hàng vào Phiếu chuyển kho!`);
    }
</script>
}
