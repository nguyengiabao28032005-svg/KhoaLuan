@model List<BeautyShop.Models.AuditLog>
@{
    ViewData["Title"] = "Nhật ký thay đổi Phân quyền (Audit Log)";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Nhật ký Thay đổi Vai trò &amp; Phạm vi Kho (Audit Log)</h4>
        <p class="text-muted small mb-0">Ghi nhận đầy đủ: Ai thực hiện, thời điểm nào, đổi vai trò/quyền hay phạm vi kho của ai, giá trị cũ và mới.</p>
    </div>
    <a href="/Admin/RoleManagement/Matrix" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại Ma trận Phân quyền
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Thời gian</th>
                        <th>Người thực hiện</th>
                        <th>Hành động</th>
                        <th>Tài khoản đích</th>
                        <th>Giá trị cũ</th>
                        <th>Giá trị mới</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có bản ghi nhật ký phân quyền nào.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td class="small text-nowrap">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@(log.PerformedByUser?.FullName ?? $"Admin #{log.PerformedByUserId}")</td>
                                <td><span class="badge bg-info-subtle text-dark border">@log.Action</span></td>
                                <td>@(log.TargetUser?.FullName ?? (log.TargetUserId.HasValue ? $"User #{log.TargetUserId}" : "—"))</td>
                                <td class="small text-muted"><code>@(log.OldValue ?? "—")</code></td>
                                <td class="small text-success"><code>@(log.NewValue ?? "—")</code></td>
                                <td class="small">@log.Note</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
