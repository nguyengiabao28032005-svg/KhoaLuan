@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Doanh thu & Thống kê Thời gian thật";
}

@section Styles {
    <style>
        /* ===== LIVE BADGE & PULSE ANIMATION ===== */
        .live-badge {
            background: rgba(34, 197, 94, 0.15);
            color: #15803d;
            border: 1px solid rgba(34, 197, 94, 0.3);
            border-radius: 30px;
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .pulse-dot {
            width: 10px;
            height: 10px;
            background-color: #22c55e;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
            animation: pulse-green 1.8s infinite;
        }

        @@keyframes pulse-green {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 10px rgba(34, 197, 94, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
            }
        }

        /* ===== STAT CARDS ===== */
        .stat-card {
            background: #fff;
            border-radius: 16px;
            border: 1.5px solid #edf2f7;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            padding: 22px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            border-radius: 16px 0 0 16px;
        }

        .stat-card.green::before { background: linear-gradient(180deg,#22c55e,#16a34a); }
        .stat-card.blue::before { background: linear-gradient(180deg,#0ea5e9,#2563eb); }
        .stat-card.orange::before { background: linear-gradient(180deg,#f59e0b,#ea580c); }
        .stat-card.purple::before { background: linear-gradient(180deg,#a855f7,#7e22ce); }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.09);
        }

        .stat-info h6 {
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
        }

        .stat-info h2 {
            color: #0f172a;
            font-size: 1.8rem;
            font-weight: 900;
            margin: 0;
            line-height: 1.1;
        }

        .stat-info .stat-sub {
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            margin-top: 6px;
        }

        .stat-icon {
            width: 54px;
            height: 54px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            flex-shrink: 0;
        }

        .icon-green { background: #f0fdf4; color: #16a34a; }
        .icon-blue { background: #eff6ff; color: #2563eb; }
        .icon-orange { background: #fff7ed; color: #ea580c; }
        .icon-purple { background: #faf5ff; color: #9333ea; }

        /* ===== FILTER BUTTONS ===== */
        .btn-time-filter {
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            padding: 8px 16px;
            border: 1.5px solid #e2e8f0;
            background: #fff;
            color: #475569;
            transition: all 0.2s;
        }

        .btn-time-filter:hover, .btn-time-filter.active {
            background: #006E4A;
            color: #fff;
            border-color: #006E4A;
            box-shadow: 0 4px 12px rgba(0,110,74,0.25);
        }

        /* ===== CHART CONTAINERS ===== */
        .chart-card {
            background: #fff;
            border-radius: 16px;
            border: 1.5px solid #edf2f7;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            padding: 24px;
            margin-bottom: 24px;
        }

        .chart-title {
            font-size: 1rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
    </style>
}

<div class="container-fluid p-0">

    <!-- ===== HEADER THỜI GIAN THẬT ===== -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 style="font-size:1.6rem;font-weight:900;color:#0f172a;margin:0;">
                <i class="bi bi-graph-up-arrow text-success me-2"></i>Quản Lý Doanh Thu Thời Gian Thật
            </h4>
            <p class="text-muted fw-600 mb-0" style="font-size:13px;">Theo dõi doanh thu, đơn hàng và hiệu suất bán hàng liên tục</p>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="live-badge">
                <span class="pulse-dot"></span>
                <span>REAL-TIME LIVE</span>
                <span class="text-muted ms-1" id="live-clock" style="font-size:12px;">--:--:--</span>
            </div>

            <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                <input class="form-check-input" type="checkbox" id="toggleAutoRefresh" checked style="cursor:pointer;width:2.2em;height:1.2em;">
                <label class="form-check-label fw-700 text-dark small" for="toggleAutoRefresh">Auto 10s</label>
            </div>

            <button onclick="fetchRealtimeData()" class="btn btn-sm btn-light border rounded-3 fw-700 shadow-sm px-3">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
            </button>
        </div>
    </div>

    <!-- ===== THẺ KPI DOANH THU & ĐƠN HÀNG (REALTIME) ===== -->
    <div class="row g-3 mb-4">
        <!-- Doanh thu hôm nay -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card green">
                <div class="stat-info">
                    <h6>Doanh thu hôm nay</h6>
                    <h2 id="kpi-today-revenue">@(((decimal)ViewBag.TodayRevenue).ToString("N0"))đ</h2>
                    <div class="stat-sub">
                        <i class="bi bi-bag-check-fill text-success me-1"></i><span id="kpi-today-orders">@ViewBag.TodayOrders</span> đơn hôm nay
                    </div>
                </div>
                <div class="stat-icon icon-green">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>

        <!-- Doanh thu tháng này -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card blue">
                <div class="stat-info">
                    <h6>Doanh thu tháng này</h6>
                    <h2 id="kpi-month-revenue">@(((decimal)ViewBag.RevenueThisMonth).ToString("N0"))đ</h2>
                    <div class="stat-sub">
                        <i class="bi bi-calendar-event me-1"></i>Tháng @DateTime.Now.Month/@DateTime.Now.Year
                    </div>
                </div>
                <div class="stat-icon icon-blue">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
        </div>

        <!-- Đơn hàng chờ xử lý -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card orange">
                <div class="stat-info">
                    <h6>Đơn hàng chờ duyệt</h6>
                    <h2 id="kpi-pending-orders" class="@((int)ViewBag.PendingOrdersCount > 0 ? "text-danger" : "")">@ViewBag.PendingOrdersCount</h2>
                    <div class="stat-sub">
                        <a asp-controller="Orders" asp-action="Index" class="text-decoration-none text-warning fw-800">
                            Cần xử lý ngay <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="stat-icon icon-orange">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>

        <!-- Tổng doanh thu tích lũy -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card purple">
                <div class="stat-info">
                    <h6>Tổng doanh thu tích lũy</h6>
                    <h2 id="kpi-total-revenue">@(((decimal)ViewBag.TotalRevenue).ToString("N0"))đ</h2>
                    <div class="stat-sub">
                        <i class="bi bi-shield-check me-1"></i>Toàn bộ đơn hợp lệ
                    </div>
                </div>
                <div class="stat-icon icon-purple">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card purple">
                <div class="stat-info">
                    <h6>Tổng số lượng đơn hàng</h6>
                    <h2 id="kpi-total-revenue">@(((decimal)ViewBag.TotalOrders).ToString("N0"))đ</h2>
                    <div class="stat-sub">
                        <i class="bi bi-shield-check me-1"></i>Toàn bộ đơn hợp lệ
                    </div>
                </div>
                <div class="stat-icon icon-purple">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== BỘ LỌC THỜI GIAN BIỂU ĐỒ ===== -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 style="background:#fff;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-800 text-dark small me-2"><i class="bi bi-funnel-fill text-success me-1"></i>Bộ lọc thời gian:</span>
                <button class="btn btn-time-filter active" onclick="setFilterRange('7days', this)">7 Ngày Qua</button>
                <button class="btn btn-time-filter" onclick="setFilterRange('today', this)">Hôm Nay (24h)</button>
                <button class="btn btn-time-filter" onclick="setFilterRange('30days', this)">30 Ngày Qua</button>
            </div>

            <!-- Custom date range -->
            <div class="d-flex align-items-center gap-2">
                <input type="date" id="customFromDate" class="form-control form-control-sm rounded-3 fw-600" style="width:140px;">
                <span class="text-muted fw-700">-</span>
                <input type="date" id="customToDate" class="form-control form-control-sm rounded-3 fw-600" style="width:140px;">
                <button class="btn btn-sm btn-success rounded-3 fw-700 px-3" onclick="applyCustomDateRange()">Lọc</button>
            </div>
        </div>
    </div>

    <!-- ===== BIỂU ĐỒ DOANH THU & ĐƠN HÀNG ===== -->
    <div class="row">
        <!-- Biểu đồ doanh thu chính -->
        <div class="col-lg-8">
            <div class="chart-card">
                <div class="chart-title">
                    <span><i class="bi bi-bar-chart-line-fill text-success me-2"></i>Biểu đồ Doanh Thu Theo Thời Gian</span>
                    <span class="badge bg-success-subtle text-success fw-800" id="chart-range-label">7 ngày gần nhất</span>
                </div>
                <div style="height:340px;position:relative;">
                    <canvas id="revenueMainChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ phân bổ trạng thái đơn hàng -->
        <div class="col-lg-4">
            <div class="chart-card">
                <div class="chart-title">
                    <span><i class="bi bi-pie-chart-fill text-primary me-2"></i>Trạng Thái Đơn Hàng</span>
                </div>
                <div style="height:340px;position:relative;display:flex;align-items:center;justify-content:center;">
                    <canvas id="orderStatusDoughnutChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== TOP SẢN PHẨM & ĐƠN HÀNG MỚI ===== -->
    <div class="row">
        <!-- Top 5 sản phẩm doanh thu cao nhất -->
        <div class="col-lg-6 mb-4">
            <div class="chart-card h-100">
                <div class="chart-title">
                    <span><i class="bi bi-trophy-fill text-warning me-2"></i>Top 5 Sản Phẩm Mang Lại Doanh Thu Cao Nhất</span>
                </div>
                <div style="height:300px;position:relative;">
                    <canvas id="topProductsBarChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Dòng chảy đơn hàng vừa tạo (Realtime Feed) -->
        <div class="col-lg-6 mb-4">
            <div class="chart-card h-100">
                <div class="chart-title">
                    <span><i class="bi bi-bell-fill text-danger me-2"></i>Đơn Hàng Vừa Phát Sinh (Real-time Stream)</span>
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-light border rounded-3 fw-700">Xem tất cả</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Thời gian</th>
                            </tr>
                        </thead>
                        <tbody id="latest-orders-tbody">
                            @if (ViewBag.LatestOrders != null)
                            {
                                foreach (var ord in (List<BeautyShop.Models.Order>)ViewBag.LatestOrders)
                                {
                                    <tr>
                                        <td class="fw-800 text-success">#@ord.OrderCode</td>
                                        <td class="fw-700">@ord.CustomerName</td>
                                        <td class="fw-800 text-dark">@ord.FinalAmount.ToString("N0")đ</td>
                                        <td>
                                            <span class="badge @(ord.OrderStatus == "Completed" ? "bg-success" : (ord.OrderStatus == "Cancelled" ? "bg-danger" : "bg-warning")) fw-700">
                                                @ord.OrderStatus
                                            </span>
                                        </td>
                                        <td class="text-muted fw-600">@ord.CreatedAt.ToString("HH:mm dd/MM")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Data ban đầu từ Controller
        let currentRange = '7days';
        let mainChart, doughnutChart, topBarChart;
        let autoRefreshTimer = null;

        const initialLabels = @Html.Raw(ViewBag.ChartLabels ?? "[]");
        const initialRevenues = @Html.Raw(ViewBag.ChartRevenues ?? "[]");
        const initialOrders = @Html.Raw(ViewBag.ChartOrders ?? "[]");

        const statusLabels = @Html.Raw(ViewBag.StatusLabels ?? "[]");
        const statusCounts = @Html.Raw(ViewBag.StatusCounts ?? "[]");

        const topProductNames = @Html.Raw(ViewBag.TopProductNames ?? "[]");
        const topProductRevenues = @Html.Raw(ViewBag.TopProductRevenues ?? "[]");

        // KHỞI TẠO ĐỒNG HỒ REAL-TIME
        function updateClock() {
            const now = new Date();
            document.getElementById('live-clock').innerText = now.toLocaleTimeString('vi-VN');
        }
        setInterval(updateClock, 1000);
        updateClock();

        // KHỞI TẠO BIỂU ĐỒ DOANH THU CHÍNH
        function initMainChart(labels, revenues) {
            const ctx = document.getElementById('revenueMainChart').getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(0, 110, 74, 0.35)');
            gradient.addColorStop(1, 'rgba(0, 110, 74, 0.0)');

            mainChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: revenues,
                        borderColor: '#006E4A',
                        borderWidth: 3,
                        backgroundColor: gradient,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#009665',
                        pointRadius: 5,
                        pointHoverRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN').format(context.parsed.y) + 'đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1000000) return (value / 1000000) + 'M';
                                    if (value >= 1000) return (value / 1000) + 'k';
                                    return value;
                                }
                            }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        // KHỞI TẠO BIỂU ĐỒ TRẠNG THÁI
        function initDoughnutChart(labels, data) {
            const ctx = document.getElementById('orderStatusDoughnutChart').getContext('2d');
            doughnutChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: ['#eab308', '#3b82f6', '#22c55e', '#ef4444', '#a855f7'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        // KHỞI TẠO BIỂU ĐỒ TOP SẢN PHẨM
        function initTopBarChart(names, revenues) {
            const ctx = document.getElementById('topProductsBarChart').getContext('2d');
            topBarChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: names,
                    datasets: [{
                        label: 'Doanh thu',
                        data: revenues,
                        backgroundColor: 'rgba(245, 158, 11, 0.85)',
                        borderRadius: 8
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN').format(context.parsed.x) + 'đ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                        y: { grid: { display: false } }
                    }
                }
            });
        }

        // GỌI API FETCH DỮ LIỆU REAL-TIME
        function fetchRealtimeData(customFrom = null, customTo = null) {
            let url = `/Admin/Dashboard/GetRealtimeData?range=${currentRange}`;
            if (customFrom && customTo) {
                url += `&fromDate=${customFrom}&toDate=${customTo}`;
            }

            fetch(url)
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        // Cập nhật KPIs
                        document.getElementById('kpi-today-revenue').innerText = data.todayRevenue;
                        document.getElementById('kpi-today-orders').innerText = data.todayOrders;
                        document.getElementById('kpi-month-revenue').innerText = data.monthRevenue;
                        document.getElementById('kpi-total-revenue').innerText = data.totalRevenue;

                        const pendingEl = document.getElementById('kpi-pending-orders');
                        pendingEl.innerText = data.pendingOrdersCount;
                        if (data.pendingOrdersCount > 0) pendingEl.className = 'text-danger';
                        else pendingEl.className = '';

                        // Cập nhật biểu đồ chính
                        if (mainChart) {
                            mainChart.data.labels = data.labels;
                            mainChart.data.datasets[0].data = data.revenues;
                            mainChart.update();
                        }

                        // Cập nhật danh sách đơn hàng vừa tạo
                        if (data.latestOrders) {
                            let tbodyHtml = '';
                            data.latestOrders.forEach(ord => {
                                let badgeClass = ord.orderStatus === 'Completed' ? 'bg-success' : (ord.orderStatus === 'Cancelled' ? 'bg-danger' : 'bg-warning');
                                tbodyHtml += `
                                    <tr>
                                        <td class="fw-800 text-success">#${ord.orderCode}</td>
                                        <td class="fw-700">${ord.customerName}</td>
                                        <td class="fw-800 text-dark">${ord.finalAmount}</td>
                                        <td><span class="badge ${badgeClass} fw-700">${ord.orderStatus}</span></td>
                                        <td class="text-muted fw-600">${ord.createdAt}</td>
                                    </tr>
                                `;
                            });
                            document.getElementById('latest-orders-tbody').innerHTML = tbodyHtml;
                        }
                    }
                })
                .catch(err => console.error("Lỗi fetch realtime:", err));
        }

        // BỘ LỌC THỜI GIAN LINH HOẠT
        function setFilterRange(range, btn) {
            currentRange = range;
            document.querySelectorAll('.btn-time-filter').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const labelsMap = { 'today': 'Hôm nay (24h)', '7days': '7 ngày gần nhất', '30days': '30 ngày qua' };
            document.getElementById('chart-range-label').innerText = labelsMap[range] || range;

            fetchRealtimeData();
        }

        function applyCustomDateRange() {
            const fromD = document.getElementById('customFromDate').value;
            const toD = document.getElementById('customToDate').value;
            if (!fromD || !toD) {
                alert("Vui lòng chọn đầy đủ Từ ngày và Đến ngày!");
                return;
            }
            currentRange = 'custom';
            document.querySelectorAll('.btn-time-filter').forEach(b => b.classList.remove('active'));
            document.getElementById('chart-range-label').innerText = `${fromD} đến ${toD}`;
            fetchRealtimeData(fromD, toD);
        }

        // AUTO-REFRESH 10 GIÂY/LẦN
        function setupAutoRefresh() {
            const toggle = document.getElementById('toggleAutoRefresh');
            if (toggle.checked) {
                if (!autoRefreshTimer) {
                    autoRefreshTimer = setInterval(() => {
                        fetchRealtimeData();
                    }, 10000); // 10 giây
                }
            } else {
                if (autoRefreshTimer) {
                    clearInterval(autoRefreshTimer);
                    autoRefreshTimer = null;
                }
            }
        }

        document.getElementById('toggleAutoRefresh').addEventListener('change', setupAutoRefresh);

        // ON LOAD
        document.addEventListener("DOMContentLoaded", function () {
            initMainChart(initialLabels, initialRevenues);
            initDoughnutChart(statusLabels, statusCounts);
            initTopBarChart(topProductNames, topProductRevenues);
            setupAutoRefresh();
        });
    </script>
}