@model IEnumerable<BeautyShop.Models.FlashSale>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Flash Sale";
}

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title {
            color: #1e293b;
            font-weight: 700;
            margin: 0;
        }

        /* Table Styling */
        .table-card {
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .table-admin th {
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            padding: 15px 20px;
            border-bottom: 2px solid #e2e8f0;
        }

        .table-admin td {
            vertical-align: middle;
            padding: 15px 20px;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
        }

        .table-admin tr:last-child td {
            border-bottom: none;
        }

        /* Action Buttons */
        .btn-action {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: var(--transition);
        }
    </style>
}

<div class="page-header">
    <h2 class="page-title">
        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quản lý Flash Sale
    </h2>

    <a asp-action="Create" class="btn btn-primary rounded-pill fw-medium shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Tạo Flash Sale
    </a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover table-admin mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Tên chiến dịch</th>
                    <th>Thời gian bắt đầu</th>
                    <th>Thời gian kết thúc</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center pe-4" width="180">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                @item.Name
                            </td>

                            <td>
                                <div class="fw-medium">@item.StartTime.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@item.StartTime.ToString("HH:mm")</small>
                            </td>

                            <td>
                                <div class="fw-medium">@item.EndTime.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@item.EndTime.ToString("HH:mm")</small>
                            </td>

                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill px-3 py-2">
                                        Tạm dừng
                                    </span>
                                }
                            </td>

                            <td class="text-center pe-4">
                                <a asp-action="ManageItems" asp-route-id="@item.Id" class="btn btn-outline-info btn-action" title="Quản lý sản phẩm (Thêm/Sửa giá)">
                                    <i class="bi bi-box-seam"></i>
                                </a>

                                <a asp-action="ToggleStatus" asp-route-id="@item.Id" class="btn btn-outline-warning btn-action ms-1" title="Bật/Tắt chiến dịch">
                                    <i class="bi bi-power"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-action ms-1" title="Xóa chiến dịch" onclick="return confirm('Bạn có chắc chắn muốn xóa chiến dịch Flash Sale này không?');">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-lightning fs-1 d-block mb-2 opacity-50"></i>
                            Chưa có chiến dịch Flash Sale nào được tạo.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>