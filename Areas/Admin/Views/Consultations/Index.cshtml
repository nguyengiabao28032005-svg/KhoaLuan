@model IEnumerable<BeautyShop.Models.Consultation>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý lịch tư vấn";

    var employees = ViewBag.Employees as List<BeautyShop.Models.User> ?? new List<BeautyShop.Models.User>();
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);

    string GetBdgClass(string status) => status switch
    {
        "Chờ xác nhận" => "bdg-yellow",
        "Đã xác nhận" => "bdg-blue",
        "Đã phân công" => "bdg-purple",
        "Đang tư vấn" => "bdg-blue",
        "Đã hoàn thành" => "bdg-green",
        "Đã hủy" => "bdg-red",
        _ => "bdg-gray"
    };
}

<!-- Page Header -->
<div class="page-hdr">
    <div>
        <h2><i class="bi bi-calendar2-heart text-success"></i> Quản lý lịch tư vấn</h2>
        <div class="ph-sub">Theo dõi tất cả lịch hẹn tư vấn sản phẩm, da liễu và phân công chuyên viên</div>
    </div>
</div>

<!-- Thống kê nhanh KPI -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="admin-card p-3 text-center">
            <div class="f-label mb-1">Tổng lịch hẹn</div>
            <div class="fs-4 fw-bold text-dark">@(ViewBag.TotalCount ?? 0)</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="admin-card p-3 text-center border-start border-warning border-3">
            <div class="f-label text-warning mb-1">Chờ xác nhận</div>
            <div class="fs-4 fw-bold text-warning">@(ViewBag.PendingCount ?? 0)</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="admin-card p-3 text-center border-start border-primary border-3">
            <div class="f-label text-primary mb-1">Đã phân công</div>
            <div class="fs-4 fw-bold text-primary">@(ViewBag.AssignedCount ?? 0)</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="admin-card p-3 text-center border-start border-info border-3">
            <div class="f-label text-info mb-1">Đang tư vấn</div>
            <div class="fs-4 fw-bold text-info">@(ViewBag.InProgressCount ?? 0)</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="admin-card p-3 text-center border-start border-success border-3">
            <div class="f-label text-success mb-1">Đã hoàn thành</div>
            <div class="fs-4 fw-bold text-success">@(ViewBag.CompletedCount ?? 0)</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="admin-card p-3 text-center border-start border-danger border-3">
            <div class="f-label text-danger mb-1">Đã hủy</div>
            <div class="fs-4 fw-bold text-danger">@(ViewBag.CancelledCount ?? 0)</div>
        </div>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-ok mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-err mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Bộ lọc & Tìm kiếm -->
<div class="admin-card mb-4">
    <div class="admin-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="keyword" class="f-ctrl" placeholder="Tìm tên khách, SĐT, mã lịch..." value="@ViewBag.Keyword" />
            </div>
            <div class="col-md-2">
                <select name="status" class="f-ctrl">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Chờ xác nhận" selected="@(ViewBag.CurrentStatus == "Chờ xác nhận")">Chờ xác nhận</option>
                    <option value="Đã phân công" selected="@(ViewBag.CurrentStatus == "Đã phân công")">Đã phân công</option>
                    <option value="Đang tư vấn" selected="@(ViewBag.CurrentStatus == "Đang tư vấn")">Đang tư vấn</option>
                    <option value="Đã hoàn thành" selected="@(ViewBag.CurrentStatus == "Đã hoàn thành")">Đã hoàn thành</option>
                    <option value="Đã hủy" selected="@(ViewBag.CurrentStatus == "Đã hủy")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="consultationType" class="f-ctrl">
                    <option value="">-- Tất cả loại --</option>
                    <option value="Tư vấn chăm sóc da" selected="@(ViewBag.CurrentType == "Tư vấn chăm sóc da")">Chăm sóc da</option>
                    <option value="Tư vấn sản phẩm" selected="@(ViewBag.CurrentType == "Tư vấn sản phẩm")">Sản phẩm</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="date" class="f-ctrl" value="@ViewBag.CurrentDate" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn-ap w-100"><i class="bi bi-search"></i> Lọc dữ liệu</button>
                <a asp-action="Index" class="btn-as"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng dữ liệu -->
<div class="admin-card">
    <div class="admin-card-header">
        <h5><i class="bi bi-list-ul"></i> Danh sách lịch hẹn (@Model.Count())</h5>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Mã lịch</th>
                    <th>Khách hàng</th>
                    <th>Loại tư vấn</th>
                    <th>Ngày & Giờ</th>
                    <th>Nhân viên phụ trách</th>
                    <th>Trạng thái</th>
                    <th>Đánh giá</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không tìm thấy lịch tư vấn nào phù hợp.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="fw-bold text-dark">#CS-@item.Id.ToString("D4")</span>
                            <div class="text-muted" style="font-size: 11px;">@item.CreatedAt.ToString("dd/MM/yy HH:mm")</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@(item.User?.FullName ?? "N/A")</div>
                            <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@(item.User?.PhoneNumber ?? "Chưa có SĐT")</div>
                            <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@(item.User?.Email ?? "")</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.ConsultationType</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark"><i class="bi bi-calendar-event me-1 text-success"></i>@item.AppointmentDate.ToString("dd/MM/yyyy")</div>
                            <div class="text-muted small"><i class="bi bi-clock me-1"></i>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</div>
                        </td>
                        <td>
                            @if (item.Employee != null)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sb-user-ava" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                        @(item.Employee.FullName.Substring(0, 1))
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark" style="font-size: 13px;">@item.Employee.FullName</div>
                                        <small class="text-muted">Nhân viên tư vấn</small>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-light text-warning border border-warning">
                                    <i class="bi bi-person-x me-1"></i>Chưa phân công
                                </span>
                            }
                        </td>
                        <td>
                            <span class="bdg @GetBdgClass(item.Status)">@item.Status</span>
                        </td>
                        <td>
                            @if (item.Review != null)
                            {
                                <div class="text-warning small" title="@item.Review.Comment">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= item.Review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                    <span class="text-dark fw-bold ms-1">@item.Review.Rating/5</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">--</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn-as sm" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @if (isAdmin && (item.Status == "Chờ xác nhận" || item.Status == "Đã phân công" || item.Status == "Đã xác nhận"))
                                {
                                    <button type="button" class="btn-ae sm" data-bs-toggle="modal" data-bs-target="#assignModal-@item.Id" title="Phân công chuyên viên">
                                        <i class="bi bi-person-plus"></i>
                                    </button>
                                }

                                <a asp-action="UpdateResult" asp-route-id="@item.Id" class="btn-ap sm" title="Cập nhật kết quả">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </div>

                            <!-- Modal Phân công -->
                            @if (isAdmin)
                            {
                                <div class="modal fade text-start" id="assignModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-0">
                                            <form asp-action="AssignEmployee" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="consultationId" value="@item.Id" />

                                                <div class="modal-header border-bottom-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-dark">
                                                        <i class="bi bi-person-check-fill text-success me-2"></i>Phân công chuyên viên phụ trách
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <div class="p-3 bg-light rounded-3 mb-3">
                                                        <div class="small text-muted">Lịch hẹn #CS-@item.Id.ToString("D4") - Khách hàng: <strong>@item.User?.FullName</strong></div>
                                                        <div class="small text-dark fw-bold mt-1">
                                                            <i class="bi bi-calendar me-1"></i>@item.AppointmentDate.ToString("dd/MM/yyyy") (@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm"))
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold text-dark">Chọn nhân viên tư vấn (Role = Employee): <span class="text-danger">*</span></label>
                                                        <select name="employeeId" class="form-select f-ctrl" required>
                                                            <option value="">-- Chọn nhân viên --</option>
                                                            @foreach (var emp in employees)
                                                            {
                                                                <option value="@emp.Id" selected="@(item.EmployeeId == emp.Id)">
                                                                    @emp.FullName (@emp.Email)
                                                                </option>
                                                            }
                                                        </select>
                                                        <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i>Hệ thống sẽ tự động kiểm tra và ngăn chặn nếu nhân viên bị trùng lịch trong khung giờ này.</small>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top-0 pt-0">
                                                    <button type="button" class="btn-as" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn-ap"><i class="bi bi-check2"></i> Xác nhận phân công</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
