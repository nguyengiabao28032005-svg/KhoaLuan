@model BeautyShop.ViewModels.ConsultationResultViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Cập nhật kết quả tư vấn #CS-{Model.ConsultationId:D4}";

    var consultation = ViewBag.Consultation as BeautyShop.Models.Consultation;
    var availableProducts = ViewBag.AvailableProducts as List<BeautyShop.Models.Product> ?? new List<BeautyShop.Models.Product>();
}

<!-- Page Header -->
<div class="page-hdr">
    <div>
        <h2><i class="bi bi-clipboard2-pulse-fill text-success"></i> Ghi nhận kết quả tư vấn #CS-@Model.ConsultationId.ToString("D4")</h2>
        <div class="ph-sub">Khách hàng: <strong>@(consultation?.User?.FullName ?? "N/A")</strong> | Dịch vụ: <strong>@(consultation?.ConsultationType ?? "--")</strong></div>
    </div>
    <div>
        <a asp-action="Detail" asp-route-id="@Model.ConsultationId" class="btn-as">
            <i class="bi bi-arrow-left"></i> Quay lại chi tiết
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-err mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<form asp-action="UpdateResult" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ConsultationId" />
    <div asp-validation-summary="ModelOnly" class="alert-err mb-4"></div>

    <div class="row g-4">
        <!-- Cột trái: Kết quả tư vấn & Ghi chú -->
        <div class="col-lg-7">
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <h5><i class="bi bi-journal-check"></i> Nội dung & Kết quả tư vấn</h5>
                </div>
                <div class="admin-card-body">
                    <!-- Trạng thái -->
                    <div class="mb-4">
                        <label asp-for="Status" class="f-label">Trạng thái buổi tư vấn <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="f-ctrl">
                            <option value="Đang tư vấn">Đang tư vấn (Đang trao đổi hoặc cần theo dõi)</option>
                            <option value="Đã hoàn thành">Đã hoàn thành (Đã chốt liệu trình & lời khuyên)</option>
                            <option value="Đã hủy">Đã hủy (Khách không tham gia hoặc hủy)</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <!-- Ghi chú nội bộ nhân viên -->
                    <div class="mb-4">
                        <label asp-for="EmployeeNote" class="f-label">Ghi chú nội bộ nhân viên (chỉ nội bộ thấy)</label>
                        <textarea asp-for="EmployeeNote" class="f-ctrl" rows="3" placeholder="Ví dụ: Khách hàng từng dị ứng cồn khô, mong muốn cải thiện thâm mụn trong 1 tháng..."></textarea>
                        <span asp-validation-for="EmployeeNote" class="text-danger small"></span>
                    </div>

                    <!-- Kết quả tư vấn cho khách hàng -->
                    <div class="mb-3">
                        <label asp-for="ConsultationResult" class="f-label">
                            Kết quả tư vấn & Hướng dẫn chu trình chăm sóc <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="ConsultationResult" class="f-ctrl" rows="7" placeholder="Ví dụ: Khách hàng có làn da dầu thiếu nước, bít tắc chân lông vùng mũi. Khuyến nghị Skincare Routine:
1. Sáng: Sữa rửa mặt dịu nhẹ -> Nước hoa hồng kiềm dầu -> Serum Niacinamide -> Kem chống nắng SPF 50.
2. Tối: Tẩy trang sạch -> Sữa rửa mặt -> Toner -> Kem dưỡng ẩm phục hồi dạng gel mỏng nhẹ..."></textarea>
                        <span asp-validation-for="ConsultationResult" class="text-danger small"></span>
                        <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i>Nội dung này sẽ hiển thị trực tiếp cho khách hàng xem trong tài khoản của họ.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Đề xuất sản phẩm từ database -->
        <div class="col-lg-5">
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <h5><i class="bi bi-bag-plus"></i> Đề xuất sản phẩm cho khách</h5>
                </div>
                <div class="admin-card-body p-3">
                    <p class="small text-muted mb-3">Tích chọn các sản phẩm phù hợp từ kho BeautyShop để gợi ý cho khách hàng:</p>

                    <!-- Ô tìm kiếm sản phẩm nhanh -->
                    <div class="mb-3">
                        <input type="text" id="search-product" class="f-ctrl" placeholder="Gõ tên sản phẩm để lọc nhanh..." onkeyup="filterProducts()" />
                    </div>

                    <!-- Danh sách sản phẩm -->
                    <div class="product-selection-list border rounded-3 p-2" style="max-height: 480px; overflow-y: auto;">
                        @foreach (var prod in availableProducts)
                        {
                            var isSelected = Model.SelectedProductIds.Contains(prod.Id);
                            string currentNote = "";
                            if (Model.ProductNotes != null && Model.ProductNotes.ContainsKey(prod.Id))
                            {
                                currentNote = Model.ProductNotes[prod.Id];
                            }

                            <div class="product-item p-2 mb-2 rounded-2 border bg-light" data-name="@prod.Name.ToLower()">
                                <div class="form-check d-flex align-items-start gap-2">
                                    <input class="form-check-input mt-1 prod-checkbox"
                                           type="checkbox"
                                           name="SelectedProductIds"
                                           value="@prod.Id"
                                           id="prod-@prod.Id"
                                           checked="@isSelected"
                                           onchange="toggleNoteInput(@prod.Id)" />
                                    <div class="flex-grow-1">
                                        <label class="form-check-label fw-bold text-dark d-block" for="prod-@prod.Id" style="cursor: pointer; font-size: 13.5px;">
                                            @prod.Name
                                        </label>
                                        <div class="text-muted small">
                                            <span>Thương hiệu: @(prod.Brand?.Name ?? "--")</span> |
                                            <span class="text-danger fw-bold">
                                                @(prod.ProductVariants?.FirstOrDefault()?.RetailPrice?.ToString("N0") ?? "--") đ
                                            </span>
                                        </div>

                                        <!-- Ô nhập ghi chú cách dùng khi được chọn -->
                                        <div class="mt-2 note-box" id="note-box-@prod.Id" style="display: @(isSelected ? "block" : "none");">
                                            <input type="text"
                                                   name="ProductNotes[@prod.Id]"
                                                   class="f-ctrl sm"
                                                   placeholder="Cách dùng (VD: Thoa 2 giọt buổi sáng)"
                                                   value="@currentNote"
                                                   style="padding: 5px 10px; font-size: 12px;" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nút lưu -->
    <div class="admin-card p-3 d-flex justify-content-end gap-2">
        <a asp-action="Detail" asp-route-id="@Model.ConsultationId" class="btn-as">Hủy bỏ</a>
        <button type="submit" class="btn-ap px-4">
            <i class="bi bi-save me-1"></i> Lưu kết quả tư vấn
        </button>
    </div>
</form>

<script>
    function filterProducts() {
        const query = document.getElementById("search-product").value.toLowerCase().trim();
        const items = document.querySelectorAll(".product-item");
        items.forEach(item => {
            const name = item.getAttribute("data-name") || "";
            if (name.includes(query)) {
                item.style.display = "block";
            } else {
                item.style.display = "none";
            }
        });
    }

    function toggleNoteInput(prodId) {
        const checkbox = document.getElementById("prod-" + prodId);
        const noteBox = document.getElementById("note-box-" + prodId);
        if (checkbox && noteBox) {
            noteBox.style.display = checkbox.checked ? "block" : "none";
        }
    }
</script>
