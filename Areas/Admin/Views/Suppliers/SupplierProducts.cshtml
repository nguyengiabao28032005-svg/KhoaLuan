@model List<BeautyShop.Models.SupplierProduct>
@{
    ViewData["Title"] = "Bảng giá cung ứng theo biến thể";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    bool hasMultiVar = ViewBag.HasMultipleVariants ?? false;
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-dots mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Nhà cung cấp</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Bảng giá cung ứng (SupplierProduct)</li>
                </ol>
            </nav>
            <h3 class="fw-800 text-dark mb-1">📋 Bảng giá Cung ứng theo Biến thể sản phẩm</h3>
            <p class="text-muted small mb-0">Quản lý và điều chỉnh đơn giá cung ứng tham chiếu theo từng biến thể (SKU, Màu sắc, Dung tích) của từng đối tác. <span class="badge bg-light text-secondary border">Dữ liệu mẫu phục vụ đồ án</span></p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách NCC
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="SupplierProducts" class="row g-2 align-items-center" id="filterForm">
                <div class="col-md-3">
                    <select name="supplierId" class="form-select rounded-3">
                        <option value="">-- Tất cả nhà cung cấp --</option>
                        @if (ViewBag.Suppliers != null)
                        {
                            foreach (var s in (List<BeautyShop.Models.Supplier>)ViewBag.Suppliers)
                            {
                                <option value="@s.Id" selected="@(ViewBag.CurrentSupplierId == s.Id)">@s.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select rounded-3">
                        <option value="">-- Tất cả danh mục --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var c in (List<BeautyShop.Models.Category>)ViewBag.Categories)
                            {
                                <option value="@c.Id" selected="@(ViewBag.CurrentCategoryId == c.Id)">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchTerm" value="@ViewBag.CurrentSearchTerm" class="form-control border-start-0" placeholder="SKU, tên sản phẩm, tên NCC..." />
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary rounded-3 w-100 fw-bold">Lọc</button>
                    <a asp-action="SupplierProducts" class="btn btn-light border rounded-3" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
                <div class="col-12 mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="hasMultipleVariants" value="true" id="multiVarSwitch" checked="@(hasMultiVar ? "checked" : null)" onchange="document.getElementById('filterForm').submit()">
                        <label class="form-check-label small fw-bold text-dark" for="multiVarSwitch">
                            <i class="bi bi-layers-fill text-primary me-1"></i> Chỉ hiển thị các sản phẩm có từ 2 biến thể trở lên
                        </label>
                    </div>
                    <div class="small text-muted">
                        Tổng số biến thể hiển thị: <strong>@Model.Count</strong> dòng
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- DANH SÁCH BẢNG GIÁ BIẾN THỂ -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;" class="text-center text-secondary small fw-bold">#</th>
                            <th class="px-3 py-3 text-secondary small fw-bold">Nhà cung cấp</th>
                            <th class="py-3 text-secondary small fw-bold">Sản phẩm &amp; Biến thể</th>
                            <th class="py-3 text-secondary small fw-bold">Danh mục</th>
                            <th class="py-3 text-secondary small fw-bold text-end">Giá cung ứng (VNĐ)</th>
                            <th class="py-3 text-secondary small fw-bold text-center">Cập nhật lần cuối</th>
                            <th class="py-3 text-secondary small fw-bold">Ghi chú</th>
                            <th class="py-3 px-4 text-secondary small fw-bold text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy dòng cung ứng nào phù hợp với bộ lọc.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = 1;
                            foreach (var item in Model)
                            {
                                <tr id="spRow_@item.Id">
                                    <td class="text-center text-muted small">@index</td>
                                    <td class="px-3 py-3">
                                        <div class="fw-bold text-dark">@item.Supplier?.Name</div>
                                        <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@item.Supplier?.Country</small>
                                    </td>
                                    <td class="py-3">
                                        <div class="fw-bold text-dark">@item.Variant?.Product?.Name</div>
                                        <div class="small font-monospace text-muted">
                                            <span class="badge bg-light text-dark border me-1">SKU: @item.Variant?.SKU</span>
                                            @(string.IsNullOrEmpty(item.Variant?.ColorName) ? "" : $"| Màu: {item.Variant.ColorName}")
                                            @(string.IsNullOrEmpty(item.Variant?.Volume) ? "" : $"| Dung tích: {item.Variant.Volume}")
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-secondary border">@(item.Variant?.Product?.Category?.Name ?? "—")</span>
                                    </td>
                                    <td class="py-3 text-end fw-bold text-primary font-monospace fs-6">
                                        @(item.SuppliedPrice.HasValue ? item.SuppliedPrice.Value.ToString("N0") + " đ" : "—")
                                    </td>
                                    <td class="py-3 text-center small text-muted font-monospace">
                                        @(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : item.CreatedAt.ToString("dd/MM/yyyy"))
                                    </td>
                                    <td class="py-3">
                                        <span class="small text-muted">@(string.IsNullOrEmpty(item.Notes) ? "—" : item.Notes)</span>
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editPriceModal_@item.Id">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa giá
                                        </button>

                                        <!-- MODAL SỬA GIÁ -->
                                        <div class="modal fade text-start" id="editPriceModal_@item.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <form asp-action="UpdateVariantPrice" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <div class="modal-header border-0 pb-0">
                                                            <h5 class="modal-title fw-bold">Chỉnh sửa giá cung ứng biến thể</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3 p-3 bg-light rounded-3">
                                                                <div class="small text-muted">Nhà cung cấp: <strong class="text-dark">@item.Supplier?.Name</strong></div>
                                                                <div class="small text-muted">Sản phẩm: <strong class="text-dark">@item.Variant?.Product?.Name</strong></div>
                                                                <div class="small text-muted">Biến thể: <strong class="text-primary font-monospace">@item.Variant?.SKU</strong> (@item.Variant?.ColorName @item.Variant?.Volume)</div>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold">Đơn giá cung ứng tham chiếu (VNĐ) <span class="text-danger">*</span></label>
                                                                <input type="number" min="1000" step="1000" name="suppliedPrice" value="@(item.SuppliedPrice ?? 0)" class="form-control rounded-3" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold">Ghi chú bổ sung (tùy chọn)</label>
                                                                <input type="text" name="notes" value="@item.Notes" class="form-control rounded-3" placeholder="Ghi chú hợp đồng, chiết khấu..." />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Cập nhật giá</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
