@model BeautyShop.Models.Category

@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4" style="max-width: 720px;">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Danh mục</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark"><i class="bi bi-plus-circle me-2 text-success"></i>Thêm danh mục mới</h3>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-secondary">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control py-2 shadow-sm" placeholder="Ví dụ: Chăm sóc da mặt, Son môi..." required />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

          
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-medium">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success px-5 rounded-3 fw-semibold shadow-sm">Lưu dữ liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>