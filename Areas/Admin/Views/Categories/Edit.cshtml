@model BeautyShop.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4" style="max-width: 720px;">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Danh mục</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh sửa danh mục</h3>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-secondary">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control py-2 shadow-sm" />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

          

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-medium">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-warning text-dark px-5 rounded-3 fw-semibold shadow-sm">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>