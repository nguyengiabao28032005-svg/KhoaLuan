@model IEnumerable<BeautyShop.Models.User>

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Quản Lý Khách Hàng</h3>
            <p class="text-muted small mb-0">Tổng cộng <strong>@(ViewBag.TotalCount ?? 0)</strong> khách hàng trong hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 fw-semibold shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i>Thêm tài khoản mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên, email hoặc số điện thoại..." />
                    </div>
                </div>
                <div class="col-md-4">
                    @{
                        var currentUserStatus = (string)ViewBag.CurrentStatus;
                    }
                    <select name="status" class="form-select text-muted">
                        <option value="">-- Tất cả trạng thái --</option>
                        @if (currentUserStatus == "active")
                        {
                            <option value="active" selected>Hoạt động</option>
                        }
                        else
                        {
                            <option value="active">Hoạt động</option>
                        }
                        @if (currentUserStatus == "inactive")
                        {
                            <option value="inactive" selected>Đã khóa</option>
                        }
                        else
                        {
                            <option value="inactive">Đã khóa</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel-fill me-1"></i>Lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase small font-weight-bold">
                        <tr>
                            <th class="ps-4">Họ và tên</th>
                            <th>Email đăng nhập</th>
                            <th>Số điện thoại</th>
                            <th>Quyền hạn</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-4" style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.FullName</div>
                                        <small class="text-muted">ID: #@item.Id</small>
                                    </td>
                                    <td><span class="text-dark fw-medium">@item.Email</span></td>
                                    <td><span class="text-secondary small">@(string.IsNullOrEmpty(item.PhoneNumber) ? "---" : item.PhoneNumber)</span></td>
                                    <td>
                                        @if (item.Role?.Name == "Admin")
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-2"><i class="bi bi-shield-lock-fill me-1"></i>Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary px-2.5 py-1.5 rounded-2"><i class="bi bi-person-fill me-1"></i>Customer</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill">Khóa</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-2">
                                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Xem chi tiết"><i class="bi bi-eye-fill"></i></a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-2 d-block mb-2 text-secondary"></i>Hiện không có tài khoản thành viên nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>