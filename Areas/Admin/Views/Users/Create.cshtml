@model BeautyShop.Models.User

@{
    ViewData["Title"] = "Thêm người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4" style="max-width: 760px;">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Người dùng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark"><i class="bi bi-person-plus-fill me-2 text-success"></i>Thêm người dùng mới</h3>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small text-secondary">Họ và tên đầy đủ <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control py-2 shadow-sm" placeholder="Nhập họ và tên..." required />
                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary">Địa chỉ Email (Tài khoản) <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control py-2 shadow-sm" placeholder="username@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small text-secondary">Số điện thoại</label>
                        <input asp-for="PhoneNumber" class="form-control py-2 shadow-sm" placeholder="Nhập số điện thoại..." />
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                    <input type="password" name="Password" class="form-control py-2 shadow-sm" placeholder="Nhập mật khẩu ban đầu..." required />
                </div>

                <div class="mb-4">
                    <label asp-for="RoleId" class="form-label fw-semibold small text-secondary">Phân quyền vai trò <span class="text-danger">*</span></label>
                    <select asp-for="RoleId" class="form-select py-2 shadow-sm" asp-items="ViewBag.RoleId">
                        <option value="">-- Chọn nhóm phân quyền --</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch p-0 ps-5 mt-2">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" checked />
                        <label class="form-check-label fw-semibold text-dark ps-2" asp-for="IsActive">Kích hoạt tài khoản được phép hoạt động đăng nhập ngay</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-medium">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success px-5 rounded-3 fw-semibold shadow-sm">Tạo tài khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>