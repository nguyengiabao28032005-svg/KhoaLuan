@model BeautyShop.Models.User

@{
    ViewData["Title"] = "Hồ sơ người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4" style="max-width: 760px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small text-secondary fw-semibold"><i class="bi bi-arrow-left me-1"></i>Trở lại danh sách</a>
        <h3 class="fw-bold text-dark mt-2">Hồ Sơ Chi Tiết Thành Viên</h3>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-4 mb-4 pb-3 border-bottom">
                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 70px; height: 70px; font-size: 2rem;">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                    <span class="text-muted small">Mã thành viên: #@Model.Id</span>
                </div>
            </div>

            <div class="row g-3 fs-6">
                <div class="col-sm-4 text-secondary fw-medium">Địa chỉ Email đăng nhập:</div>
                <div class="col-sm-8 text-dark fw-bold">@Model.Email</div>

                <div class="col-sm-4 text-secondary fw-medium">Số điện thoại cá nhân:</div>
                <div class="col-sm-8 text-dark">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa thiết lập" : Model.PhoneNumber)</div>

                <div class="col-sm-4 text-secondary fw-medium">Nhóm vai trò hệ thống:</div>
                <div class="col-sm-8">
                    <span class="badge bg-primary px-3 py-1.5 rounded-2">@(Model.Role?.Name ?? "Customer")</span>
                </div>

                <div class="col-sm-4 text-secondary fw-medium">Ngày khởi tạo tài khoản:</div>
                <div class="col-sm-8 text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>

                <div class="col-sm-4 text-secondary fw-medium">Trạng thái đăng nhập:</div>
                <div class="col-sm-8">
                    @if (Model.IsActive)
                    {
                        <span class="text-success fw-bold"><i class="bi bi-circle-fill me-1.5 small"></i>Đang được phép hoạt động</span>
                    }
                    else
                    {
                        <span class="text-danger fw-bold"><i class="bi bi-circle-fill me-1.5 small"></i>Tài khoản đang bị khóa tạm thời</span>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-medium">Đóng hồ sơ</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark px-4 rounded-3 fw-semibold shadow-sm"><i class="bi bi-pencil-square me-1"></i> Thay đổi thông tin</a>
            </div>
        </div>
    </div>
</div>